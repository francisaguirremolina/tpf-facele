--
-- Name: spc_initschseq_facele_tpf_public(); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.spc_initschseq_facele_tpf_public() RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_min	int8;
	l_max	int8;
	l_inc	int8;
	l_mod	int8;

BEGIN
	l_min	:= 0;
	l_max	:= 1000000000;
	l_inc	:= 1;
	l_mod	:= 0;
	
	IF EXISTS (SELECT true FROM information_schema.tables 
		WHERE table_schema = 'sync' AND table_name = 't_masterservers' ) THEN

		-- Esquema de replicación implementado

		SELECT MinSequenceValue, MaxSequenceValue, IncSequenceValue, ModSequenceValue
			INTO l_min, l_max, l_inc, l_mod
			FROM sync.t_masterservers 
			WHERE ActiveServer = 1;

        IF NOT FOUND THEN
        
            l_min	:= 0;
	       l_max	:= 1000000000;
	       l_inc	:= 1;
	       l_mod	:= 0;
	
        END IF;
        
	END IF;


END    
$$;


ALTER FUNCTION public.spc_initschseq_facele_tpf_public() OWNER TO sa;

--
-- Name: spc_initsequence(character varying, character varying, character varying, bigint, bigint, bigint, bigint); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.spc_initsequence(p_tablefqn character varying, p_pkcolumn character varying, p_seqfqn character varying, p_minsequencevalue bigint, p_maxsequencevalue bigint, p_incsequencevalue bigint, p_modsequencevalue bigint) RETURNS bigint
    LANGUAGE plpgsql
    AS $$
DECLARE
    l_sqlString     TEXT;
    l_newValue      BIGINT;
    l_modValue      BIGINT;

BEGIN
	-- Control de parámetros de entrada
	IF p_TableFQN IS NULL THEN
		RAISE EXCEPTION '{Debe proveerse un valor para el parámetro p_TableFQN de la función InitSequence}';
	END IF;
	IF p_PKColumn IS NULL THEN
		RAISE EXCEPTION '{Debe proveerse un valor para el parámetro p_PKColumn de la función InitSequence}';
	END IF;
	IF p_SeqFQN IS NULL THEN
		RAISE EXCEPTION '{Debe proveerse un valor para el parámetro p_SeqFQN de la función InitSequence}';
	END IF;
	IF p_MinSequenceValue IS NULL THEN
		RAISE EXCEPTION '{Debe proveerse un valor para el parámetro p_MinSequenceValue de la función InitSequence}';
	END IF;
	IF p_MaxSequenceValue IS NULL THEN
		RAISE EXCEPTION '{Debe proveerse un valor para el parámetro p_MaxSequenceValue de la función InitSequence}';
	END IF;
	IF p_IncSequenceValue IS NULL THEN
		RAISE EXCEPTION '{Debe proveerse un valor para el parámetro p_IncSequenceValue de la función InitSequence}';
	END IF;
	IF p_ModSequenceValue IS NULL THEN
		RAISE EXCEPTION '{Debe proveerse un valor para el parámetro p_ModSequenceValue de la función InitSequence}';
	END IF;

	l_sqlString := 'SELECT MAX(' || p_PKColumn || ') FROM ' || p_TableFQN 
		|| ' WHERE ' || p_PKColumn || ' BETWEEN ' || p_MinSequenceValue || ' AND ' || p_MaxSequenceValue;

	EXECUTE l_sqlString INTO l_newValue;

	IF l_newValue IS NULL THEN

		-- Primer valor de la secuencia

		l_newValue := p_MinSequenceValue;

	ELSE

		l_newValue := l_newValue + p_IncSequenceValue;

	END IF;

    IF p_IncSequenceValue >= 2 THEN
    
	   WHILE (l_newValue % p_IncSequenceValue <> p_ModSequenceValue ) LOOP

		  l_newValue := l_newValue + 1;

	   END LOOP;

    END IF;

	l_sqlString := 'ALTER SEQUENCE ' || p_SeqFQN || 
		' INCREMENT BY ' || p_IncSequenceValue || 
		' MINVALUE ' || p_MinSequenceValue || 
		' MAXVALUE ' || p_MaxSequenceValue || 
		' START WITH ' || l_newValue ||
		' RESTART WITH ' || l_newValue;
    
	EXECUTE l_sqlString USING p_SeqFQN, p_IncSequenceValue, p_MinSequenceValue, 
        	p_MaxSequenceValue, l_newValue;
    
	RETURN l_newValue;
    
END
$$;


ALTER FUNCTION public.spc_initsequence(p_tablefqn character varying, p_pkcolumn character varying, p_seqfqn character varying, p_minsequencevalue bigint, p_maxsequencevalue bigint, p_incsequencevalue bigint, p_modsequencevalue bigint) OWNER TO sa;

--
-- Name: spc_initsequences(); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.spc_initsequences() RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
    l_rec   RECORD;
    l_sql   TEXT;
    
BEGIN
    FOR l_rec IN SELECT routine_schema, routine_name
    FROM information_schema.routines 
    WHERE routine_name ILIKE 'spc_InitSchSeq_%' LOOP
    
        l_sql := 'SELECT ' || l_rec.routine_schema || '.' || l_rec.routine_name || '();';
        
        -- RAISE INFO '%', l_sql;
        
        EXECUTE l_sql;
        
    END LOOP;

END
$$;


ALTER FUNCTION public.spc_initsequences() OWNER TO sa;

--
-- Name: spc_modelselectlist(); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.spc_modelselectlist() RETURNS SETOF text
    LANGUAGE plpgsql
    AS $$
DECLARE
    l_rec   RECORD;
    l_sql   TEXT;
    
BEGIN
    l_sql := '';
    
    FOR l_rec IN SELECT routine_schema, routine_name
    FROM information_schema.routines 
    WHERE routine_name ILIKE 'spc_OneModelSelectList_%' LOOP
    
        IF l_sql <> '' THEN
            l_sql := l_sql || ' UNION ';
        END IF;
        
        l_sql := l_sql || 'SELECT * FROM ' || l_rec.routine_name || '()';
        
    END LOOP;
    
    -- RAISE INFO '%', l_sql;
        
    RETURN QUERY EXECUTE l_sql;
        

END
$$;


ALTER FUNCTION public.spc_modelselectlist() OWNER TO sa;

