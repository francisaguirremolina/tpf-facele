        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'MensajeACola=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.RespuestaDeCola IS DISTINCT FROM l_RespuestaDeCola THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'RespuestaDeCola = ' || COALESCE(quote_literal(l_RespuestaDeCola), 'NULL') ;
        IF l_RespuestaDeCola IS NOT NULL THEN
            IF LENGTH(l_RespuestaDeCola::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_RespuestaDeCola::TEXT FOR 10) || '...';
