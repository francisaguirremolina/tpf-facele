-- Name: spd_fexidiomas(facele.idfexidioma); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spd_fexidiomas(p_idfexidioma facele.idfexidioma) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_errorMsg	TEXT;
    l_dmlString         TEXT;
         l_pkString      TEXT;

	l_IdFEXIdioma	facele.IdFEXIdioma;

BEGIN
	l_IdFEXIdioma := p_IdFEXIdioma;
	

    l_dmlString := 'DELETE FROM facele.t_FEXIdiomas WHERE IdFEXIdioma = ' || quote_literal(l_IdFEXIdioma) || '';

    EXECUTE l_dmlString;
    
    

	

-- Manejo de errores
EXCEPTION

	WHEN  OTHERS THEN 

		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_FEXIdiomas', 'eliminar', 
			'Idioma = ' || l_IdFEXIdioma::TEXT);

END;
$$;


ALTER FUNCTION facele.spd_fexidiomas(p_idfexidioma facele.idfexidioma) OWNER TO sa;

