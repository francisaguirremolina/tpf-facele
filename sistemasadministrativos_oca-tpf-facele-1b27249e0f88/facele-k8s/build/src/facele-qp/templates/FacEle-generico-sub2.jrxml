	<queryString>
		<![CDATA[SELECT	civa.baseimp,
	civa.importe,
	iva.Alicuota AS Descripcion
FROM facele.t_fecomprobantesiva civa
INNER JOIN facele.t_feivatipos iva USING (CodAlicIVA)
WHERE civa.IdDocumentoFE::TEXT=$P{IdDocumentoFE}]]>
	</queryString>
