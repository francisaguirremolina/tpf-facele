-- Name: COLUMN t_fecomprobantes.lineacab16; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.lineacab16 IS '16º línea de cabecera del comprobante, con información adicional';


