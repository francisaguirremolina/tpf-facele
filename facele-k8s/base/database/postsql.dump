CREATE TABLE facele.t_feopcionalestipos (
    codopcional facele.codopcional NOT NULL,
    descripcion facele.descripcion250 NOT NULL,
    fchdesde facele.fecha NOT NULL,
    fchhasta facele.fecha,
    usonacional facele.usonacional DEFAULT 1 NOT NULL,
    usoexportac facele.usoexportac DEFAULT 0 NOT NULL,
    CONSTRAINT t_feopcionalestipos_check CHECK (((fchhasta IS NULL) OR (((fchhasta)::date >= (fchdesde)::date) AND (((usonacional)::integer = 1) OR ((usoexportac)::integer = 1)))))
);


