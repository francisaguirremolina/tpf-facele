		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            

    
	IF l_fieldList IS NOT NULL THEN

        l_dmlString := 'UPDATE facele.t_FEXUnidadesMedida SET ' || l_fieldList || ' WHERE ' ||
            'IdFEXUnidadMedida = ' || quote_literal(l_pk_IdFEXUnidadMedida);
        
