	IF l_rec.EstadoDeCola IS DISTINCT FROM l_EstadoDeCola THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'EstadoDeCola = ' || COALESCE(quote_literal(l_EstadoDeCola), 'NULL') ;
