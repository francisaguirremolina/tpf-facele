--
-- Name: spu_fecomprobantesasoc(facele.iddocumentofe, facele.ptovta, facele.cbtetipo, facele.cbtenumero, facele.cuit, facele.idcomprobasoc); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spu_fecomprobantesasoc(p_iddocumentofe facele.iddocumentofe, p_ptovta facele.ptovta, p_cbtetipo facele.cbtetipo, p_cbtenumero facele.cbtenumero, p_cbtecuit facele.cuit, p_pk_idcomprobasoc facele.idcomprobasoc) RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_errorMsg         TEXT;
	l_fieldList        TEXT;
	l_fieldNameList    TEXT;
	l_pkParams         TEXT;
    l_NoTempModFields  INT;
    l_dmlString        TEXT;
    l_pkString         TEXT;
    l_newValue         TEXT;

    l_IdDocumentoFE  facele.IdDocumentoFE;
    l_PtoVta  facele.PtoVta;
    l_CbteTipo  facele.CbteTipo;
    l_CbteNumero  facele.CbteNumero;
    l_CbteCuit  facele.Cuit;
    l_pk_IdComprobAsoc   facele.IdComprobAsoc;

	l_rec		facele.t_FEComprobantesAsoc;

BEGIN
	-- Validación de PK provistas
	IF (p_pk_IdComprobAsoc IS NULL) THEN

		RAISE EXCEPTION '%', 'No se ha provisto el conjunto de valores de la clave primaria del registro a modificar';

	END IF;

	SELECT * INTO l_rec
		FROM facele.t_FEComprobantesAsoc
		WHERE (IdComprobAsoc = p_pk_IdComprobAsoc);

    l_pk_IdComprobAsoc := p_pk_IdComprobAsoc;
    l_IdDocumentoFE := p_IdDocumentoFE;
    l_PtoVta := p_PtoVta;
    l_CbteTipo := p_CbteTipo;
    l_CbteNumero := p_CbteNumero;
    l_CbteCuit := p_CbteCuit;

    -- No PRE-UPDATE
   
	l_fieldList := NULL;
    l_fieldNameList := NULL;
    -- Cuenta los campos modificados que son definitivos en la tabla
    l_NoTempModFields := 0;
    
	IF l_rec.IdDocumentoFE IS DISTINCT FROM l_IdDocumentoFE THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'IdDocumentoFE = ' || COALESCE(quote_literal(l_IdDocumentoFE), 'NULL') ;
        IF l_IdDocumentoFE IS NOT NULL THEN
            IF LENGTH(l_IdDocumentoFE::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_IdDocumentoFE::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_IdDocumentoFE::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'IdDocumentoFE=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.PtoVta IS DISTINCT FROM l_PtoVta THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'PtoVta = ' || COALESCE(quote_literal(l_PtoVta), 'NULL') ;
        IF l_PtoVta IS NOT NULL THEN
            IF LENGTH(l_PtoVta::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_PtoVta::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_PtoVta::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'PtoVta=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.CbteTipo IS DISTINCT FROM l_CbteTipo THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'CbteTipo = ' || COALESCE(quote_literal(l_CbteTipo), 'NULL') ;
        IF l_CbteTipo IS NOT NULL THEN
            IF LENGTH(l_CbteTipo::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_CbteTipo::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_CbteTipo::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'CbteTipo=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.CbteNumero IS DISTINCT FROM l_CbteNumero THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'CbteNumero = ' || COALESCE(quote_literal(l_CbteNumero), 'NULL') ;
        IF l_CbteNumero IS NOT NULL THEN
            IF LENGTH(l_CbteNumero::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_CbteNumero::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_CbteNumero::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'CbteNumero=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.CbteCuit IS DISTINCT FROM l_CbteCuit THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'CbteCuit = ' || COALESCE(quote_literal(l_CbteCuit), 'NULL') ;
        IF l_CbteCuit IS NOT NULL THEN
            IF LENGTH(l_CbteCuit::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_CbteCuit::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_CbteCuit::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'CbteCuit=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            

    
	IF l_fieldList IS NOT NULL THEN

        l_dmlString := 'UPDATE facele.t_FEComprobantesAsoc SET ' || l_fieldList || ' WHERE ' ||
            'IdComprobAsoc = ' || quote_literal(l_pk_IdComprobAsoc);
        
		EXECUTE l_dmlString;

	END IF;
    
    
    -- No POST-UPDATE
    
    RETURN l_NoTempModFields;

-- Manejo de errores
EXCEPTION

	WHEN OTHERS THEN
		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_FEComprobantesAsoc', 'actualizar',
            
			'Cód. comp. asoc. = ' || l_pk_IdComprobAsoc::TEXT);
   
END;
$$;


