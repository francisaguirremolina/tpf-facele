-- Name: COLUMN t_fecomprobantes.lineacab18; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.lineacab18 IS '18º línea de cabecera del comprobante, con información adicional';


