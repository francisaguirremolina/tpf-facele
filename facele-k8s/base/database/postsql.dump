-- Name: pg_dropuseruniques(character varying); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.pg_dropuseruniques(p_namepattern character varying) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_rec RECORD;
	l_ddl TEXT;
	l_errorMsg TEXT;

BEGIN
	FOR l_rec IN 
		SELECT constraint_name, fullname FROM pg_useruniques WHERE fullname ILIKE p_NamePattern 
		LOOP

		BEGIN

			l_ddl := 'ALTER TABLE ' || l_rec.fullname || ' DROP CONSTRAINT ' || l_rec.constraint_name;

			RAISE INFO '%', l_ddl;

			EXECUTE (l_ddl);

		EXCEPTION WHEN OTHERS THEN

			GET STACKED DIAGNOSTICS l_errorMsg = MESSAGE_TEXT;

			RAISE INFO 'Indice no eliminado: constraint=% fullname=% msg=%', l_rec.constraint_name, l_rec.fullname, l_errorMsg;
		END;

	END LOOP;
END;
$$;


