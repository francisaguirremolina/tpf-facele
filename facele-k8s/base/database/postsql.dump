--
-- Name: spc_montoescrito_strpesos(facele.sqlbigint); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spc_montoescrito_strpesos(p_pesos facele.sqlbigint) RETURNS text
    LANGUAGE plpgsql
    AS $$
/***************************************************************
Función:             montoescrito_strpesos(p_pesos): text 
Nombre público:      
Autores:             G. Sbrugnera
Inicio:               2025-10-21 12:17:54.613822
Última modificación:  2025-10-21 12:35:17.537686
Descripción:         
Responsabilidades:   
Precondiciones:      
Valor devuelto:      
Excepciones propias: 
Parámetros:
	p_pesos (IN, facele.SqlBigInt: bigint)		
****************************************************************/
BEGIN
	-- Control de parámetros de entrada
	
--BODY--DELIMITER--
DECLARE
        l_millones 	INT;	
        l_miles 	INT;
        l_unidades 	INT;
        l_toReturn 	TEXT;
        
BEGIN
        l_millones := p_pesos / 1000000;
        l_miles := (p_pesos - l_millones * 1000000) / 1000;
        l_unidades := p_pesos % 1000;
        
        l_toReturn := '';
        
        IF l_millones > 0 THEN
            l_toReturn := l_toReturn || facele.spc_MontoEscrito_strMillones(l_millones);
        END IF;
        
        IF l_miles > 0 THEN
            IF l_millones > 0 THEN
                l_toReturn := l_toReturn || ' ' || facele.spc_MontoEscrito_strMiles(l_miles);
            ELSE
                l_toReturn := l_toReturn || facele.spc_MontoEscrito_strMiles(l_miles);
            END IF;
        END IF;
        
        IF l_unidades > 0 THEN
            IF LENGTH(l_toReturn) > 0 THEN
                l_toReturn := l_toReturn || ' ';
            END IF;
            l_toReturn := l_toReturn || facele.spc_MontoEscrito_strUnidades(l_unidades);
        END IF;
        
        IF p_pesos > 1 THEN
            IF (l_miles > 0) OR (l_unidades > 0) THEN
                RETURN l_toReturn || ' pesos';
            ELSE
                RETURN l_toReturn || ' de pesos';
            END IF;
        ELSE
            RETURN l_toReturn || ' peso';
        END IF;
END
--BODY--DELIMITER--
;
END
$$;


ALTER FUNCTION facele.spc_montoescrito_strpesos(p_pesos facele.sqlbigint) OWNER TO sa;

