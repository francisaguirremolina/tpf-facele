--
-- Name: spu_conceptos(facele.concepto, facele.descripcion, facele.fecha, facele.fecha, facele.concepto); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spu_conceptos(p_concepto facele.concepto, p_descripcion facele.descripcion, p_fchdesde facele.fecha, p_fchhasta facele.fecha, p_pk_concepto facele.concepto) RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_errorMsg         TEXT;
	l_fieldList        TEXT;
	l_fieldNameList    TEXT;
	l_pkParams         TEXT;
    l_NoTempModFields  INT;
    l_dmlString        TEXT;
    l_pkString         TEXT;
    l_newValue         TEXT;

    l_Concepto  facele.Concepto;
    l_Descripcion  facele.Descripcion;
    l_FchDesde  facele.Fecha;
    l_FchHasta  facele.Fecha;
    l_pk_Concepto   facele.Concepto;

	l_rec		facele.t_Conceptos;

BEGIN
	-- Validación de PK provistas
	IF (p_pk_Concepto IS NULL) THEN

		RAISE EXCEPTION '%', 'No se ha provisto el conjunto de valores de la clave primaria del registro a modificar';

	END IF;

	SELECT * INTO l_rec
		FROM facele.t_Conceptos
		WHERE (Concepto = p_pk_Concepto);

    l_Concepto := p_Concepto;
    l_pk_Concepto := p_pk_Concepto;
    l_Descripcion := p_Descripcion;
    l_FchDesde := p_FchDesde;
    l_FchHasta := p_FchHasta;

    -- No PRE-UPDATE
   
	l_fieldList := NULL;
    l_fieldNameList := NULL;
    -- Cuenta los campos modificados que son definitivos en la tabla
    l_NoTempModFields := 0;
    
	IF l_rec.Concepto IS DISTINCT FROM l_Concepto THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Concepto = ' || COALESCE(quote_literal(l_Concepto), 'NULL') ;
        IF l_Concepto IS NOT NULL THEN
            IF LENGTH(l_Concepto::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Concepto::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Concepto::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Concepto=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Descripcion IS DISTINCT FROM l_Descripcion THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Descripcion = ' || COALESCE(quote_literal(l_Descripcion), 'NULL') ;
        IF l_Descripcion IS NOT NULL THEN
            IF LENGTH(l_Descripcion::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Descripcion::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Descripcion::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Descripcion=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.FchDesde IS DISTINCT FROM l_FchDesde THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'FchDesde = ' || COALESCE(quote_literal(l_FchDesde), 'NULL') ;
        IF l_FchDesde IS NOT NULL THEN
            IF LENGTH(l_FchDesde::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_FchDesde::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_FchDesde::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'FchDesde=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.FchHasta IS DISTINCT FROM l_FchHasta THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'FchHasta = ' || COALESCE(quote_literal(l_FchHasta), 'NULL') ;
        IF l_FchHasta IS NOT NULL THEN
            IF LENGTH(l_FchHasta::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_FchHasta::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_FchHasta::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'FchHasta=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            

    
	IF l_fieldList IS NOT NULL THEN

        l_dmlString := 'UPDATE facele.t_Conceptos SET ' || l_fieldList || ' WHERE ' ||
            'Concepto = ' || quote_literal(l_pk_Concepto);
        
		EXECUTE l_dmlString;

	END IF;
    
    
    -- No POST-UPDATE
    
    RETURN l_NoTempModFields;

-- Manejo de errores
EXCEPTION

	WHEN OTHERS THEN
		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_Conceptos', 'actualizar',
            
			'Concepto = ' || l_pk_Concepto::TEXT);
   
END;
$$;


ALTER FUNCTION facele.spu_conceptos(p_concepto facele.concepto, p_descripcion facele.descripcion, p_fchdesde facele.fecha, p_fchhasta facele.fecha, p_pk_concepto facele.concepto) OWNER TO sa;

--
-- Name: spu_condivareceptores(facele.codcondiva, facele.cmpclase, facele.descripcion, facele.codcondiva); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spu_condivareceptores(p_codcondiva facele.codcondiva, p_cmpclase facele.cmpclase, p_descripcion facele.descripcion, p_pk_codcondiva facele.codcondiva) RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_errorMsg         TEXT;
	l_fieldList        TEXT;
	l_fieldNameList    TEXT;
	l_pkParams         TEXT;
    l_NoTempModFields  INT;
    l_dmlString        TEXT;
    l_pkString         TEXT;
    l_newValue         TEXT;

    l_CodCondIva  facele.CodCondIva;
    l_CmpClase  facele.CmpClase;
    l_Descripcion  facele.Descripcion;
    l_pk_CodCondIva   facele.CodCondIva;

	l_rec		facele.t_CondIvaReceptores;

BEGIN
	-- Validación de PK provistas
	IF (p_pk_CodCondIva IS NULL) THEN

		RAISE EXCEPTION '%', 'No se ha provisto el conjunto de valores de la clave primaria del registro a modificar';

	END IF;

	SELECT * INTO l_rec
		FROM facele.t_CondIvaReceptores
		WHERE (CodCondIva = p_pk_CodCondIva);

    l_CodCondIva := p_CodCondIva;
    l_pk_CodCondIva := p_pk_CodCondIva;
    l_CmpClase := p_CmpClase;
    l_Descripcion := p_Descripcion;

    -- No PRE-UPDATE
   
	l_fieldList := NULL;
    l_fieldNameList := NULL;
    -- Cuenta los campos modificados que son definitivos en la tabla
    l_NoTempModFields := 0;
    
	IF l_rec.CodCondIva IS DISTINCT FROM l_CodCondIva THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'CodCondIva = ' || COALESCE(quote_literal(l_CodCondIva), 'NULL') ;
        IF l_CodCondIva IS NOT NULL THEN
            IF LENGTH(l_CodCondIva::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_CodCondIva::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_CodCondIva::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'CodCondIva=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.CmpClase IS DISTINCT FROM l_CmpClase THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'CmpClase = ' || COALESCE(quote_literal(l_CmpClase), 'NULL') ;
        IF l_CmpClase IS NOT NULL THEN
            IF LENGTH(l_CmpClase::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_CmpClase::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_CmpClase::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'CmpClase=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Descripcion IS DISTINCT FROM l_Descripcion THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Descripcion = ' || COALESCE(quote_literal(l_Descripcion), 'NULL') ;
        IF l_Descripcion IS NOT NULL THEN
            IF LENGTH(l_Descripcion::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Descripcion::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Descripcion::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Descripcion=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            

    
	IF l_fieldList IS NOT NULL THEN

        l_dmlString := 'UPDATE facele.t_CondIvaReceptores SET ' || l_fieldList || ' WHERE ' ||
            'CodCondIva = ' || quote_literal(l_pk_CodCondIva);
        
		EXECUTE l_dmlString;

	END IF;
    
    
    -- No POST-UPDATE
    
    RETURN l_NoTempModFields;

-- Manejo de errores
EXCEPTION

	WHEN OTHERS THEN
		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_CondIvaReceptores', 'actualizar',
            
			'Cód. condic. IVA = ' || l_pk_CodCondIva::TEXT);
   
END;
$$;


ALTER FUNCTION facele.spu_condivareceptores(p_codcondiva facele.codcondiva, p_cmpclase facele.cmpclase, p_descripcion facele.descripcion, p_pk_codcondiva facele.codcondiva) OWNER TO sa;

