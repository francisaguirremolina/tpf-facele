	END IF;
    
    
    -- No POST-UPDATE
    
    RETURN l_NoTempModFields;

-- Manejo de errores
EXCEPTION

	WHEN OTHERS THEN
		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_FEXUnidadesMedida', 'actualizar',
            
