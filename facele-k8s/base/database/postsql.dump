-- Name: COLUMN t_fecomprobantesiva.codaliciva; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesiva.codaliciva IS 'Código de alícuota de IVA (según el método FEParamGetTiposIva)';


--
-- Name: COLUMN t_fecomprobantesiva.baseimp; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesiva.baseimp IS 'Base imponible para la determinación de la alícuota';


--
-- Name: COLUMN t_fecomprobantesiva.importe; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesiva.importe IS 'Importe del impuesto';


