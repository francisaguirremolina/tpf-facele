--

CREATE FUNCTION facele.spar_feptosvta(p_rec facele.t_feptosvta) RETURNS facele.idptovta
    LANGUAGE plpgsql
    AS $$
BEGIN
    /* Función de agregado de registros en la tabla facele.t_FEPtosVta
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
    RETURN facele.spa_FEPtosVta (
                 p_rec.IdPtoVta, 
                 p_rec.Cuit, 
                 p_rec.PtoVta, 
                 p_rec.Descripcion, 
                 p_rec.LineaComprobante1, 
                 p_rec.LineaComprobante2, 
                 p_rec.LineaComprobante3, 
                 p_rec.LineaComprobante4, 
                 p_rec.LineaComprobante5, 
                 p_rec.LineaComprobante6, 
                 p_rec.LineaComprobante7, 
                 p_rec.LineaComprobante8, 
                 p_rec.LineaComprobante9, 
                 p_rec.LineaComprobante10, 
                 p_rec.CodActividad
    );
END;
$$;


