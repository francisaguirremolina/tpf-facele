CREATE FUNCTION facele.spa_fecomprobantesasoc(p_idcomprobasoc facele.idcomprobasoc, p_iddocumentofe facele.iddocumentofe, p_ptovta facele.ptovta, p_cbtetipo facele.cbtetipo, p_cbtenumero facele.cbtenumero, p_cbtecuit facele.cuit) RETURNS facele.idcomprobasoc
    LANGUAGE plpgsql
    AS $$
 BEGIN
    /* Función de agregado de registros en la tabla facele.t_FEComprobantesAsoc
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
	IF facele.spe_FEComprobantesAsoc(p_IdComprobAsoc) THEN

