    l_VencCert     facele.Fecha;
    l_CBU     facele.CBU;
    l_VencimientoCDC     facele.FechaHora;
    l_TokenCDC     facele.Token;
    l_SignCDC     facele.Sign;
    l_VencimientoFEX     facele.FechaHora;
    l_TokenFEX     facele.Token;
    l_SignFEX     facele.Sign;

BEGIN 
     -- Asignación de variables -------------------------
    l_Cuit := p_Cuit;
    l_Descripcion := p_Descripcion;
    l_Certificado := p_Certificado;
    l_ClavePrivada := p_ClavePrivada;
    l_TicketLive := p_TicketLive;
    l_Vencimiento := p_Vencimiento;
    l_Token := p_Token;
    l_Sign := p_Sign;
    l_VencCert := p_VencCert;
    l_CBU := p_CBU;
    l_VencimientoCDC := p_VencimientoCDC;
    l_TokenCDC := p_TokenCDC;
    l_SignCDC := p_SignCDC;
