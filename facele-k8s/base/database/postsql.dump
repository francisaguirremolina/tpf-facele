SET default_tablespace = '';

SET default_table_access_method = heap;

--
-- Name: t_conceptos; Type: TABLE; Schema: facele; Owner: sa
--

CREATE TABLE facele.t_conceptos (
    concepto facele.concepto NOT NULL,
    descripcion facele.descripcion NOT NULL,
    fchdesde facele.fecha NOT NULL,
    fchhasta facele.fecha,
    CONSTRAINT t_conceptos_check CHECK (((fchhasta IS NULL) OR ((fchhasta)::date >= (fchdesde)::date)))
);


ALTER TABLE facele.t_conceptos OWNER TO sa;

--
-- Name: TABLE t_conceptos; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON TABLE facele.t_conceptos IS 'CRDETR un concepto: productos, servicios, etc.
La enumeración se obtiene invocando el WS "FEParamGetTiposConcepto"';


--
-- Name: COLUMN t_conceptos.concepto; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_conceptos.concepto IS 'Concepto del Comprobante. 
Valores permitidos: 
1=Productos 
2=Servicios 
3=Productos y Servicios';


--
-- Name: COLUMN t_conceptos.descripcion; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_conceptos.descripcion IS 'Descripción';


--
-- Name: spar_conceptos(facele.t_conceptos); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spar_conceptos(p_rec facele.t_conceptos) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
BEGIN
    /* Función de agregado de registros en la tabla facele.t_Conceptos
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
    RETURN facele.spa_Conceptos (
                 p_rec.Concepto, 
                 p_rec.Descripcion, 
                 p_rec.FchDesde, 
                 p_rec.FchHasta
    );
END;
$$;


ALTER FUNCTION facele.spar_conceptos(p_rec facele.t_conceptos) OWNER TO sa;

--
-- Name: t_fecbtetipos; Type: TABLE; Schema: facele; Owner: sa
--

CREATE TABLE facele.t_fecbtetipos (
    cbtetipo facele.cbtetipo NOT NULL,
    descripcion facele.descripcion NOT NULL,
    fchdesde facele.fecha NOT NULL,
    fchhasta facele.fecha,
    letrafiscal facele.letrafiscal,
    sintetico facele.descripcion,
    reporttemplate facele.reporttemplate,
    cbtefam facele.cbtefam,
    usonacional facele.usonacional DEFAULT 1 NOT NULL,
    usoexportac facele.usoexportac DEFAULT 0 NOT NULL,
    CONSTRAINT t_fecbtetipos_check CHECK ((((fchhasta IS NULL) OR ((fchhasta)::date >= (fchdesde)::date)) AND (((usonacional)::integer = 1) OR ((usoexportac)::integer = 1))))
);


ALTER TABLE facele.t_fecbtetipos OWNER TO sa;

--
-- Name: TABLE t_fecbtetipos; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON TABLE facele.t_fecbtetipos IS 'CRDETR un tipo de comprobante, según la tipificación establecida por ARCA.
La lista puede obtenerse invocando la operación "FEParamGetTiposCbte" del web-service.';


--
-- Name: COLUMN t_fecbtetipos.cbtetipo; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecbtetipos.cbtetipo IS 'Tipo de comprobante. Hasta 3 dígitos';


--
-- Name: COLUMN t_fecbtetipos.descripcion; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecbtetipos.descripcion IS 'Descripción';


--
-- Name: COLUMN t_fecbtetipos.letrafiscal; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecbtetipos.letrafiscal IS 'Letra fiscal de un comprobante: 
"A", "B", "C", "M", "R", "E", "X"';


--
-- Name: COLUMN t_fecbtetipos.sintetico; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecbtetipos.sintetico IS 'Nombre sintético del tipo de comprobante, sin la letra fiscal';


--
-- Name: COLUMN t_fecbtetipos.reporttemplate; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecbtetipos.reporttemplate IS 'Plantilla del reporte por defecto';


--
-- Name: COLUMN t_fecbtetipos.cbtefam; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecbtetipos.cbtefam IS 'Familia de comprobante (FAC, ND, NC, CVLP, FCEM, etc.)';


--
-- Name: COLUMN t_fecbtetipos.usonacional; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecbtetipos.usonacional IS 'UNO cuando es una entidad de referencia para documentos nacionales';


--
-- Name: COLUMN t_fecbtetipos.usoexportac; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecbtetipos.usoexportac IS 'UNO cuando es una entidad de referencia para documentos de exportación';


--
-- Name: spar_fecbtetipos(facele.t_fecbtetipos); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spar_fecbtetipos(p_rec facele.t_fecbtetipos) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
BEGIN
    /* Función de agregado de registros en la tabla facele.t_FECbteTipos
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
    RETURN facele.spa_FECbteTipos (
                 p_rec.CbteTipo, 
                 p_rec.Descripcion, 
                 p_rec.FchDesde, 
                 p_rec.FchHasta, 
                 p_rec.LetraFiscal, 
                 p_rec.Sintetico, 
                 p_rec.ReportTemplate, 
                 p_rec.CbteFam, 
                 p_rec.UsoNacional, 
                 p_rec.UsoExportac
    );
END;
$$;


ALTER FUNCTION facele.spar_fecbtetipos(p_rec facele.t_fecbtetipos) OWNER TO sa;

--
-- Name: t_fecomprobantes; Type: TABLE; Schema: facele; Owner: sa
--

CREATE TABLE facele.t_fecomprobantes (
    iddocumentofe facele.iddocumentofe NOT NULL,
    idptovta facele.idptovta NOT NULL,
    cbtetipo facele.cbtetipo NOT NULL,
    cbtedesde facele.cbtenumero,
    cbtehasta facele.cbtenumero,
    concepto facele.concepto NOT NULL,
    doctipo facele.doctipo NOT NULL,
    docnro facele.docnro NOT NULL,
    cbtefch facele.fecha NOT NULL,
    imptotal facele.monto NOT NULL,
    imptotconc facele.monto NOT NULL,
    impneto facele.monto NOT NULL,
    impopex facele.monto NOT NULL,
    imptrib facele.monto NOT NULL,
    impiva facele.monto NOT NULL,
    fchservdesde facele.fecha,
    fchservhasta facele.fecha,
    fchvtopago facele.fecha,
    monid facele.monid NOT NULL,
    moncotiz facele.moncotiz NOT NULL,
    resultado facele.resultado,
    codautorizacion facele.codautorizacion,
    caefchvto facele.fecha,
    hashlink facele.hashlink,
    codeerrs facele.descripcion,
    msgerrs facele.observaciones,
    reporttemplate facele.reporttemplate,
    barcode facele.barcode42,
    razonsocial facele.descripcion,
    domicilio1 facele.descripcion,
    domicilio2 facele.descripcion,
    lineacab1 facele.descripcion,
    lineacab2 facele.descripcion,
    lineacab3 facele.descripcion,
    lineacab4 facele.descripcion,
    lineacab5 facele.descripcion,
    lineacab6 facele.descripcion,
    lineacab7 facele.descripcion,
    lineacab8 facele.descripcion,
    lineacab9 facele.descripcion,
    lineacab10 facele.descripcion,
    lineacab11 facele.descripcion,
    lineacab12 facele.descripcion,
    lineacab13 facele.descripcion,
    lineacab14 facele.descripcion,
    lineacab15 facele.descripcion,
    lineacab16 facele.descripcion,
    lineacab17 facele.descripcion,
    lineacab18 facele.descripcion,
    lineacab19 facele.descripcion,
    lineacab20 facele.descripcion,
    fchproceso facele.fechahora,
    pdffilename facele.fullfilename,
    modelocopias facele.descripcion,
    estadopdf facele.estadopdf DEFAULT 'P'::bpchar,
    idlotefacturacion facele.idlotefacturacion,
    codactividad facele.codactividad,
    codcondiva facele.codcondiva,
    permisoexistente facele.sino,
    idfexdstpais facele.idfexdstpais,
    idfexdstcuit facele.idfexdstcuit,
    canmismonext facele.sino,
    obscomerciales facele.observaciones,
    observaciones facele.observaciones,
    formapago facele.descripcion,
    idfexidioma facele.idfexidioma,
    idfexincoterm facele.idfexincoterm,
    incotermsdesc facele.descripcion,
    montoescrito facele.sqltext,
    CONSTRAINT t_fecomprobantes_check CHECK ((((cbtehasta IS NULL) OR ((cbtehasta)::integer >= (cbtedesde)::integer)) AND (((doctipo)::integer = 99) OR (docnro IS NOT NULL)) AND ((fchvtopago IS NULL) OR ((fchvtopago)::date >= (cbtefch)::date)) AND (((concepto)::integer = 1) OR (fchservdesde IS NOT NULL)) AND (((concepto)::integer = 1) OR (fchservhasta IS NOT NULL)) AND (((concepto)::integer = 1) OR ((fchservhasta)::date >= (fchservdesde)::date))))
);


ALTER TABLE facele.t_fecomprobantes OWNER TO sa;

--
-- Name: TABLE t_fecomprobantes; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON TABLE facele.t_fecomprobantes IS 'CRDETR un comprobante electrónico, ya autorizado o pendiente de autorización.';


--
-- Name: COLUMN t_fecomprobantes.iddocumentofe; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.iddocumentofe IS 'Código interno de comprobante';


--
-- Name: COLUMN t_fecomprobantes.idptovta; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.idptovta IS 'Código interno vde un punto de venta declarado';


--
-- Name: COLUMN t_fecomprobantes.cbtetipo; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.cbtetipo IS 'Tipo de comprobante. Hasta 3 dígitos';


--
-- Name: COLUMN t_fecomprobantes.cbtedesde; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.cbtedesde IS 'Número de comprobante (primer número del rango)';


--
-- Name: COLUMN t_fecomprobantes.cbtehasta; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.cbtehasta IS 'Número de comprobante (último número del rango). Si se omite, coincidirá que CbteDesde';


--
-- Name: COLUMN t_fecomprobantes.concepto; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.concepto IS 'Concepto del Comprobante. 
Valores permitidos: 
1=Productos 
2=Servicios 
3=Productos y Servicios';


--
-- Name: COLUMN t_fecomprobantes.doctipo; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.doctipo IS 'Código de documento identificatorio del comprador';


--
-- Name: COLUMN t_fecomprobantes.docnro; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.docnro IS 'Nro. de identificación del comprador';


--
-- Name: COLUMN t_fecomprobantes.cbtefch; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.cbtefch IS 'Fecha del comprobante. para concepto igual a 1, la fecha de emisión del comprobante puede ser hasta 5 días anteriores o posteriores respecto de la fecha de generación; si se indica Concepto igual a 2 ó 3 puede ser hasta 10 días anteriores o posteriores a la fecha de generación. Si no se envía la fecha del comprobante se asignará la fecha de proceso';


--
-- Name: COLUMN t_fecomprobantes.imptotal; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.imptotal IS 'Importe total del comprobante. Debe ser igual a:
Importe neto no gravado + Importe exento + Importe neto gravado + todos los campos de IVA al XX% + Importe de tributos.';


--
-- Name: COLUMN t_fecomprobantes.imptotconc; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.imptotconc IS 'Importe neto no gravado.
No puede ser mayor al Importe total de la operación ni menor a cero (0).
Para comprobantes tipo C debe ser igual a cero (0).
Para comprobantes tipo Bienes Usados ? Emisor Monotributista este campo corresponde al importe subtotal.';


--
-- Name: COLUMN t_fecomprobantes.impneto; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.impneto IS 'Importe neto gravado. Debe ser menor o igual a Importe total y no puede ser menor a cero. 
Para comprobantes A o B, es la suma de la base imponible de IVA.
Para comprobantes tipo C este campo corresponde al Importe del subtotal. 
Para comprobantes tipo Bienes Usados ? Emisor Monotributista no debe informarse o debe ser igual a cero (0).';


--
-- Name: COLUMN t_fecomprobantes.impopex; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.impopex IS 'Importe exento. Debe ser menor o igual a Importe total y no puede ser menor a cero. Para comprobantes tipo C debe ser igual a cero (0). 
Para comprobantes tipo Bienes Usados ? Emisor Monotributista no debe informarse o debe ser igual a cero (0).';


--
-- Name: COLUMN t_fecomprobantes.imptrib; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.imptrib IS 'Suma de los importes del array de tributos';


--
-- Name: COLUMN t_fecomprobantes.impiva; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.impiva IS 'Suma de los importes del array de IVA. 
Para comprobantes tipo C debe ser igual a cero (0). 
Para comprobantes tipo Bienes Usados ? Emisor Monotributista no debe informarse o debe ser igual a cero (0).';


--
-- Name: COLUMN t_fecomprobantes.fchservdesde; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.fchservdesde IS 'Fecha de inicio del abono para el servicio a facturar. Dato obligatorio para concepto 2 o 3 (Servicios / Productos y Servicios).';


--
-- Name: COLUMN t_fecomprobantes.fchservhasta; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.fchservhasta IS 'Fecha de fin del abono para el servicio a facturar. Dato obligatorio para concepto 2 o 3 (Servicios / Productos y Servicios). FchServHasta no puede ser menor a FchServDesde.';


--
-- Name: COLUMN t_fecomprobantes.fchvtopago; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.fchvtopago IS 'Fecha de vencimiento del pago servicio a facturar. Dato obligatorio para concepto 2 o 3 (Servicios / Productos y Servicios). Debe ser igual o posterior a la fecha del comprobante.';


--
-- Name: COLUMN t_fecomprobantes.monid; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.monid IS 'Código de moneda del comprobante.';


--
-- Name: COLUMN t_fecomprobantes.moncotiz; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.moncotiz IS 'Cotización de la moneda informada. Para PES, pesos argentinos la misma debe ser 1';


--
-- Name: COLUMN t_fecomprobantes.resultado; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.resultado IS 'Resultado del procesamiento. 
"P" cuando aún no fue procesado.';


--
-- Name: COLUMN t_fecomprobantes.codautorizacion; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.codautorizacion IS 'Código de autorización recibido';


--
-- Name: COLUMN t_fecomprobantes.caefchvto; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.caefchvto IS 'Fecha de vencimiento del código de autorización';


--
-- Name: COLUMN t_fecomprobantes.hashlink; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.hashlink IS 'Código pseudo-aleatorio para la identificación segura de comprobantes generados. 
Sólo letras "A" a "Z" y dígitos "0" a "9". 20 caracteres.';


--
-- Name: COLUMN t_fecomprobantes.codeerrs; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.codeerrs IS 'Lista unificada de códigos de error, códigos de observaciones y códigos de eventos, separada por comas';


--
-- Name: COLUMN t_fecomprobantes.msgerrs; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.msgerrs IS 'Lista unificada de mensajes de error, mensajes de observaciones y mensajes de eventos separada por saltos de línea.
Si el resultado es "T" (error técnico) se espera en este campo la lista de descripciones de las excepciones obtenidas desde Java.';


--
-- Name: COLUMN t_fecomprobantes.reporttemplate; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.reporttemplate IS 'Nombre del archivo (relativo o absoluto) .JASPER correspondiente al reporte.
Acepta variables de sistema (@FRAMEWORKDIR, @YEAR, etc.)';


--
-- Name: COLUMN t_fecomprobantes.razonsocial; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.razonsocial IS 'Nombre o razón social del tercero';


--
-- Name: COLUMN t_fecomprobantes.domicilio1; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.domicilio1 IS 'Primera línea del domicilio del tercero';


--
-- Name: COLUMN t_fecomprobantes.domicilio2; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.domicilio2 IS 'Segunda línea del domicilio del tercero';


--
-- Name: COLUMN t_fecomprobantes.lineacab1; Type: COMMENT; Schema: facele; Owner: sa
