        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'FchHasta=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.LetraFiscal IS DISTINCT FROM l_LetraFiscal THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'LetraFiscal = ' || COALESCE(quote_literal(l_LetraFiscal), 'NULL') ;
        IF l_LetraFiscal IS NOT NULL THEN
            IF LENGTH(l_LetraFiscal::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_LetraFiscal::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_LetraFiscal::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'LetraFiscal=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Sintetico IS DISTINCT FROM l_Sintetico THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Sintetico = ' || COALESCE(quote_literal(l_Sintetico), 'NULL') ;
        IF l_Sintetico IS NOT NULL THEN
            IF LENGTH(l_Sintetico::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Sintetico::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Sintetico::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Sintetico=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.ReportTemplate IS DISTINCT FROM l_ReportTemplate THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'ReportTemplate = ' || COALESCE(quote_literal(l_ReportTemplate), 'NULL') ;
        IF l_ReportTemplate IS NOT NULL THEN
            IF LENGTH(l_ReportTemplate::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_ReportTemplate::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_ReportTemplate::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'ReportTemplate=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.CbteFam IS DISTINCT FROM l_CbteFam THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'CbteFam = ' || COALESCE(quote_literal(l_CbteFam), 'NULL') ;
        IF l_CbteFam IS NOT NULL THEN
            IF LENGTH(l_CbteFam::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_CbteFam::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_CbteFam::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'CbteFam=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.UsoNacional IS DISTINCT FROM l_UsoNacional THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'UsoNacional = ' || COALESCE(quote_literal(l_UsoNacional), 'NULL') ;
        IF l_UsoNacional IS NOT NULL THEN
            IF LENGTH(l_UsoNacional::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_UsoNacional::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_UsoNacional::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'UsoNacional=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.UsoExportac IS DISTINCT FROM l_UsoExportac THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'UsoExportac = ' || COALESCE(quote_literal(l_UsoExportac), 'NULL') ;
        IF l_UsoExportac IS NOT NULL THEN
            IF LENGTH(l_UsoExportac::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_UsoExportac::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_UsoExportac::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'UsoExportac=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            

    
	IF l_fieldList IS NOT NULL THEN

        l_dmlString := 'UPDATE facele.t_FECbteTipos SET ' || l_fieldList || ' WHERE ' ||
            'CbteTipo = ' || quote_literal(l_pk_CbteTipo);
        
		EXECUTE l_dmlString;

	END IF;
    
    
    -- No POST-UPDATE
    
    RETURN l_NoTempModFields;

-- Manejo de errores
EXCEPTION

	WHEN OTHERS THEN
		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_FECbteTipos', 'actualizar',
            
			'Tipo comprob. = ' || l_pk_CbteTipo::TEXT);
   
END;
$$;


ALTER FUNCTION facele.spu_fecbtetipos(p_cbtetipo facele.cbtetipo, p_descripcion facele.descripcion, p_fchdesde facele.fecha, p_fchhasta facele.fecha, p_letrafiscal facele.letrafiscal, p_sintetico facele.descripcion, p_reporttemplate facele.reporttemplate, p_cbtefam facele.cbtefam, p_usonacional facele.usonacional, p_usoexportac facele.usoexportac, p_pk_cbtetipo facele.cbtetipo) OWNER TO sa;

--
-- Name: spu_fecomprobantes(facele.iddocumentofe, facele.idptovta, facele.cbtetipo, facele.cbtenumero, facele.cbtenumero, facele.concepto, facele.doctipo, facele.docnro, facele.fecha, facele.monto, facele.monto, facele.monto, facele.monto, facele.monto, facele.monto, facele.fecha, facele.fecha, facele.fecha, facele.monid, facele.moncotiz, facele.resultado, facele.codautorizacion, facele.fecha, facele.hashlink, facele.descripcion, facele.observaciones, facele.reporttemplate, facele.barcode42, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.descripcion, facele.fechahora, facele.fullfilename, facele.descripcion, facele.estadopdf, facele.idlotefacturacion, facele.codactividad, facele.codcondiva, facele.sino, facele.idfexdstpais, facele.idfexdstcuit, facele.sino, facele.observaciones, facele.observaciones, facele.descripcion, facele.idfexidioma, facele.idfexincoterm, facele.descripcion, facele.sqltext, facele.iddocumentofe); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spu_fecomprobantes(p_iddocumentofe facele.iddocumentofe, p_idptovta facele.idptovta, p_cbtetipo facele.cbtetipo, p_cbtedesde facele.cbtenumero, p_cbtehasta facele.cbtenumero, p_concepto facele.concepto, p_doctipo facele.doctipo, p_docnro facele.docnro, p_cbtefch facele.fecha, p_imptotal facele.monto, p_imptotconc facele.monto, p_impneto facele.monto, p_impopex facele.monto, p_imptrib facele.monto, p_impiva facele.monto, p_fchservdesde facele.fecha, p_fchservhasta facele.fecha, p_fchvtopago facele.fecha, p_monid facele.monid, p_moncotiz facele.moncotiz, p_resultado facele.resultado, p_codautorizacion facele.codautorizacion, p_caefchvto facele.fecha, p_hashlink facele.hashlink, p_codeerrs facele.descripcion, p_msgerrs facele.observaciones, p_reporttemplate facele.reporttemplate, p_barcode facele.barcode42, p_razonsocial facele.descripcion, p_domicilio1 facele.descripcion, p_domicilio2 facele.descripcion, p_lineacab1 facele.descripcion, p_lineacab2 facele.descripcion, p_lineacab3 facele.descripcion, p_lineacab4 facele.descripcion, p_lineacab5 facele.descripcion, p_lineacab6 facele.descripcion, p_lineacab7 facele.descripcion, p_lineacab8 facele.descripcion, p_lineacab9 facele.descripcion, p_lineacab10 facele.descripcion, p_lineacab11 facele.descripcion, p_lineacab12 facele.descripcion, p_lineacab13 facele.descripcion, p_lineacab14 facele.descripcion, p_lineacab15 facele.descripcion, p_lineacab16 facele.descripcion, p_lineacab17 facele.descripcion, p_lineacab18 facele.descripcion, p_lineacab19 facele.descripcion, p_lineacab20 facele.descripcion, p_fchproceso facele.fechahora, p_pdffilename facele.fullfilename, p_modelocopias facele.descripcion, p_estadopdf facele.estadopdf, p_idlotefacturacion facele.idlotefacturacion, p_codactividad facele.codactividad, p_codcondiva facele.codcondiva, p_permisoexistente facele.sino, p_idfexdstpais facele.idfexdstpais, p_idfexdstcuit facele.idfexdstcuit, p_canmismonext facele.sino, p_obscomerciales facele.observaciones, p_observaciones facele.observaciones, p_formapago facele.descripcion, p_idfexidioma facele.idfexidioma, p_idfexincoterm facele.idfexincoterm, p_incotermsdesc facele.descripcion, p_montoescrito facele.sqltext, p_pk_iddocumentofe facele.iddocumentofe) RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_errorMsg         TEXT;
	l_fieldList        TEXT;
	l_fieldNameList    TEXT;
	l_pkParams         TEXT;
    l_NoTempModFields  INT;
    l_dmlString        TEXT;
    l_pkString         TEXT;
    l_newValue         TEXT;

    l_IdDocumentoFE  facele.IdDocumentoFE;
    l_IdPtoVta  facele.IdPtoVta;
    l_CbteTipo  facele.CbteTipo;
    l_CbteDesde  facele.CbteNumero;
    l_CbteHasta  facele.CbteNumero;
    l_Concepto  facele.Concepto;
    l_DocTipo  facele.DocTipo;
    l_DocNro  facele.DocNro;
    l_CbteFch  facele.Fecha;
    l_ImpTotal  facele.Monto;
    l_ImpTotConc  facele.Monto;
    l_ImpNeto  facele.Monto;
    l_ImpOpEx  facele.Monto;
    l_ImpTrib  facele.Monto;
    l_ImpIVA  facele.Monto;
    l_FchServDesde  facele.Fecha;
    l_FchServHasta  facele.Fecha;
    l_FchVtoPago  facele.Fecha;
    l_MonId  facele.MonId;
    l_MonCotiz  facele.MonCotiz;
    l_Resultado  facele.Resultado;
    l_CodAutorizacion  facele.CodAutorizacion;
    l_CAEFchVto  facele.Fecha;
    l_HashLink  facele.HashLink;
    l_CodeErrs  facele.Descripcion;
    l_MsgErrs  facele.Observaciones;
    l_ReportTemplate  facele.ReportTemplate;
    l_BarCode  facele.BarCode42;
    l_RazonSocial  facele.Descripcion;
    l_Domicilio1  facele.Descripcion;
    l_Domicilio2  facele.Descripcion;
    l_LineaCab1  facele.Descripcion;
    l_LineaCab2  facele.Descripcion;
    l_LineaCab3  facele.Descripcion;
    l_LineaCab4  facele.Descripcion;
    l_LineaCab5  facele.Descripcion;
    l_LineaCab6  facele.Descripcion;
    l_LineaCab7  facele.Descripcion;
    l_LineaCab8  facele.Descripcion;
    l_LineaCab9  facele.Descripcion;
    l_LineaCab10  facele.Descripcion;
    l_LineaCab11  facele.Descripcion;
    l_LineaCab12  facele.Descripcion;
    l_LineaCab13  facele.Descripcion;
    l_LineaCab14  facele.Descripcion;
    l_LineaCab15  facele.Descripcion;
    l_LineaCab16  facele.Descripcion;
    l_LineaCab17  facele.Descripcion;
    l_LineaCab18  facele.Descripcion;
    l_LineaCab19  facele.Descripcion;
    l_LineaCab20  facele.Descripcion;
    l_FchProceso  facele.FechaHora;
    l_PDFFileName  facele.FullFileName;
    l_ModeloCopias  facele.Descripcion;
    l_EstadoPDF  facele.EstadoPDF;
    l_IdLoteFacturacion  facele.IdLoteFacturacion;
    l_CodActividad  facele.CodActividad;
    l_CodCondIva  facele.CodCondIva;
    l_PermisoExistente  facele.SiNo;
    l_IdFEXDstPais  facele.IdFEXDstPais;
    l_IdFEXDstCuit  facele.IdFEXDstCuit;
