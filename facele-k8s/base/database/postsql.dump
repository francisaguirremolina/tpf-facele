		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.TokenFEX IS DISTINCT FROM l_TokenFEX THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'TokenFEX = ' || COALESCE(quote_literal(l_TokenFEX), 'NULL') ;
        IF l_TokenFEX IS NOT NULL THEN
            IF LENGTH(l_TokenFEX::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_TokenFEX::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_TokenFEX::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'TokenFEX=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.SignFEX IS DISTINCT FROM l_SignFEX THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'SignFEX = ' || COALESCE(quote_literal(l_SignFEX), 'NULL') ;
        IF l_SignFEX IS NOT NULL THEN
            IF LENGTH(l_SignFEX::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_SignFEX::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_SignFEX::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'SignFEX=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            

    
	IF l_fieldList IS NOT NULL THEN

        l_dmlString := 'UPDATE facele.t_FECuits SET ' || l_fieldList || ' WHERE ' ||
            'Cuit = ' || quote_literal(l_pk_Cuit);
        
		EXECUTE l_dmlString;

	END IF;
    
    
    -- No POST-UPDATE
    
    RETURN l_NoTempModFields;

-- Manejo de errores
EXCEPTION

	WHEN OTHERS THEN
		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_FECuits', 'actualizar',
            
			'CUIT = ' || l_pk_Cuit::TEXT);
   
END;
$$;


ALTER FUNCTION facele.spu_fecuits(p_cuit facele.cuit, p_descripcion facele.descripcion, p_certificado facele.certificado, p_claveprivada facele.claveprivada, p_ticketlive facele.segundos, p_vencimiento facele.fechahora, p_token facele.token, p_sign facele.sign, p_venccert facele.fecha, p_cbu facele.cbu, p_vencimientocdc facele.fechahora, p_tokencdc facele.token, p_signcdc facele.sign, p_vencimientofex facele.fechahora, p_tokenfex facele.token, p_signfex facele.sign, p_pk_cuit facele.cuit) OWNER TO sa;

--
-- Name: spu_fedoctipos(facele.doctipo, facele.descripcion, facele.fecha, facele.fecha, facele.doctipo); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spu_fedoctipos(p_doctipo facele.doctipo, p_descripcion facele.descripcion, p_fchdesde facele.fecha, p_fchhasta facele.fecha, p_pk_doctipo facele.doctipo) RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_errorMsg         TEXT;
	l_fieldList        TEXT;
	l_fieldNameList    TEXT;
	l_pkParams         TEXT;
    l_NoTempModFields  INT;
    l_dmlString        TEXT;
    l_pkString         TEXT;
    l_newValue         TEXT;

    l_DocTipo  facele.DocTipo;
    l_Descripcion  facele.Descripcion;
    l_FchDesde  facele.Fecha;
    l_FchHasta  facele.Fecha;
    l_pk_DocTipo   facele.DocTipo;

	l_rec		facele.t_FEDocTipos;

BEGIN
	-- Validación de PK provistas
	IF (p_pk_DocTipo IS NULL) THEN

		RAISE EXCEPTION '%', 'No se ha provisto el conjunto de valores de la clave primaria del registro a modificar';

	END IF;

	SELECT * INTO l_rec
		FROM facele.t_FEDocTipos
		WHERE (DocTipo = p_pk_DocTipo);

    l_DocTipo := p_DocTipo;
    l_pk_DocTipo := p_pk_DocTipo;
    l_Descripcion := p_Descripcion;
    l_FchDesde := p_FchDesde;
    l_FchHasta := p_FchHasta;

    -- No PRE-UPDATE
   
	l_fieldList := NULL;
    l_fieldNameList := NULL;
    -- Cuenta los campos modificados que son definitivos en la tabla
    l_NoTempModFields := 0;
    
	IF l_rec.DocTipo IS DISTINCT FROM l_DocTipo THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'DocTipo = ' || COALESCE(quote_literal(l_DocTipo), 'NULL') ;
        IF l_DocTipo IS NOT NULL THEN
            IF LENGTH(l_DocTipo::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_DocTipo::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_DocTipo::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'DocTipo=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Descripcion IS DISTINCT FROM l_Descripcion THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Descripcion = ' || COALESCE(quote_literal(l_Descripcion), 'NULL') ;
        IF l_Descripcion IS NOT NULL THEN
            IF LENGTH(l_Descripcion::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Descripcion::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Descripcion::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Descripcion=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.FchDesde IS DISTINCT FROM l_FchDesde THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'FchDesde = ' || COALESCE(quote_literal(l_FchDesde), 'NULL') ;
        IF l_FchDesde IS NOT NULL THEN
            IF LENGTH(l_FchDesde::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_FchDesde::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_FchDesde::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'FchDesde=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.FchHasta IS DISTINCT FROM l_FchHasta THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'FchHasta = ' || COALESCE(quote_literal(l_FchHasta), 'NULL') ;
        IF l_FchHasta IS NOT NULL THEN
            IF LENGTH(l_FchHasta::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_FchHasta::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_FchHasta::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'FchHasta=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            

    
	IF l_fieldList IS NOT NULL THEN

        l_dmlString := 'UPDATE facele.t_FEDocTipos SET ' || l_fieldList || ' WHERE ' ||
            'DocTipo = ' || quote_literal(l_pk_DocTipo);
        
		EXECUTE l_dmlString;

	END IF;
    
    
    -- No POST-UPDATE
    
    RETURN l_NoTempModFields;

-- Manejo de errores
EXCEPTION

	WHEN OTHERS THEN
		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_FEDocTipos', 'actualizar',
            
			'Tipo documento = ' || l_pk_DocTipo::TEXT);
   
END;
$$;


ALTER FUNCTION facele.spu_fedoctipos(p_doctipo facele.doctipo, p_descripcion facele.descripcion, p_fchdesde facele.fecha, p_fchhasta facele.fecha, p_pk_doctipo facele.doctipo) OWNER TO sa;

--
-- Name: spu_feivatipos(facele.codaliciva, facele.descripcion, facele.fecha, facele.fecha, facele.porcentaje, facele.codaliciva); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spu_feivatipos(p_codaliciva facele.codaliciva, p_descripcion facele.descripcion, p_fchdesde facele.fecha, p_fchhasta facele.fecha, p_alicuota facele.porcentaje, p_pk_codaliciva facele.codaliciva) RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_errorMsg         TEXT;
	l_fieldList        TEXT;
	l_fieldNameList    TEXT;
	l_pkParams         TEXT;
    l_NoTempModFields  INT;
    l_dmlString        TEXT;
    l_pkString         TEXT;
    l_newValue         TEXT;

    l_CodAlicIVA  facele.CodAlicIVA;
    l_Descripcion  facele.Descripcion;
    l_FchDesde  facele.Fecha;
    l_FchHasta  facele.Fecha;
    l_Alicuota  facele.Porcentaje;
    l_pk_CodAlicIVA   facele.CodAlicIVA;

	l_rec		facele.t_FEIVATipos;

BEGIN
	-- Validación de PK provistas
	IF (p_pk_CodAlicIVA IS NULL) THEN

		RAISE EXCEPTION '%', 'No se ha provisto el conjunto de valores de la clave primaria del registro a modificar';

	END IF;

	SELECT * INTO l_rec
		FROM facele.t_FEIVATipos
		WHERE (CodAlicIVA = p_pk_CodAlicIVA);

    l_CodAlicIVA := p_CodAlicIVA;
    l_pk_CodAlicIVA := p_pk_CodAlicIVA;
    l_Descripcion := p_Descripcion;
    l_FchDesde := p_FchDesde;
    l_FchHasta := p_FchHasta;
    l_Alicuota := p_Alicuota;

    -- No PRE-UPDATE
   
	l_fieldList := NULL;
    l_fieldNameList := NULL;
    -- Cuenta los campos modificados que son definitivos en la tabla
    l_NoTempModFields := 0;
    
	IF l_rec.CodAlicIVA IS DISTINCT FROM l_CodAlicIVA THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'CodAlicIVA = ' || COALESCE(quote_literal(l_CodAlicIVA), 'NULL') ;
        IF l_CodAlicIVA IS NOT NULL THEN
            IF LENGTH(l_CodAlicIVA::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_CodAlicIVA::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_CodAlicIVA::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'CodAlicIVA=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Descripcion IS DISTINCT FROM l_Descripcion THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Descripcion = ' || COALESCE(quote_literal(l_Descripcion), 'NULL') ;
        IF l_Descripcion IS NOT NULL THEN
            IF LENGTH(l_Descripcion::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Descripcion::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Descripcion::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Descripcion=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.FchDesde IS DISTINCT FROM l_FchDesde THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'FchDesde = ' || COALESCE(quote_literal(l_FchDesde), 'NULL') ;
        IF l_FchDesde IS NOT NULL THEN
            IF LENGTH(l_FchDesde::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_FchDesde::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_FchDesde::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'FchDesde=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.FchHasta IS DISTINCT FROM l_FchHasta THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'FchHasta = ' || COALESCE(quote_literal(l_FchHasta), 'NULL') ;
        IF l_FchHasta IS NOT NULL THEN
            IF LENGTH(l_FchHasta::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_FchHasta::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_FchHasta::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'FchHasta=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Alicuota IS DISTINCT FROM l_Alicuota THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Alicuota = ' || COALESCE(quote_literal(l_Alicuota), 'NULL') ;
        IF l_Alicuota IS NOT NULL THEN
            IF LENGTH(l_Alicuota::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Alicuota::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Alicuota::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Alicuota=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            

    
	IF l_fieldList IS NOT NULL THEN

        l_dmlString := 'UPDATE facele.t_FEIVATipos SET ' || l_fieldList || ' WHERE ' ||
            'CodAlicIVA = ' || quote_literal(l_pk_CodAlicIVA);
        
		EXECUTE l_dmlString;

	END IF;
    
    
    -- No POST-UPDATE
    
    RETURN l_NoTempModFields;

-- Manejo de errores
EXCEPTION

	WHEN OTHERS THEN
		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_FEIVATipos', 'actualizar',
            
			'Cód. tipo alícuota IVA = ' || l_pk_CodAlicIVA::TEXT);
   
END;
$$;


