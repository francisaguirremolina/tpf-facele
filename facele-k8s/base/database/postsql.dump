--
-- Name: pg_grantall(character varying, character varying, character varying); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.pg_grantall(p_right character varying, p_objectpattern character varying, p_role character varying) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_rec	RECORD;
	l_sql	TEXT;
BEGIN
	-- Esquemas
	FOR l_rec IN SELECT schema_name
		FROM pg_userschemata
		WHERE schema_name ILIKE p_ObjectPattern
		LOOP
		
		l_sql := 'GRANT ' || p_Right || ' ON SCHEMA ' || l_rec.schema_name || ' TO ' ||  quote_ident(p_Role);

		RAISE INFO '%', l_sql;

		EXECUTE l_sql;
	END LOOP;


-- Tablas
	FOR l_rec IN SELECT table_name
		FROM pg_usertables
		WHERE table_name ILIKE p_ObjectPattern
		LOOP

		l_sql := 'GRANT ' || p_Right || ' ON ' || l_rec.table_name || ' TO ' || quote_ident(p_Role);

		RAISE INFO '%', l_sql;

		EXECUTE l_sql;
	END LOOP;

-- Vistas
	FOR l_rec IN SELECT view_name
		FROM pg_userviews
		WHERE view_name ILIKE p_ObjectPattern
		LOOP

		l_sql := 'GRANT ' || p_Right || ' ON ' || l_rec.view_name || ' TO ' || quote_ident(p_Role);

		RAISE INFO '%', l_sql;

		EXECUTE l_sql;
	END LOOP;

-- Secuencias
	FOR l_rec IN SELECT sequence_name
		FROM pg_usersequences
		WHERE sequence_name ILIKE p_ObjectPattern
		LOOP

		l_sql := 'GRANT ' || p_Right || ' ON SEQUENCE ' || l_rec.sequence_name || ' TO ' || quote_ident(p_Role);

		RAISE INFO '%', l_sql;

		EXECUTE l_sql;
	END LOOP;

-- Funciones
	FOR l_rec IN SELECT declaration
		FROM pg_userfunctions
		WHERE fullname ILIKE p_ObjectPattern
		LOOP

		l_sql := 'GRANT ' || p_Right || ' ON FUNCTION ' || l_rec.declaration || ' TO ' || quote_ident(p_Role);

		RAISE INFO '%', l_sql;

		EXECUTE l_sql;
	END LOOP;

END;
$$;


ALTER FUNCTION public.pg_grantall(p_right character varying, p_objectpattern character varying, p_role character varying) OWNER TO sa;

--
-- Name: pg_parseexception(text, text, text, text, text); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.pg_parseexception(p_sqlstate text, p_errmsg text, p_tablename text, p_operation text, p_recordkey text) RETURNS text
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_toReturn	TEXT;
	l_arg1		TEXT;
	l_arg2		TEXT;
BEGIN

	-- raise info 'SQLSTATE=% ERRMSG=% TABLENAME=% OPERATION=% RECORDKEY=%', p_sqlstate, p_errmsg, p_tablename, p_operation, p_recordkey;

	l_toReturn := '; al ' || COALESCE(p_operation, '?')
		|| COALESCE(' el registro "' || p_recordKey, '')
		|| COALESCE('" de la tabla "' || pg_ClientMsg(p_tableName, 'table_name', null) || '"', '');


	IF p_sqlState = '22001' THEN
		-- Valor muy largo para campo alfanumérico: "value too long for type character varying(10)"
		l_arg1 := substring(p_errMsg from 'value too long for type #"%#"' for '#');
		l_toReturn := COALESCE('valor muy largo para el tipo de dato ' || l_arg1, p_errMsg) || l_toReturn;

		RETURN l_toReturn;

	END IF;

	IF p_sqlState = '22P02' THEN
		-- Sintaxis inválida: "invalid input syntax for integer: "a""
		l_arg1 := substring(p_errMsg from 'invalid input syntax for #"%#"' for '#');
		l_toReturn := COALESCE('sintaxis inválida para el tipo de dato ' || l_arg1, p_errMsg) || l_toReturn;

		RETURN l_toReturn;

	END IF;

	IF p_sqlState = '23502' THEN
		-- "null value in column "t" violates not-null constraint"
		l_arg1 := substring(p_errMsg from 'null value in column #"%#" violates not-null constraint' for '#');
		l_toReturn := COALESCE('la columna ' || l_arg1 || ' no acepta un valor nulo', p_errMsg) || l_toReturn;

		RETURN l_toReturn;

	END IF;

	-- Violación de Foreign Keys
	IF p_sqlState = '23503' THEN
		-- Inserción de hijo sin padre: "insert or update on table "ch" violates foreign key constraint "fk_cli_ccc_18018" "
		l_arg1 := substring(p_errMsg from 'insert or update on table "t_#"%#"" violates foreign key constraint %' for '#');

		IF l_arg1 IS NULL THEN

			-- Eliminación de padre con hijos: "update or delete on table "t" violates foreign key constraint "fk_cli_ccc_18018" on table "ch" "
			l_arg1 := substring(p_errMsg from 'update or delete on table "t_#"%#"" violates foreign key constraint %' for '#');
			l_arg2 := substring(p_errMsg from 'update or delete on table % violates foreign key constraint % on table "t_#"%#""' for '#');

			l_toReturn := COALESCE('del registro de la tabla "' || pg_ClientMsg(l_arg1, 'table_name', NULL)
			|| '" dependen uno o más registros en la tabla "' || pg_ClientMsg(l_arg2, 'table_name', NULL) || '"', p_errMsg)  || l_toReturn;

		ELSE
			l_arg2 := substring(p_errMsg from 'insert or update on table % violates foreign key constraint "#"%#""' for '#');

			l_toReturn := COALESCE('la tabla "' || pg_ClientMsg(l_arg1, 'table_name', NULL) 
			|| '" depende de un registro padre que no existe, en la tabla "' 
			|| pg_ClientMsg(l_arg2, 'fk_parentname', NULL) || '"', p_errMsg)  || l_toReturn;

		END IF;

		RETURN l_toReturn;

	END IF;

	IF p_sqlState = '23505' THEN
		-- Duplicidad de clave primaria: "duplicate key value violates unique constraint "pk_clientes" "
		-- Duplicidad de índice único:   "duplicate key value violates unique constraint "ak_clientes_1" "
		-- Duplicidad de índice único parcial:   "duplicate key value violates unique constraint "pak_clientes_1" "
		-- "llave duplicada viola restricción unique "ak_perfis_1" "
		--                                duplicate key value violates unique constraint "pk_estadosciviles"

		l_arg1 := substring(p_errMsg from 'duplicate key value violates unique constraint "pk_#"%#""' for '#');

		IF l_arg1 NOTNULL THEN

			-- Violación de clave primaria
			l_arg2 := pg_ClientMsg(l_arg1, 'table_pk', NULL);

			l_toReturn := COALESCE('el valor de ' || l_arg2 
			|| ' debe ser único para toda la tabla ' 
			|| pg_ClientMsg(l_arg1, 'table_name', NULL), p_errMsg)  || l_toReturn;


		ELSE

			-- Violación de índice único

			l_arg1 := substring(p_errMsg from 'duplicate key value violates unique constraint "ak_#"%#""' for '#');

			IF l_arg1 IS NULL THEN

				l_arg1 := substring(p_errMsg from 'duplicate key value violates unique constraint "pak_#"%#""' for '#');

			END IF;

			--l_toReturn := l_toReturn || COALESCE(' un valor duplicado viola la restricción de unicidad que establece que: ' 
            --    || pg_ClientMsg(l_arg1, 'index_unique', NULL), p_errMsg);
            
			l_toReturn := pg_ClientMsg(l_arg1, 'index_unique', NULL)|| '; un valor duplicado viola la restricción de unicidad; '
                || l_toReturn;

		END IF;

		RETURN COALESCE(l_toReturn, p_errMsg);

	END IF;

	IF p_sqlState = '23514' THEN
		-- Restricción CHECK de dominio: "value for domain d violates check constraint "d" "
		-- Restricción CHECK de tabla: "new row for relation "t_table" violates check constraint "t_table_check" "

		l_arg1 := substring(p_errMsg from 'value for domain #"%#" violates check constraint %' for '#');

		IF l_arg1 IS NULL THEN

			l_arg1 := substring(p_errMsg from 'new row for relation "t_#"%#"" violates check constraint %' for '#');

			l_arg2 := substring(p_errMsg from '% violates check constraint #"%#"' for '#');

			
			-- l_toReturn := l_toReturn || COALESCE(' la nueva fila para la tabla ' || l_arg1 || ' no cumple la siguiente condición: ' || l_arg2, p_errMsg);
			l_toReturn := COALESCE('la nueva fila para la tabla ' || l_arg1 
					|| ' no cumple la siguiente condición: ' 
					|| pg_clientMsg(l_arg1, 'table_check', null), p_errMsg)  || l_toReturn;

		ELSE

			l_toReturn := COALESCE('valor inválido para el dominio ' || l_arg1, p_errMsg) || l_toReturn;

		END IF;

		RETURN l_toReturn;

	END IF;

	l_toReturn := ' Código ' || COALESCE(p_sqlState, '?') || ': ' || COALESCE(p_errMsg, '?')  || l_toReturn;

	RETURN l_toReturn;

END
$$;


ALTER FUNCTION public.pg_parseexception(p_sqlstate text, p_errmsg text, p_tablename text, p_operation text, p_recordkey text) OWNER TO sa;

--
-- Name: spc_createviewdotmodel(); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.spc_createviewdotmodel() RETURNS SETOF text
    LANGUAGE plpgsql
    AS $$
DECLARE 
	l_line	INT;
	l_text	TEXT;
BEGIN

FOR l_line, l_text IN
	-- Cabecera del archivo ==================================
	SELECT 1010 AS Linea, 'digraph model {'
	UNION
	SELECT 1020, '   size="8.27,11.69"'
	UNION
	--SELECT 1030, '   ratio=auto'
	--UNION
	SELECT 1040, '   nodesep=0.5'
	UNION
	SELECT 1050, '   ranksep=0.5'
	UNION
	SELECT 1060, '   rankdir=LR'
	UNION
	SELECT 1070, '   overlap=false'
	UNION
    	SELECT 1080, '   node [fontname=Arial]'

	UNION

	-- Nodos
	SELECT 2000, obj_fqn || node_style || ';'
		FROM pg_related_objects_dotted

	UNION

	-- Dependencias
	SELECT 3000, REPLACE(dependency, '.', '__')
		FROM pg_view_usage_dotted

	UNION

	-- Cierre del archivo
	SELECT 9000, '}'		

	LOOP

		RETURN NEXT l_text;

	END LOOP;

END
$$;


ALTER FUNCTION public.spc_createviewdotmodel() OWNER TO sa;

--
-- Name: spc_deletetemptables(); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.spc_deletetemptables() RETURNS void
    LANGUAGE plpgsql
    AS $$
/**************************************************************************************
 * Descubre todas las funciones llamadas *.spc_DelTmpTab*() y las ejecuta dinámicamente
**************************************************************************************/
DECLARE
    l_rec   RECORD;
    l_sql   TEXT;

BEGIN
    FOR l_rec IN SELECT routine_schema, routine_name
    FROM information_schema.routines 
    WHERE routine_name ILIKE 'spc_DelTmpTab_%' LOOP
    
        l_sql := 'SELECT ' || l_rec.routine_schema || '.' || l_rec.routine_name || '();';
        
        -- RAISE INFO '%', l_sql;
        
        EXECUTE l_sql;
        
    END LOOP;

END
$$;


ALTER FUNCTION public.spc_deletetemptables() OWNER TO sa;

