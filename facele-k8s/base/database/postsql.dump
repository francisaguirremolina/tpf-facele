--
-- Name: spc_initschseq_facele_tpf_pub(); Type: FUNCTION; Schema: pub; Owner: sa
--

CREATE FUNCTION pub.spc_initschseq_facele_tpf_pub() RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_min	int8;
	l_max	int8;
	l_inc	int8;
	l_mod	int8;

BEGIN
	l_min	:= 0;
	l_max	:= 1000000000;
	l_inc	:= 1;
	l_mod	:= 0;
	
	IF EXISTS (SELECT true FROM information_schema.tables 
		WHERE table_schema = 'sync' AND table_name = 't_masterservers' ) THEN

		-- Esquema de replicación implementado

		SELECT MinSequenceValue, MaxSequenceValue, IncSequenceValue, ModSequenceValue
			INTO l_min, l_max, l_inc, l_mod
			FROM sync.t_masterservers 
			WHERE ActiveServer = 1;

        IF NOT FOUND THEN
        
            l_min	:= 0;
	       l_max	:= 1000000000;
	       l_inc	:= 1;
	       l_mod	:= 0;
	
        END IF;
        
	END IF;


END    
$$;


ALTER FUNCTION pub.spc_initschseq_facele_tpf_pub() OWNER TO sa;

--
-- Name: pg_clientmsg(character varying, character varying, character varying); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.pg_clientmsg(p_table character varying, p_type character varying, p_member character varying) RETURNS text
    LANGUAGE plpgsql IMMUTABLE
    AS $$
/**********************************************
Devuelve mensajes destinados al cliente.

p_table es el nombre físico de la tabla a buscar (incluido el prefijo y el esquema; o sin esquema ni prefijo)
Por cada objeto busca primero que p_table sea igual al FQN (incluyendo el esquema y prefijo)
Si no lo encuentra, busca nuevamente comparando sólo el nombre (sin esquema ni prefijo), corriendo el riesgo de encontrar una tabla con el mismo nombre, en otro esquema.

p_type es el tipo de mensaje a buscar. Es una constante fija que
puede tomar el valor:

table_name, para el Caption de la tabla; si no hay caption, devuelve el Name
table_check, para el mensaje CheckMsg de la tabla; si no hay mensaje, devuelve la expresión Check
column_name, para el Caption de la columna; si no hay caption, devuelve el Name
column_check, para el mensaje CheckMsg de la columna; si no hay mensaje, devuelve la expresión Check
index_unique, para el mensaje UniqueMsg del índice; si no hay mensaje, construye uno basado en las columnas del índice
table_pk, para la lista de Captions(o Names) de las columnas de la clave primaria

p_member Miembro de la entidad p_table (por ejemplo, nombre de columna)

**********************************************/
BEGIN

IF p_type = 'index_unique' THEN

	IF p_table ILIKE 'Conceptos_1' THEN
		RETURN 'El nombre del concepto debe ser único';
	END IF;

	IF p_table ILIKE 'CondIvaReceptores_1' THEN
		RETURN 'La descripción de la condición debe ser única';
	END IF;

	IF p_table ILIKE 'FEXDstCuits_1' THEN
		RETURN 'La descripción debe ser única';
	END IF;

	IF p_table ILIKE 'FEXDstPaises_1' THEN
		RETURN 'La descripción debe ser única';
	END IF;

	IF p_table ILIKE 'FEXIdiomas_1' THEN
		RETURN 'La descripción debe ser única';
	END IF;

	IF p_table ILIKE 'FEXIncoterms_1' THEN
		RETURN 'La descripción debe ser única';
	END IF;

	IF p_table ILIKE 'FEXTiposExpo_1' THEN
		RETURN 'La descripción debe ser única';
	END IF;

	IF p_table ILIKE 'FEXUnidadesMedida_1' THEN
		RETURN 'La descripción debe ser única';
	END IF;

	IF p_table ILIKE 'IPCColas_1' THEN
		RETURN 'El tipo de cola debe ser único';
	END IF;

	IF p_table ILIKE 'Monedas_1' THEN
		RETURN 'El nombre de la moneda debe ser único';
	END IF;

	IF p_table ILIKE 'Paises_1' THEN
		RETURN 'El nombre del país debe ser único';
	END IF;

	IF p_table ILIKE 'FECbteTipos_1' THEN
		RETURN 'La descripción del tipo de comprobante debe ser única';
	END IF;

	IF p_table ILIKE 'FECotizMonedas_1' THEN
		RETURN 'La cotización en cada fecha debe ser única para cada moneda';
	END IF;

	IF p_table ILIKE 'FECuits_2' THEN
		RETURN 'La descripción del CUIT debe ser única';
	END IF;

	IF p_table ILIKE 'FEDocTipos_1' THEN
		RETURN 'La descripción del tipo de documento debe ser única';
	END IF;

	IF p_table ILIKE 'FEIVATipos_1' THEN
		RETURN 'La descripción del tipo de IVA debe ser única';
	END IF;

	IF p_table ILIKE 'FEIVATipos_2' THEN
		RETURN 'La alícuota de IVA debe ser única';
	END IF;

	IF p_table ILIKE 'FEOpcionalesTipos_1' THEN
		RETURN 'La descripción del opcional debe ser única';
	END IF;

	IF p_table ILIKE 'FETributosTipos_1' THEN
		RETURN 'La descripción del tributo debe ser única';
	END IF;

	IF p_table ILIKE 'ModeloCopias_2' THEN
		RETURN 'El nombre de la copia debe ser único en cada modelo';
	END IF;

	IF p_table ILIKE 'FEPtosVta_1' THEN
		RETURN 'El punto de venta debe ser único en cada CUIT';
	END IF;

	IF p_table ILIKE 'FEPtosVta_2' THEN
		RETURN 'La descripción del punto de venta debe ser único en cada CUIT';
	END IF;

	IF p_table ILIKE 'FEComprobantes_2' THEN
		RETURN 'La combinación (Tipo/PtoVta/CbteDesde) debe ser única';
	END IF;

	IF p_table ILIKE 'FEComprobantesAsoc_1' THEN
		RETURN 'El comprobante asociado solo puede asociarse una vez';
	END IF;

	IF p_table ILIKE 'FEComprobantesIva_1' THEN
		RETURN 'La alícuota de IVA debe declararse solo una vez en cada comprobante';
	END IF;

	IF p_table ILIKE 'FEComprobantesOpc_1' THEN
		RETURN 'El valor opcional debe declararse solo una vez en cada comprobante';
	END IF;

END IF;


IF p_type = 'table_name' THEN
	-- Busca el FQN

	IF p_table = 'facele.t_Conceptos' THEN
		RETURN 'Conceptos';
	END IF;
	IF p_table = 'facele.t_FECondIvaReceptores' THEN
		RETURN 'Condiciones de IVA de receptores';
	END IF;
	IF p_table = 'facele.t_FEXDstCuits' THEN
		RETURN 'CUITs de destino';
	END IF;
	IF p_table = 'facele.t_FEXDstPaises' THEN
		RETURN 'Países de destino';
	END IF;
	IF p_table = 'facele.t_FEXIdiomas' THEN
		RETURN 'Idiomas';
	END IF;
	IF p_table = 'facele.t_FEXIncoterms' THEN
		RETURN 'Incoterms';
	END IF;
	IF p_table = 'facele.t_FEXPermisos' THEN
		RETURN 'Permisos de exportación';
	END IF;
	IF p_table = 'facele.t_FEXTiposExpo' THEN
		RETURN 'Tipos de exportaciones';
	END IF;
	IF p_table = 'facele.t_FEXUnidadesMedida' THEN
		RETURN 'Unidades de medida';
	END IF;
	IF p_table = 'facele.t_IPCColas' THEN
		RETURN 'IPC de colas';
	END IF;
	IF p_table = 'facele.t_Monedas' THEN
		RETURN 'Monedas';
	END IF;
	IF p_table = 'facele.t_Paises' THEN
		RETURN 'Países';
	END IF;
	IF p_table = 'facele.t_FECbteTipos' THEN
		RETURN 'Tipos de comprobantes';
	END IF;
	IF p_table = 'facele.t_FECotizMonedas' THEN
		RETURN 'Cotizac. de monedas';
	END IF;
	IF p_table = 'facele.t_FECuits' THEN
		RETURN 'CUITs';
	END IF;
	IF p_table = 'facele.t_FEDocTipos' THEN
		RETURN 'Tipos de docum. de ident.';
	END IF;
	IF p_table = 'facele.t_FEIVATipos' THEN
		RETURN 'Tipos de IVA';
	END IF;
	IF p_table = 'facele.t_FEOpcionalesTipos' THEN
		RETURN 'Tipos de valores opc.';
	END IF;
	IF p_table = 'facele.t_FETributosTipos' THEN
		RETURN 'Tipos de tributos';
	END IF;
	IF p_table = 'facele.t_ModeloCopias' THEN
		RETURN 'Modelos de copias de documentos';
	END IF;
	IF p_table = 'facele.t_FEPtosVta' THEN
		RETURN 'Puntos de venta';
	END IF;
	IF p_table = 'facele.t_FEComprobantes' THEN
		RETURN 'Comprobantes electrónicos';
	END IF;
	IF p_table = 'facele.t_FEComprobantesAsoc' THEN
		RETURN 'Compr. electr. asociados';
	END IF;
	IF p_table = 'facele.t_FEComprobantesDet' THEN
		RETURN 'Detalles de comprobantes';
	END IF;
	IF p_table = 'facele.t_FEComprobantesIva' THEN
		RETURN 'IVAs de comprob. electr.';
	END IF;
	IF p_table = 'facele.t_FEComprobantesOpc' THEN
		RETURN 'Opcionales de comprob. electr.';
	END IF;
	IF p_table = 'facele.t_FEComprobantesTrib' THEN
		RETURN 'Tributos de compr. electr.';
	END IF;
	-- Busca sólo el nombre

	IF p_table ILIKE 'Conceptos' THEN
		RETURN 'Conceptos';
	END IF;
	IF p_table ILIKE 'FECondIvaReceptores' THEN
		RETURN 'Condiciones de IVA de receptores';
	END IF;
	IF p_table ILIKE 'FEXDstCuits' THEN
		RETURN 'CUITs de destino';
	END IF;
	IF p_table ILIKE 'FEXDstPaises' THEN
		RETURN 'Países de destino';
	END IF;
	IF p_table ILIKE 'FEXIdiomas' THEN
		RETURN 'Idiomas';
	END IF;
	IF p_table ILIKE 'FEXIncoterms' THEN
		RETURN 'Incoterms';
	END IF;
	IF p_table ILIKE 'FEXPermisos' THEN
		RETURN 'Permisos de exportación';
	END IF;
	IF p_table ILIKE 'FEXTiposExpo' THEN
		RETURN 'Tipos de exportaciones';
	END IF;
	IF p_table ILIKE 'FEXUnidadesMedida' THEN
		RETURN 'Unidades de medida';
	END IF;
	IF p_table ILIKE 'IPCColas' THEN
		RETURN 'IPC de colas';
	END IF;
	IF p_table ILIKE 'Monedas' THEN
		RETURN 'Monedas';
	END IF;
	IF p_table ILIKE 'Paises' THEN
		RETURN 'Países';
	END IF;
	IF p_table ILIKE 'FECbteTipos' THEN
		RETURN 'Tipos de comprobantes';
	END IF;
	IF p_table ILIKE 'FECotizMonedas' THEN
		RETURN 'Cotizac. de monedas';
	END IF;
	IF p_table ILIKE 'FECuits' THEN
		RETURN 'CUITs';
	END IF;
	IF p_table ILIKE 'FEDocTipos' THEN
		RETURN 'Tipos de docum. de ident.';
	END IF;
	IF p_table ILIKE 'FEIVATipos' THEN
		RETURN 'Tipos de IVA';
	END IF;
	IF p_table ILIKE 'FEOpcionalesTipos' THEN
		RETURN 'Tipos de valores opc.';
	END IF;
	IF p_table ILIKE 'FETributosTipos' THEN
		RETURN 'Tipos de tributos';
	END IF;
	IF p_table ILIKE 'ModeloCopias' THEN
		RETURN 'Modelos de copias de documentos';
	END IF;
	IF p_table ILIKE 'FEPtosVta' THEN
		RETURN 'Puntos de venta';
	END IF;
	IF p_table ILIKE 'FEComprobantes' THEN
		RETURN 'Comprobantes electrónicos';
	END IF;
	IF p_table ILIKE 'FEComprobantesAsoc' THEN
		RETURN 'Compr. electr. asociados';
	END IF;
	IF p_table ILIKE 'FEComprobantesDet' THEN
		RETURN 'Detalles de comprobantes';
	END IF;
	IF p_table ILIKE 'FEComprobantesIva' THEN
		RETURN 'IVAs de comprob. electr.';
	END IF;
	IF p_table ILIKE 'FEComprobantesOpc' THEN
		RETURN 'Opcionales de comprob. electr.';
	END IF;
	IF p_table ILIKE 'FEComprobantesTrib' THEN
		RETURN 'Tributos de compr. electr.';
	END IF;
	-- Caption no encontrado
	RETURN p_table;

END IF;

IF p_type = 'table_check' THEN
	-- Busca el FQN

	IF p_table = 'facele.t_Conceptos' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table = 'facele.t_FEXIdiomas' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table = 'facele.t_FEXIncoterms' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table = 'facele.t_FEXTiposExpo' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table = 'facele.t_FEXUnidadesMedida' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table = 'facele.t_Monedas' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"; la moneda debe usarse para uso nacional, para exportación, o ambos';
	END IF;

	IF p_table = 'facele.t_FECbteTipos' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"; el tipo de comprobante debe usarse para uso nacional, para exportación, o ambos';
	END IF;

	IF p_table = 'facele.t_FECotizMonedas' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table = 'facele.t_FEDocTipos' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table = 'facele.t_FEIVATipos' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table = 'facele.t_FEOpcionalesTipos' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"; el dato opcional debe usarse para uso nacional, para exportación, o ambos';
	END IF;

	IF p_table = 'facele.t_FETributosTipos' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table = 'facele.t_FEComprobantes' THEN
		RETURN '(CbteHasta IS NULL OR (CbteHasta >= CbteDesde))
AND (DocTipo = 99 OR DocNro IS NOT NULL)
AND (FchVtoPago IS NULL OR FchVtoPago >= CbteFch)
AND (Concepto = 1 OR FchServDesde IS NOT NULL)
AND (Concepto = 1 OR FchServHasta IS NOT NULL)
AND (Concepto = 1 OR FchServHasta >= FchServDesde)';
	END IF;

	-- Busca sólo el nombre

	IF p_table ILIKE 'Conceptos' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table ILIKE 'FEXIdiomas' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table ILIKE 'FEXIncoterms' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table ILIKE 'FEXTiposExpo' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table ILIKE 'FEXUnidadesMedida' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table ILIKE 'Monedas' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"; la moneda debe usarse para uso nacional, para exportación, o ambos';
	END IF;

	IF p_table ILIKE 'FECbteTipos' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"; el tipo de comprobante debe usarse para uso nacional, para exportación, o ambos';
	END IF;

	IF p_table ILIKE 'FECotizMonedas' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table ILIKE 'FEDocTipos' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table ILIKE 'FEIVATipos' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table ILIKE 'FEOpcionalesTipos' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"; el dato opcional debe usarse para uso nacional, para exportación, o ambos';
	END IF;

	IF p_table ILIKE 'FETributosTipos' THEN
		RETURN 'Si se indica la "Fecha hasta", debe ser posterior a "Fecha desde"';
	END IF;

	IF p_table ILIKE 'FEComprobantes' THEN
		RETURN '(CbteHasta IS NULL OR (CbteHasta >= CbteDesde))
AND (DocTipo = 99 OR DocNro IS NOT NULL)
AND (FchVtoPago IS NULL OR FchVtoPago >= CbteFch)
AND (Concepto = 1 OR FchServDesde IS NOT NULL)
AND (Concepto = 1 OR FchServHasta IS NOT NULL)
AND (Concepto = 1 OR FchServHasta >= FchServDesde)';
	END IF;

	-- Tabla no encontrada
	RETURN p_table;
END IF;

