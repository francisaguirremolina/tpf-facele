--
-- Name: spc_montoescrito_strunidadesmoneda(facele.sqlbigint); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spc_montoescrito_strunidadesmoneda(p_unmone facele.sqlbigint) RETURNS text
    LANGUAGE plpgsql
    AS $$
/***************************************************************
Función:             montoescrito_strunidadesmoneda(p_unmone): text 
Nombre público:      
Autores:             G. Sbrugnera
Inicio:               2025-10-21 12:17:55.817692
Última modificación:  2025-10-21 12:35:17.528075
Descripción:         
Responsabilidades:   
Precondiciones:      
Valor devuelto:      
Excepciones propias: 
Parámetros:
	p_unmone (IN, facele.SqlBigInt: bigint)		
****************************************************************/
BEGIN
	-- Control de parámetros de entrada
	
--BODY--DELIMITER--
DECLARE
        l_millones 	INT;	
        l_miles 	INT;
        l_unidades 	INT;
        l_toReturn 	TEXT;
        l_MonedaSin	TEXT;
        l_MonedaPlu	TEXT;
BEGIN

		l_MonedaPlu ='PESOS';
		l_MonedaSin ='PESO';

        l_millones := p_UnMone / 1000000;
        l_miles := (p_UnMone - l_millones * 1000000) / 1000;
        l_unidades := p_UnMone % 1000;
        
        l_toReturn := '';
        
        IF l_millones > 0 THEN
            l_toReturn := l_toReturn || facele.spc_MontoEscrito_strMillones(l_millones);
        END IF;
        
        IF l_miles > 0 THEN
            IF l_millones > 0 THEN
                l_toReturn := l_toReturn || ' ' || facele.spc_MontoEscrito_strMiles(l_miles);
            ELSE
                l_toReturn := l_toReturn || facele.spc_MontoEscrito_strMiles(l_miles);
            END IF;
        END IF;
        
        IF l_unidades > 0 THEN
            IF LENGTH(l_toReturn) > 0 THEN
                l_toReturn := l_toReturn || ' ';
            END IF;
            l_toReturn := l_toReturn || facele.spc_MontoEscrito_strUnidades(l_unidades);
        END IF;
        
        IF p_UnMone > 1 THEN
            IF (l_miles > 0) OR (l_unidades > 0) THEN
                RETURN l_toReturn || ' ' || l_MonedaPlu;
            ELSE
                RETURN l_toReturn || ' de ' || l_MonedaPlu;
            END IF;
        ELSE
            RETURN l_toReturn || ' '|| l_MonedaSin;
        END IF;
END
--BODY--DELIMITER--
;
END
$$;


ALTER FUNCTION facele.spc_montoescrito_strunidadesmoneda(p_unmone facele.sqlbigint) OWNER TO sa;

--
-- Name: spc_montoescrito_tblcientos(facele.sqlint); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spc_montoescrito_tblcientos(p_index facele.sqlint) RETURNS text
    LANGUAGE plpgsql
    AS $$
/***************************************************************
Función:             montoescrito_tblcientos(p_index): text 
Nombre público:      
Autores:             G. Sbrugnera
Inicio:               2025-10-21 12:17:56.404881
Última modificación:  2025-10-21 12:35:17.522777
Descripción:         
Responsabilidades:   
Precondiciones:      
Valor devuelto:      
Excepciones propias: 
Parámetros:
	p_index (IN, facele.SqlInt: integer)		
****************************************************************/
BEGIN
	-- Control de parámetros de entrada
	
--BODY--DELIMITER--
BEGIN
		RETURN CASE p_index
			WHEN 0 THEN ''
			WHEN 1 THEN 'ciento'
			WHEN 2 THEN 'doscientos'
			WHEN 3 THEN 'trescientos'
			WHEN 4 THEN 'cuatrocientos'
			WHEN 5 THEN 'quinientos'
			WHEN 6 THEN 'seiscientos'
			WHEN 7 THEN 'setecientos'
			WHEN 8 THEN 'ochocientos'
			WHEN 9 THEN 'novecientos'
		END;
	END
--BODY--DELIMITER--
;
END
$$;


ALTER FUNCTION facele.spc_montoescrito_tblcientos(p_index facele.sqlint) OWNER TO sa;

--
-- Name: spc_montoescrito_tbldecenas(facele.sqlint); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spc_montoescrito_tbldecenas(p_index facele.sqlint) RETURNS text
    LANGUAGE plpgsql
    AS $$
/***************************************************************
Función:             montoescrito_tbldecenas(p_index): text 
Nombre público:      
Autores:             G. Sbrugnera
Inicio:               2025-10-21 12:17:57.00137
Última modificación:  2025-10-21 12:35:17.519653
Descripción:         
Responsabilidades:   
Precondiciones:      
Valor devuelto:      
Excepciones propias: 
Parámetros:
	p_index (IN, facele.SqlInt: integer)		
****************************************************************/
BEGIN
	-- Control de parámetros de entrada
	
--BODY--DELIMITER--
BEGIN
		RETURN CASE p_index
			WHEN 0 THEN ''
			WHEN 1 THEN ''
			WHEN 2 THEN ''
			WHEN 3 THEN 'treinta'
			WHEN 4 THEN 'cuarenta'
			WHEN 5 THEN 'cincuenta'
			WHEN 6 THEN 'sesenta'
			WHEN 7 THEN 'setenta'
			WHEN 8 THEN 'ochenta'
			WHEN 9 THEN 'noventa'
		END;
	END
--BODY--DELIMITER--
;
END
$$;


ALTER FUNCTION facele.spc_montoescrito_tbldecenas(p_index facele.sqlint) OWNER TO sa;

--
-- Name: spc_montoescrito_tblunidades(facele.sqlint); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spc_montoescrito_tblunidades(p_index facele.sqlint) RETURNS text
    LANGUAGE plpgsql
    AS $$
/***************************************************************
Función:             montoescrito_tblunidades(p_index): text 
Nombre público:      
Autores:             G. Sbrugnera
Inicio:               2025-10-21 12:17:57.614945
Última modificación:  2025-10-21 12:35:17.510166
Descripción:         
Responsabilidades:   
Precondiciones:      
Valor devuelto:      
Excepciones propias: 
Parámetros:
	p_index (IN, facele.SqlInt: integer)		
****************************************************************/
BEGIN
	-- Control de parámetros de entrada
	
--BODY--DELIMITER--
BEGIN
		RETURN CASE p_index
			WHEN 0 THEN ''
		        WHEN 1 THEN 'un'
		        WHEN 2 THEN 'dos'
		        WHEN 3 THEN 'tres'
		        WHEN 4 THEN 'cuatro'
		        WHEN 5 THEN 'cinco'
		        WHEN 6 THEN 'seis'
		        WHEN 7 THEN 'siete'
		        WHEN 8 THEN 'ocho'
		        WHEN 9 THEN 'nueve'
		        WHEN 10 THEN 'diez'
		        WHEN 11 THEN 'once'
		        WHEN 12 THEN 'doce'
		        WHEN 13 THEN 'trece'
		        WHEN 14 THEN 'catorce'
		        WHEN 15 THEN 'quince'
		        WHEN 16 THEN 'dieciséis'
		        WHEN 17 THEN 'diecisiete'
		        WHEN 18 THEN 'dieciocho'
		        WHEN 19 THEN 'diecinueve'
		        WHEN 20 THEN 'veinte'
		        WHEN 21 THEN 'veintiún'
		        WHEN 22 THEN 'veintidós'
		        WHEN 23 THEN 'veintitrés'
		        WHEN 24 THEN 'veinticuatro'
		        WHEN 25 THEN 'veinticinco'
		        WHEN 26 THEN 'veintiséis'
		        WHEN 27 THEN 'veintisiete'
		        WHEN 28 THEN 'veintiocho'
		        WHEN 29 THEN 'veintinueve'
		        WHEN 30 THEN 'treinta'
		END;
	END
--BODY--DELIMITER--
;
END
$$;


ALTER FUNCTION facele.spc_montoescrito_tblunidades(p_index facele.sqlint) OWNER TO sa;

--
-- Name: spd_conceptos(facele.concepto); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spd_conceptos(p_concepto facele.concepto) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_errorMsg	TEXT;
    l_dmlString         TEXT;
         l_pkString      TEXT;

	l_Concepto	facele.Concepto;

BEGIN
	l_Concepto := p_Concepto;
	

    l_dmlString := 'DELETE FROM facele.t_Conceptos WHERE Concepto = ' || quote_literal(l_Concepto) || '';

    EXECUTE l_dmlString;
    
    

	

-- Manejo de errores
EXCEPTION

	WHEN  OTHERS THEN 

		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_Conceptos', 'eliminar', 
			'Concepto = ' || l_Concepto::TEXT);

END;
$$;


ALTER FUNCTION facele.spd_conceptos(p_concepto facele.concepto) OWNER TO sa;

