    l_ObsComerciales  facele.Observaciones;
    l_Observaciones  facele.Observaciones;
    l_FormaPago  facele.Descripcion;
    l_IdFEXIdioma  facele.IdFEXIdioma;
    l_IdFEXIncoterm  facele.IdFEXIncoterm;
    l_IncotermsDesc  facele.Descripcion;
    l_MontoEscrito  facele.SqlText;
    l_pk_IdDocumentoFE   facele.IdDocumentoFE;

	l_rec		facele.t_FEComprobantes;

BEGIN
	-- Validación de PK provistas
	IF (p_pk_IdDocumentoFE IS NULL) THEN

		RAISE EXCEPTION '%', 'No se ha provisto el conjunto de valores de la clave primaria del registro a modificar';

	END IF;

	SELECT * INTO l_rec
		FROM facele.t_FEComprobantes
		WHERE (IdDocumentoFE = p_pk_IdDocumentoFE);

    l_IdDocumentoFE := p_IdDocumentoFE;
    l_pk_IdDocumentoFE := p_pk_IdDocumentoFE;
    l_IdPtoVta := p_IdPtoVta;
    l_CbteTipo := p_CbteTipo;
    l_CbteDesde := p_CbteDesde;
    l_CbteHasta := p_CbteHasta;
    l_Concepto := p_Concepto;
    l_DocTipo := p_DocTipo;
    l_DocNro := p_DocNro;
    l_CbteFch := p_CbteFch;
    l_ImpTotal := p_ImpTotal;
    l_ImpTotConc := p_ImpTotConc;
    l_ImpNeto := p_ImpNeto;
    l_ImpOpEx := p_ImpOpEx;
    l_ImpTrib := p_ImpTrib;
    l_ImpIVA := p_ImpIVA;
    l_FchServDesde := p_FchServDesde;
    l_FchServHasta := p_FchServHasta;
    l_FchVtoPago := p_FchVtoPago;
    l_MonId := p_MonId;
    l_MonCotiz := p_MonCotiz;
    l_Resultado := p_Resultado;
    l_CodAutorizacion := p_CodAutorizacion;
    l_CAEFchVto := p_CAEFchVto;
    l_HashLink := p_HashLink;
    l_CodeErrs := p_CodeErrs;
    l_MsgErrs := p_MsgErrs;
    l_ReportTemplate := p_ReportTemplate;
    l_BarCode := p_BarCode;
    l_RazonSocial := p_RazonSocial;
    l_Domicilio1 := p_Domicilio1;
    l_Domicilio2 := p_Domicilio2;
    l_LineaCab1 := p_LineaCab1;
    l_LineaCab2 := p_LineaCab2;
    l_LineaCab3 := p_LineaCab3;
    l_LineaCab4 := p_LineaCab4;
    l_LineaCab5 := p_LineaCab5;
    l_LineaCab6 := p_LineaCab6;
    l_LineaCab7 := p_LineaCab7;
    l_LineaCab8 := p_LineaCab8;
    l_LineaCab9 := p_LineaCab9;
    l_LineaCab10 := p_LineaCab10;
    l_LineaCab11 := p_LineaCab11;
    l_LineaCab12 := p_LineaCab12;
    l_LineaCab13 := p_LineaCab13;
    l_LineaCab14 := p_LineaCab14;
    l_LineaCab15 := p_LineaCab15;
    l_LineaCab16 := p_LineaCab16;
    l_LineaCab17 := p_LineaCab17;
    l_LineaCab18 := p_LineaCab18;
    l_LineaCab19 := p_LineaCab19;
    l_LineaCab20 := p_LineaCab20;
    l_FchProceso := p_FchProceso;
    l_PDFFileName := p_PDFFileName;
    l_ModeloCopias := p_ModeloCopias;
    l_EstadoPDF := p_EstadoPDF;
    l_IdLoteFacturacion := p_IdLoteFacturacion;
    l_CodActividad := p_CodActividad;
    l_CodCondIva := p_CodCondIva;
    l_PermisoExistente := p_PermisoExistente;
    l_IdFEXDstPais := p_IdFEXDstPais;
    l_IdFEXDstCuit := p_IdFEXDstCuit;
    l_CanMisMonExt := p_CanMisMonExt;
    l_ObsComerciales := p_ObsComerciales;
    l_Observaciones := p_Observaciones;
    l_FormaPago := p_FormaPago;
    l_IdFEXIdioma := p_IdFEXIdioma;
    l_IdFEXIncoterm := p_IdFEXIncoterm;
    l_IncotermsDesc := p_IncotermsDesc;
    l_MontoEscrito := p_MontoEscrito;

    -- No PRE-UPDATE
   
	l_fieldList := NULL;
    l_fieldNameList := NULL;
    -- Cuenta los campos modificados que son definitivos en la tabla
    l_NoTempModFields := 0;
    
	IF l_rec.IdDocumentoFE IS DISTINCT FROM l_IdDocumentoFE THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'IdDocumentoFE = ' || COALESCE(quote_literal(l_IdDocumentoFE), 'NULL') ;
        IF l_IdDocumentoFE IS NOT NULL THEN
            IF LENGTH(l_IdDocumentoFE::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_IdDocumentoFE::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_IdDocumentoFE::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'IdDocumentoFE=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.IdPtoVta IS DISTINCT FROM l_IdPtoVta THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'IdPtoVta = ' || COALESCE(quote_literal(l_IdPtoVta), 'NULL') ;
        IF l_IdPtoVta IS NOT NULL THEN
            IF LENGTH(l_IdPtoVta::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_IdPtoVta::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_IdPtoVta::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'IdPtoVta=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.CbteTipo IS DISTINCT FROM l_CbteTipo THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'CbteTipo = ' || COALESCE(quote_literal(l_CbteTipo), 'NULL') ;
        IF l_CbteTipo IS NOT NULL THEN
            IF LENGTH(l_CbteTipo::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_CbteTipo::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_CbteTipo::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'CbteTipo=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.CbteDesde IS DISTINCT FROM l_CbteDesde THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'CbteDesde = ' || COALESCE(quote_literal(l_CbteDesde), 'NULL') ;
        IF l_CbteDesde IS NOT NULL THEN
            IF LENGTH(l_CbteDesde::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_CbteDesde::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_CbteDesde::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'CbteDesde=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.CbteHasta IS DISTINCT FROM l_CbteHasta THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'CbteHasta = ' || COALESCE(quote_literal(l_CbteHasta), 'NULL') ;
        IF l_CbteHasta IS NOT NULL THEN
            IF LENGTH(l_CbteHasta::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_CbteHasta::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_CbteHasta::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'CbteHasta=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Concepto IS DISTINCT FROM l_Concepto THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Concepto = ' || COALESCE(quote_literal(l_Concepto), 'NULL') ;
        IF l_Concepto IS NOT NULL THEN
            IF LENGTH(l_Concepto::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Concepto::TEXT FOR 10) || '...';
            ELSE
