--
-- Name: spe_conceptos(facele.concepto); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spe_conceptos(p_concepto facele.concepto) RETURNS boolean
    LANGUAGE plpgsql
    AS $$

BEGIN
	IF EXISTS (SELECT  true FROM facele.t_Conceptos
		WHERE Concepto IS NOT DISTINCT FROM p_Concepto
		) THEN

		RETURN  true;

	ELSE

		return false;

	END IF;

END;
$$;


ALTER FUNCTION facele.spe_conceptos(p_concepto facele.concepto) OWNER TO sa;

--
-- Name: spe_condivareceptores(facele.codcondiva); Type: FUNCTION; Schema: facele; Owner: sa
