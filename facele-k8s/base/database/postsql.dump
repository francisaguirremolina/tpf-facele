        PERFORM set_config('PRESERVE_TIMESTAMP.UPDATEDAT', NULL, true);
    END IF;

    RETURN facele.spu_FEXIncoterms (

        p_rec.IdFEXIncoterm ,
        p_rec.Descripcion ,
        p_rec.FchDesde ,
        p_rec.FchHasta ,
        p_rec.IdFEXIncoterm /* PRIMARY KEY */        );
END;
$$;


