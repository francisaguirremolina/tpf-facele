--
-- Name: t_fecotizmonedas; Type: TABLE; Schema: facele; Owner: sa
--

CREATE TABLE facele.t_fecotizmonedas (
    monid facele.monid NOT NULL,
    fechacotiz facele.fecha,
    moncotiz facele.moncotiz,
    idcotizmoneda facele.idcotizmoneda NOT NULL
);


ALTER TABLE facele.t_fecotizmonedas OWNER TO sa;

--
-- Name: TABLE t_fecotizmonedas; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON TABLE facele.t_fecotizmonedas IS 'CRDETR una moneda y su cotización vigente
La lista puede obtenerse invocando la operación "FEParamGetTiposMonedas" del web-service.';


--
-- Name: COLUMN t_fecotizmonedas.monid; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecotizmonedas.monid IS 'Código de moneda del comprobante. Consultar método FEParamGetTiposMonedas para valores posibles';


--
-- Name: COLUMN t_fecotizmonedas.moncotiz; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecotizmonedas.moncotiz IS 'Cotización de la moneda informada. Para PES, pesos argentinos la misma debe ser 1';


--
-- Name: COLUMN t_fecotizmonedas.idcotizmoneda; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecotizmonedas.idcotizmoneda IS 'Código de cotización de moneda';


