    l_NoTempModFields := 0;
    
	IF l_rec.IdPais IS DISTINCT FROM l_IdPais THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'IdPais = ' || COALESCE(quote_literal(l_IdPais), 'NULL') ;
        IF l_IdPais IS NOT NULL THEN
            IF LENGTH(l_IdPais::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_IdPais::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_IdPais::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'IdPais=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Descripcion IS DISTINCT FROM l_Descripcion THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Descripcion = ' || COALESCE(quote_literal(l_Descripcion), 'NULL') ;
        IF l_Descripcion IS NOT NULL THEN
            IF LENGTH(l_Descripcion::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Descripcion::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Descripcion::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Descripcion=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            

    
	IF l_fieldList IS NOT NULL THEN

        l_dmlString := 'UPDATE facele.t_Paises SET ' || l_fieldList || ' WHERE ' ||
            'IdPais = ' || quote_literal(l_pk_IdPais);
        
		EXECUTE l_dmlString;

	END IF;
    
    
    -- No POST-UPDATE
    
    RETURN l_NoTempModFields;

-- Manejo de errores
EXCEPTION

	WHEN OTHERS THEN
		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_Paises', 'actualizar',
            
			'País = ' || l_pk_IdPais::TEXT);
   
END;
$$;


ALTER FUNCTION facele.spu_paises(p_idpais facele.idpais, p_descripcion facele.descripcion, p_pk_idpais facele.idpais) OWNER TO sa;

