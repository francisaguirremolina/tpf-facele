BEGIN
	-- Validación de PK provistas
	IF (p_pk_IdComprobIVA IS NULL) THEN

		RAISE EXCEPTION '%', 'No se ha provisto el conjunto de valores de la clave primaria del registro a modificar';

	END IF;

	SELECT * INTO l_rec
		FROM facele.t_FEComprobantesIva
		WHERE (IdComprobIVA = p_pk_IdComprobIVA);

    l_pk_IdComprobIVA := p_pk_IdComprobIVA;
    l_IdDocumentoFE := p_IdDocumentoFE;
    l_CodAlicIVA := p_CodAlicIVA;
    l_BaseImp := p_BaseImp;
    l_Importe := p_Importe;

    -- No PRE-UPDATE
   
	l_fieldList := NULL;
    l_fieldNameList := NULL;
    -- Cuenta los campos modificados que son definitivos en la tabla
    l_NoTempModFields := 0;
    
	IF l_rec.IdDocumentoFE IS DISTINCT FROM l_IdDocumentoFE THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'IdDocumentoFE = ' || COALESCE(quote_literal(l_IdDocumentoFE), 'NULL') ;
        IF l_IdDocumentoFE IS NOT NULL THEN
            IF LENGTH(l_IdDocumentoFE::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_IdDocumentoFE::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_IdDocumentoFE::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'IdDocumentoFE=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.CodAlicIVA IS DISTINCT FROM l_CodAlicIVA THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'CodAlicIVA = ' || COALESCE(quote_literal(l_CodAlicIVA), 'NULL') ;
        IF l_CodAlicIVA IS NOT NULL THEN
            IF LENGTH(l_CodAlicIVA::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_CodAlicIVA::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_CodAlicIVA::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'CodAlicIVA=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.BaseImp IS DISTINCT FROM l_BaseImp THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'BaseImp = ' || COALESCE(quote_literal(l_BaseImp), 'NULL') ;
        IF l_BaseImp IS NOT NULL THEN
            IF LENGTH(l_BaseImp::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_BaseImp::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_BaseImp::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'BaseImp=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Importe IS DISTINCT FROM l_Importe THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Importe = ' || COALESCE(quote_literal(l_Importe), 'NULL') ;
        IF l_Importe IS NOT NULL THEN
            IF LENGTH(l_Importe::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Importe::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Importe::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Importe=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            

    
	IF l_fieldList IS NOT NULL THEN

        l_dmlString := 'UPDATE facele.t_FEComprobantesIva SET ' || l_fieldList || ' WHERE ' ||
            'IdComprobIVA = ' || quote_literal(l_pk_IdComprobIVA);
        
		EXECUTE l_dmlString;

	END IF;
    
    
    -- No POST-UPDATE
    
    RETURN l_NoTempModFields;

-- Manejo de errores
EXCEPTION

	WHEN OTHERS THEN
		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_FEComprobantesIva', 'actualizar',
            
			'Cód. alícuota IVA = ' || l_pk_IdComprobIVA::TEXT);
   
END;
$$;


