    l_Valor2     facele.Monto;
    l_Subtotal     facele.Monto;
    l_LineaDet1     facele.Descripcion;
    l_LineaDet2     facele.Descripcion;
    l_CodigoProducto     facele.CodigoProducto;
    l_Bonificacion     facele.Bonificacion4D;
    l_IdFEXUnidadMedida     facele.IdFEXUnidadMedida;

BEGIN 
     -- Asignación de variables -------------------------
    l_IdComprobanteDet := nextval('facele.sq_FEComprobantesDet_IdComprobanteDet');
    l_IdDocumentoFE := p_IdDocumentoFE;
    l_Cantidad := p_Cantidad;
    l_Descripcion := p_Descripcion;
    l_PrecioUnitario := p_PrecioUnitario;
    l_Valor1 := p_Valor1;
    l_Valor2 := p_Valor2;
    l_Subtotal := p_Subtotal;
    l_LineaDet1 := p_LineaDet1;
    l_LineaDet2 := p_LineaDet2;
    l_CodigoProducto := p_CodigoProducto;
    l_Bonificacion := p_Bonificacion;
    l_IdFEXUnidadMedida := p_IdFEXUnidadMedida;
    ---------------------------------------------------
    -- No PRE-INSERT
    
    l_dmlString := 'INSERT INTO facele.t_FEComprobantesDet (IdComprobanteDet,IdDocumentoFE,Cantidad,Descripcion,PrecioUnitario,Valor1,Valor2,Subtotal,LineaDet1,LineaDet2,CodigoProducto,Bonificacion,IdFEXUnidadMedida)';
    l_dmlString := l_dmlString || ' VALUES (' 
         || COALESCE(quote_literal(l_IdComprobanteDet), 'NULL') 
        || ','  || COALESCE(quote_literal(l_IdDocumentoFE), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Cantidad), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Descripcion), 'NULL') 
