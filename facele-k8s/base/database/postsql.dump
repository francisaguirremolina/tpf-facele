--

CREATE FUNCTION facele.spi_paises(p_idpais facele.idpais, p_descripcion facele.descripcion) RETURNS void
    LANGUAGE plpgsql
    AS $_$
DECLARE
    l_errorMsg      TEXT;
    l_dmlString     TEXT;
    l_pkString      TEXT;
    
    l_IdPais     facele.IdPais;
    l_Descripcion     facele.Descripcion;

BEGIN 
     -- Asignación de variables -------------------------
    l_IdPais := p_IdPais;
    l_Descripcion := p_Descripcion;
    ---------------------------------------------------
    -- No PRE-INSERT
    
    l_dmlString := 'INSERT INTO facele.t_Paises (IdPais,Descripcion)';
    l_dmlString := l_dmlString || ' VALUES (' 
         || COALESCE(quote_literal(l_IdPais), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Descripcion), 'NULL') 
 || ')';    
    
    EXECUTE l_dmlString;

    -- SYNCMODE=$table.getUDP("SYNCMODE")

    -- No POST-INSERT
     
    RETURN   ;
    
-- Manejo de errores
EXCEPTION
 
    WHEN  OTHERS THEN 
 
    RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_Paises', 'insertar', 
                         ' País=' || l_IdPais::TEXT);
            
END;
$_$;


