	<parameter name="IdDocumentoFE" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["204"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT	t.*,
	tt.Descripcion AS DescTributo
FROM facele.t_FEComprobantesTrib t
INNER JOIN facele.t_FETributosTipos tt USING (CodTributo)
WHERE t.IdDocumentoFE::TEXT=$P{IdDocumentoFE}]]>
	</queryString>
	<field name="idcomprobtrib" class="java.lang.Integer">
		<fieldDescription><![CDATA[Código interno de tributo de un comprobante electrónico]]></fieldDescription>
	</field>
