-- Name: COLUMN t_fecomprobantes.lineacab19; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.lineacab19 IS '19º línea de cabecera del comprobante, con información adicional';


--
-- Name: COLUMN t_fecomprobantes.lineacab20; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.lineacab20 IS '20º línea de cabecera del comprobante, con información adicional';


--
-- Name: COLUMN t_fecomprobantes.fchproceso; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.fchproceso IS 'Fecha y hora de procesamiento del requerimiento (hora de AFIP)';


--
-- Name: COLUMN t_fecomprobantes.pdffilename; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.pdffilename IS 'Nombre completo del archivo PDF del comprobante, en el momento de la generación';


--
-- Name: COLUMN t_fecomprobantes.modelocopias; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.modelocopias IS 'Modelo de copias para generación de PDF';


--
-- Name: COLUMN t_fecomprobantes.estadopdf; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.estadopdf IS 'Estado de la generación del PDF:
- "P": pendiente
- "G": generado
- "S": suspendido';


--
-- Name: COLUMN t_fecomprobantes.idlotefacturacion; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.idlotefacturacion IS 'Código de lote de facturación que agrupa varios comprobantes a facturar';


--
-- Name: COLUMN t_fecomprobantes.codactividad; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.codactividad IS 'La indicación de la actividad es opcional. ARCA acepta más de una actividad en cada comprobante, o ninguna.
Si se indicó una actividad predeterminada en el punto de venta, se informa a ARCA.';


--
-- Name: COLUMN t_fecomprobantes.codcondiva; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.codcondiva IS 'Código de condición de IVA del receptor';


--
-- Name: COLUMN t_fecomprobantes.permisoexistente; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.permisoexistente IS 'Solo para exportación. "S" cuando hay permisos de exportación.';


--
-- Name: COLUMN t_fecomprobantes.idfexdstpais; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.idfexdstpais IS 'Solo para exportación';


--
-- Name: COLUMN t_fecomprobantes.idfexdstcuit; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.idfexdstcuit IS 'Solo para exportación';


--
-- Name: COLUMN t_fecomprobantes.canmismonext; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.canmismonext IS 'Solo para exportación. "S" cuando el comprobante se cancela en la misma moneda';


--
-- Name: COLUMN t_fecomprobantes.obscomerciales; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.obscomerciales IS 'Solo para exportación. Observaciones comerciales';


--
-- Name: COLUMN t_fecomprobantes.observaciones; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.observaciones IS 'Solo para exportación. Observaciones generales';


--
-- Name: COLUMN t_fecomprobantes.formapago; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.formapago IS 'Solo para exportación. Descripción de la forma de pago.';


--
-- Name: COLUMN t_fecomprobantes.idfexidioma; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.idfexidioma IS 'Solo para exportación. Idioma del documento.';


--
-- Name: COLUMN t_fecomprobantes.idfexincoterm; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.idfexincoterm IS 'Incoterms - cláusula de venta';


--
-- Name: COLUMN t_fecomprobantes.incotermsdesc; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.incotermsdesc IS 'Información complementaria del incoterm';


--
-- Name: COLUMN t_fecomprobantes.montoescrito; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantes.montoescrito IS 'Monto escrito del campo ImpTotal';


--
-- Name: spar_fecomprobantes(facele.t_fecomprobantes); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spar_fecomprobantes(p_rec facele.t_fecomprobantes) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
BEGIN
    /* Función de agregado de registros en la tabla facele.t_FEComprobantes
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
    RETURN facele.spa_FEComprobantes (
                 p_rec.IdDocumentoFE, 
                 p_rec.IdPtoVta, 
                 p_rec.CbteTipo, 
                 p_rec.CbteDesde, 
                 p_rec.CbteHasta, 
                 p_rec.Concepto, 
                 p_rec.DocTipo, 
                 p_rec.DocNro, 
                 p_rec.CbteFch, 
                 p_rec.ImpTotal, 
                 p_rec.ImpTotConc, 
                 p_rec.ImpNeto, 
                 p_rec.ImpOpEx, 
                 p_rec.ImpTrib, 
                 p_rec.ImpIVA, 
                 p_rec.FchServDesde, 
                 p_rec.FchServHasta, 
                 p_rec.FchVtoPago, 
                 p_rec.MonId, 
                 p_rec.MonCotiz, 
                 p_rec.Resultado, 
                 p_rec.CodAutorizacion, 
                 p_rec.CAEFchVto, 
                 p_rec.HashLink, 
                 p_rec.CodeErrs, 
                 p_rec.MsgErrs, 
                 p_rec.ReportTemplate, 
                 p_rec.BarCode, 
                 p_rec.RazonSocial, 
                 p_rec.Domicilio1, 
                 p_rec.Domicilio2, 
                 p_rec.LineaCab1, 
                 p_rec.LineaCab2, 
                 p_rec.LineaCab3, 
                 p_rec.LineaCab4, 
                 p_rec.LineaCab5, 
                 p_rec.LineaCab6, 
                 p_rec.LineaCab7, 
                 p_rec.LineaCab8, 
                 p_rec.LineaCab9, 
                 p_rec.LineaCab10, 
                 p_rec.LineaCab11, 
                 p_rec.LineaCab12, 
                 p_rec.LineaCab13, 
                 p_rec.LineaCab14, 
                 p_rec.LineaCab15, 
                 p_rec.LineaCab16, 
                 p_rec.LineaCab17, 
                 p_rec.LineaCab18, 
                 p_rec.LineaCab19, 
                 p_rec.LineaCab20, 
                 p_rec.FchProceso, 
                 p_rec.PDFFileName, 
                 p_rec.ModeloCopias, 
                 p_rec.EstadoPDF, 
                 p_rec.IdLoteFacturacion, 
                 p_rec.CodActividad, 
                 p_rec.CodCondIva, 
                 p_rec.PermisoExistente, 
                 p_rec.IdFEXDstPais, 
                 p_rec.IdFEXDstCuit, 
                 p_rec.CanMisMonExt, 
                 p_rec.ObsComerciales, 
                 p_rec.Observaciones, 
                 p_rec.FormaPago, 
                 p_rec.IdFEXIdioma, 
                 p_rec.IdFEXIncoterm, 
                 p_rec.IncotermsDesc, 
                 p_rec.MontoEscrito
    );
END;
$$;


ALTER FUNCTION facele.spar_fecomprobantes(p_rec facele.t_fecomprobantes) OWNER TO sa;

--
-- Name: t_fecomprobantesasoc; Type: TABLE; Schema: facele; Owner: sa
--

CREATE TABLE facele.t_fecomprobantesasoc (
    idcomprobasoc facele.idcomprobasoc NOT NULL,
    iddocumentofe facele.iddocumentofe NOT NULL,
    ptovta facele.ptovta NOT NULL,
    cbtetipo facele.cbtetipo NOT NULL,
    cbtenumero facele.cbtenumero NOT NULL,
    cbtecuit facele.cuit
);


ALTER TABLE facele.t_fecomprobantesasoc OWNER TO sa;

--
-- Name: TABLE t_fecomprobantesasoc; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON TABLE facele.t_fecomprobantesasoc IS 'CRDETR un comprobante asociado a un comprobante electrónico. 
Por ejemplo, una nota de crédito asociada a una factura del mismo CUIT.
Un registro comprobante asociado ES-PARTE-DE un comprobante electrónico.';


--
-- Name: COLUMN t_fecomprobantesasoc.idcomprobasoc; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesasoc.idcomprobasoc IS 'Código interno de asociación de un comprobante asociado a un comprobante electrónico';


--
-- Name: COLUMN t_fecomprobantesasoc.iddocumentofe; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesasoc.iddocumentofe IS 'Código interno de comprobante';


--
-- Name: COLUMN t_fecomprobantesasoc.ptovta; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesasoc.ptovta IS 'Punto de venta del comprobante asociado. El punto de venta no necesariamente está declarado en FacEle, porque puede haber sido generado por otro medio.';


--
-- Name: COLUMN t_fecomprobantesasoc.cbtetipo; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesasoc.cbtetipo IS 'Tipo de comprobante. Hasta 3 dígitos';


--
-- Name: COLUMN t_fecomprobantesasoc.cbtenumero; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesasoc.cbtenumero IS 'Número de comprobante. Hasta 8 dígitos';


--
-- Name: COLUMN t_fecomprobantesasoc.cbtecuit; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesasoc.cbtecuit IS 'Solo para exportación. CUIT que generó el comprobante.';


--
-- Name: spar_fecomprobantesasoc(facele.t_fecomprobantesasoc); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spar_fecomprobantesasoc(p_rec facele.t_fecomprobantesasoc) RETURNS facele.idcomprobasoc
    LANGUAGE plpgsql
    AS $$
BEGIN
    /* Función de agregado de registros en la tabla facele.t_FEComprobantesAsoc
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
    RETURN facele.spa_FEComprobantesAsoc (
                 p_rec.IdComprobAsoc, 
                 p_rec.IdDocumentoFE, 
                 p_rec.PtoVta, 
                 p_rec.CbteTipo, 
                 p_rec.CbteNumero, 
                 p_rec.CbteCuit
    );
END;
$$;


ALTER FUNCTION facele.spar_fecomprobantesasoc(p_rec facele.t_fecomprobantesasoc) OWNER TO sa;

--
-- Name: t_fecomprobantesdet; Type: TABLE; Schema: facele; Owner: sa
--

CREATE TABLE facele.t_fecomprobantesdet (
    idcomprobantedet facele.idcomprobantedet NOT NULL,
    iddocumentofe facele.iddocumentofe NOT NULL,
    cantidad facele.monto,
    descripcion facele.descripcion NOT NULL,
    preciounitario facele.monto,
    valor1 facele.monto,
    valor2 facele.monto,
    subtotal facele.monto NOT NULL,
    lineadet1 facele.descripcion,
    lineadet2 facele.descripcion,
    codigoproducto facele.codigoproducto,
    bonificacion facele.bonificacion4d,
    idfexunidadmedida facele.idfexunidadmedida
);


ALTER TABLE facele.t_fecomprobantesdet OWNER TO sa;

--
-- Name: TABLE t_fecomprobantesdet; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON TABLE facele.t_fecomprobantesdet IS 'CRDETR una línea de detalle de un comprobante electrónico. Estas líneas no se necesitan para la solicitud del CAE, pero sí para la impresión autónoma del comprobante, independizando el módulo de Factura Electrónica del resto del sistema de gestión.';


--
-- Name: COLUMN t_fecomprobantesdet.idcomprobantedet; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesdet.idcomprobantedet IS 'Código de detalle de comprobante';


--
-- Name: COLUMN t_fecomprobantesdet.iddocumentofe; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesdet.iddocumentofe IS 'Código interno de comprobante';


--
-- Name: COLUMN t_fecomprobantesdet.cantidad; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesdet.cantidad IS 'Cantidad del producto del renglón';


--
-- Name: COLUMN t_fecomprobantesdet.descripcion; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesdet.descripcion IS 'Descripción';


--
-- Name: COLUMN t_fecomprobantesdet.preciounitario; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesdet.preciounitario IS 'En comprobantes A o M, es el precio unitario neto (sin IVA)
En comprobantes B o C, es el precio unitario final (con IVA)

En todos los casos, este precio no incluye aún el descuento por bonificación.';


--
-- Name: COLUMN t_fecomprobantesdet.valor1; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesdet.valor1 IS 'Valor genérico 1 del renglón. 
Predeterminado para discriminar el IVA del producto.
En los comprobantes A, valor de la alícuota de IVA 
(por ejemplo, "21").
En los comprobantes B o C, es NULL.';


--
-- Name: COLUMN t_fecomprobantesdet.valor2; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesdet.valor2 IS 'Valor genérico 2 del renglón.';


--
-- Name: COLUMN t_fecomprobantesdet.subtotal; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesdet.subtotal IS 'Depende funcionalmente de:
 Cantidad * PrecioUnitario - dto. bonif.';


--
-- Name: COLUMN t_fecomprobantesdet.codigoproducto; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesdet.codigoproducto IS 'Código del producto, según el fabricante, el proveedor o la empresa.';


--
-- Name: COLUMN t_fecomprobantesdet.bonificacion; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesdet.bonificacion IS 'Porcentaje de bonificación del renglón, en la escala 0-100.
Si es NULL, no hay bonificación.';


--
-- Name: COLUMN t_fecomprobantesdet.idfexunidadmedida; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesdet.idfexunidadmedida IS 'Código de unidad de medida';


--
-- Name: spar_fecomprobantesdet(facele.t_fecomprobantesdet); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spar_fecomprobantesdet(p_rec facele.t_fecomprobantesdet) RETURNS facele.idcomprobantedet
    LANGUAGE plpgsql
    AS $$
BEGIN
    /* Función de agregado de registros en la tabla facele.t_FEComprobantesDet
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
    RETURN facele.spa_FEComprobantesDet (
                 p_rec.IdComprobanteDet, 
                 p_rec.IdDocumentoFE, 
                 p_rec.Cantidad, 
                 p_rec.Descripcion, 
                 p_rec.PrecioUnitario, 
                 p_rec.Valor1, 
                 p_rec.Valor2, 
                 p_rec.Subtotal, 
                 p_rec.LineaDet1, 
                 p_rec.LineaDet2, 
                 p_rec.CodigoProducto, 
                 p_rec.Bonificacion, 
                 p_rec.IdFEXUnidadMedida
    );
END;
$$;


ALTER FUNCTION facele.spar_fecomprobantesdet(p_rec facele.t_fecomprobantesdet) OWNER TO sa;

--
