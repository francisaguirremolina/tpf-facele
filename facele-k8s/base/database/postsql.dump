        || ','  || COALESCE(quote_literal(l_Copia), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Observaciones), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Predeterminado), 'NULL') 
 || ')';    
    
    EXECUTE l_dmlString;

    -- SYNCMODE=$table.getUDP("SYNCMODE")

    -- No POST-INSERT
     
    RETURN   l_IdCopia  ;
    
-- Manejo de errores
EXCEPTION
 
    WHEN  OTHERS THEN 
 
    RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_ModeloCopias', 'insertar', 
                         ' Cód. copia=' || l_IdCopia::TEXT);
            
END;
$_$;


ALTER FUNCTION facele.spi_modelocopias(p_modelo facele.descripcion, p_copia facele.descripcion, p_observaciones facele.observaciones, p_predeterminado facele.sqlboolean) OWNER TO sa;

--
-- Name: spi_monedas(facele.monid, facele.descripcion, facele.fecha, facele.fecha, facele.usonacional, facele.usoexportac, facele.simbolomoneda); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spi_monedas(p_monid facele.monid, p_descripcion facele.descripcion, p_fchdesde facele.fecha, p_fchhasta facele.fecha, p_usonacional facele.usonacional, p_usoexportac facele.usoexportac, p_simbolomoneda facele.simbolomoneda) RETURNS void
    LANGUAGE plpgsql
    AS $_$
DECLARE
    l_errorMsg      TEXT;
    l_dmlString     TEXT;
    l_pkString      TEXT;
    
    l_MonId     facele.MonId;
    l_Descripcion     facele.Descripcion;
    l_FchDesde     facele.Fecha;
    l_FchHasta     facele.Fecha;
    l_UsoNacional     facele.UsoNacional;
    l_UsoExportac     facele.UsoExportac;
    l_SimboloMoneda     facele.SimboloMoneda;

BEGIN 
     -- Asignación de variables -------------------------
    l_MonId := p_MonId;
    l_Descripcion := p_Descripcion;
    l_FchDesde := p_FchDesde;
    l_FchHasta := p_FchHasta;
    l_UsoNacional := p_UsoNacional;
    l_UsoExportac := p_UsoExportac;
    l_SimboloMoneda := p_SimboloMoneda;
    ---------------------------------------------------
    -- No PRE-INSERT
    
    l_dmlString := 'INSERT INTO facele.t_Monedas (MonId,Descripcion,FchDesde,FchHasta,UsoNacional,UsoExportac,SimboloMoneda)';
    l_dmlString := l_dmlString || ' VALUES (' 
         || COALESCE(quote_literal(l_MonId), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Descripcion), 'NULL') 
        || ','  || COALESCE(quote_literal(l_FchDesde), 'NULL') 
        || ','  || COALESCE(quote_literal(l_FchHasta), 'NULL') 
        || ','  || COALESCE(quote_literal(l_UsoNacional), 'NULL') 
        || ','  || COALESCE(quote_literal(l_UsoExportac), 'NULL') 
        || ','  || COALESCE(quote_literal(l_SimboloMoneda), 'NULL') 
 || ')';    
    
    EXECUTE l_dmlString;

    -- SYNCMODE=$table.getUDP("SYNCMODE")

    -- No POST-INSERT
     
    RETURN   ;
    
-- Manejo de errores
EXCEPTION
 
    WHEN  OTHERS THEN 
 
    RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_Monedas', 'insertar', 
                         ' Cód. moneda=' || l_MonId::TEXT);
            
END;
$_$;


ALTER FUNCTION facele.spi_monedas(p_monid facele.monid, p_descripcion facele.descripcion, p_fchdesde facele.fecha, p_fchhasta facele.fecha, p_usonacional facele.usonacional, p_usoexportac facele.usoexportac, p_simbolomoneda facele.simbolomoneda) OWNER TO sa;

