--
-- Name: vw_comprobantesquery; Type: VIEW; Schema: facele; Owner: sa
--

CREATE VIEW facele.vw_comprobantesquery AS
 SELECT fecom.iddocumentofe,
    fecom.idptovta,
    pv.ptovta,
    pv.cuit,
    fecom.cbtetipo,
    fecom.cbtedesde,
    fecom.cbtehasta,
    fecom.concepto,
    fecom.doctipo,
    fecom.docnro,
    fecom.cbtefch,
    fecom.imptotal,
    fecom.imptotconc,
    fecom.impneto,
    fecom.imptrib,
    fecom.impiva,
    fecom.fchservdesde,
    fecom.fchservhasta,
    fecom.fchvtopago,
    fecom.monid,
    fecom.moncotiz,
    fecom.resultado,
    fecom.codautorizacion,
    fecom.caefchvto,
    fecom.hashlink,
    fecom.codeerrs,
    fecom.reporttemplate,
    fecom.razonsocial,
    fecom.domicilio1,
    fecom.domicilio2,
    fecom.fchproceso,
    fecom.pdffilename,
    fecom.impopex,
    fecom.msgerrs,
    fecom.barcode,
    fecom.modelocopias,
    fecom.estadopdf,
    fecom.idlotefacturacion,
    fecom.codactividad,
    fecom.codcondiva,
    fecom.permisoexistente,
    fecom.idfexdstpais AS destinocmp,
    fecom.idfexdstcuit AS cuitpaiscliente,
    fecom.canmismonext,
    fecom.obscomerciales,
    fecom.observaciones,
    fecom.formapago,
    fecom.idfexidioma AS idiomacbte,
    fecom.idfexincoterm AS incoterms,
    fecom.incotermsdesc
   FROM (facele.t_fecomprobantes fecom
     JOIN facele.t_feptosvta pv USING (idptovta));


ALTER VIEW facele.vw_comprobantesquery OWNER TO sa;

--
-- Name: COLUMN vw_comprobantesquery.iddocumentofe; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.iddocumentofe IS 'Código interno de comprobante';


--
-- Name: COLUMN vw_comprobantesquery.idptovta; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.idptovta IS 'Código interno vde un punto de venta declarado';


--
-- Name: COLUMN vw_comprobantesquery.ptovta; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.ptovta IS 'Punto de venta declarado. Hasta 5 dígitos';


--
-- Name: COLUMN vw_comprobantesquery.cuit; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.cuit IS 'Código Único de Identificación Tributaria; 11 dígitos sin espacios ni guiones';


--
-- Name: COLUMN vw_comprobantesquery.cbtetipo; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.cbtetipo IS 'Tipo de comprobante. Hasta 3 dígitos';


--
-- Name: COLUMN vw_comprobantesquery.concepto; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.concepto IS 'Concepto del Comprobante. 
Valores permitidos: 
1=Productos 
2=Servicios 
3=Productos y Servicios';


--
-- Name: COLUMN vw_comprobantesquery.doctipo; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.doctipo IS 'Código de documento identificatorio del comprador';


--
-- Name: COLUMN vw_comprobantesquery.docnro; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.docnro IS 'Nro. de identificación del comprador';


--
-- Name: COLUMN vw_comprobantesquery.monid; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.monid IS 'Código de moneda del comprobante. Consultar método FEParamGetTiposMonedas para valores posibles';


--
-- Name: COLUMN vw_comprobantesquery.moncotiz; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.moncotiz IS 'Cotización de la moneda informada. Para PES, pesos argentinos la misma debe ser 1';


--
-- Name: COLUMN vw_comprobantesquery.resultado; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.resultado IS 'Resultado de la solicitud de autorización de un comprobante 
"A" = aprobado; "P" = pendiente; "R" = rechazado; "S": simulación;
"T" = error técnico (2022-06-23)';


--
-- Name: COLUMN vw_comprobantesquery.codautorizacion; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.codautorizacion IS 'Código de autorización otorgado por AFIP (CAE)';


--
-- Name: COLUMN vw_comprobantesquery.hashlink; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.hashlink IS 'Código pseudo-aleatorio para la identificación segura de comprobantes generados. 
Sólo letras "A" a "Z" y dígitos "0" a "9". 20 caracteres.';


--
-- Name: COLUMN vw_comprobantesquery.reporttemplate; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.reporttemplate IS 'Nombre del archivo (relativo o absoluto) .JASPER correspondiente al reporte.
Acepta variables de sistema (@FRAMEWORKDIR, @YEAR, etc.)';


--
-- Name: COLUMN vw_comprobantesquery.estadopdf; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.estadopdf IS 'Estado de la generación del PDF:
- "P": pendiente
- "G": generado
- "S": suspendido
- "E": error';


--
-- Name: COLUMN vw_comprobantesquery.idlotefacturacion; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.idlotefacturacion IS 'Código de lote de facturación que agrupa varios comprobantes a facturar';


--
-- Name: COLUMN vw_comprobantesquery.codactividad; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.codactividad IS 'Código de actividad del contribuyente. Se pueden consultar invocando el WS "FEParamGetActividades"';


--
-- Name: COLUMN vw_comprobantesquery.codcondiva; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.codcondiva IS 'Código de condición de IVA del receptor';


--
-- Name: COLUMN vw_comprobantesquery.observaciones; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_comprobantesquery.observaciones IS 'Observaciones obtenidas desde AFIP';


--
-- Name: vw_rp_comprobante; Type: VIEW; Schema: facele; Owner: sa
--

CREATE VIEW facele.vw_rp_comprobante AS
 SELECT comp.iddocumentofe,
    comp.idptovta,
    comp.cbtetipo,
    comp.cbtedesde,
    comp.cbtehasta,
    comp.concepto,
    comp.doctipo,
    comp.docnro,
    comp.cbtefch,
    comp.imptotal,
    comp.imptotconc,
    comp.impneto,
    comp.impopex,
    comp.imptrib,
    comp.impiva,
    comp.fchservdesde,
    comp.fchservhasta,
    comp.fchvtopago,
    comp.monid,
    comp.moncotiz,
    comp.resultado,
    comp.codautorizacion,
    comp.caefchvto,
    comp.hashlink,
    comp.barcode,
    comp.razonsocial,
    comp.domicilio1,
    comp.domicilio2,
    comp.lineacab1,
    comp.lineacab2,
    comp.lineacab3,
    comp.lineacab4,
    comp.lineacab5,
    comp.lineacab6,
    comp.lineacab7,
    comp.lineacab8,
    comp.lineacab9,
    comp.lineacab10,
    comp.lineacab11,
    comp.lineacab12,
    comp.lineacab13,
    comp.lineacab14,
    comp.lineacab15,
    comp.lineacab16,
    comp.lineacab17,
    comp.lineacab18,
    comp.lineacab19,
    comp.lineacab20,
    comp.fchproceso,
    comp.pdffilename,
    cu.cuit,
    cu.descripcion,
    pv.lineacomprobante1,
    pv.lineacomprobante2,
    pv.lineacomprobante3,
    pv.lineacomprobante4,
    pv.lineacomprobante5,
    pv.lineacomprobante6,
    pv.lineacomprobante7,
    pv.lineacomprobante8,
    pv.lineacomprobante9,
    pv.lineacomprobante10,
    pv.ptovta,
    ct.letrafiscal,
    ct.sintetico,
    dt.descripcion AS doctipodescripcion,
    mc.modelo,
    mc.copia,
    mc.observaciones AS observacionescopia,
    (
        CASE
            WHEN (((ct.letrafiscal)::bpchar = 'A'::bpchar) AND ((comp.lineacab1)::text ~~* '%MONOTRIBUTO'::text)) THEN 'EL CRÉDITO FISCAL DISCRIMINADO EN EL PRESENTE COMPROBANTE SOLO PODRÁ SER COMPUTADO A EFECTOS DEL PROCEDIMIENTO PERMANENTE DE TRANSICIÓN AL RÉGIMEN GENERAL - CAPÍTULO IV DE LA LEY Nº27618.'::text
            ELSE NULL::text
        END)::facele.observaciones AS msgerrs,
    comp.codcondiva,
    upper((ivas.descripcion)::text) AS ivacliente,
    comp.obscomerciales,
    comp.montoescrito,
    mon.simbolomoneda
   FROM ((((((facele.t_fecomprobantes comp
     JOIN facele.t_feptosvta pv USING (idptovta))
     JOIN facele.t_fecuits cu USING (cuit))
     JOIN facele.t_fecbtetipos ct USING (cbtetipo))
     JOIN facele.t_fedoctipos dt USING (doctipo))
     JOIN facele.t_monedas mon USING (monid))
     JOIN facele.t_fecondivareceptores ivas USING (codcondiva)),
    facele.t_modelocopias mc;


ALTER VIEW facele.vw_rp_comprobante OWNER TO sa;

--
-- Name: VIEW vw_rp_comprobante; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON VIEW facele.vw_rp_comprobante IS 'Relación de base para la cabecera de los reportes de comprobantes';


--
-- Name: COLUMN vw_rp_comprobante.iddocumentofe; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.iddocumentofe IS 'Código interno de comprobante';


--
-- Name: COLUMN vw_rp_comprobante.idptovta; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.idptovta IS 'Código interno vde un punto de venta declarado';


--
-- Name: COLUMN vw_rp_comprobante.cbtetipo; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.cbtetipo IS 'Tipo de comprobante. Hasta 3 dígitos';


--
-- Name: COLUMN vw_rp_comprobante.concepto; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.concepto IS 'Concepto del Comprobante. 
Valores permitidos: 
1=Productos 
2=Servicios 
3=Productos y Servicios';


--
-- Name: COLUMN vw_rp_comprobante.doctipo; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.doctipo IS 'Código de documento identificatorio del comprador';


--
-- Name: COLUMN vw_rp_comprobante.docnro; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.docnro IS 'Nro. de identificación del comprador';


--
-- Name: COLUMN vw_rp_comprobante.monid; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.monid IS 'Código de moneda del comprobante. Consultar método FEParamGetTiposMonedas para valores posibles';


--
-- Name: COLUMN vw_rp_comprobante.moncotiz; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.moncotiz IS 'Cotización de la moneda informada. Para PES, pesos argentinos la misma debe ser 1';


--
-- Name: COLUMN vw_rp_comprobante.resultado; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.resultado IS 'Resultado de la solicitud de autorización de un comprobante 
"A" = aprobado; "P" = pendiente; "R" = rechazado; "S": simulación;
"T" = error técnico (2022-06-23)';


--
-- Name: COLUMN vw_rp_comprobante.codautorizacion; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.codautorizacion IS 'Código de autorización otorgado por AFIP (CAE)';


--
-- Name: COLUMN vw_rp_comprobante.hashlink; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.hashlink IS 'Código pseudo-aleatorio para la identificación segura de comprobantes generados. 
Sólo letras "A" a "Z" y dígitos "0" a "9". 20 caracteres.';


--
-- Name: COLUMN vw_rp_comprobante.cuit; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.cuit IS 'Código Único de Identificación Tributaria; 11 dígitos sin espacios ni guiones';


--
-- Name: COLUMN vw_rp_comprobante.descripcion; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.descripcion IS 'Descripción';


--
-- Name: COLUMN vw_rp_comprobante.ptovta; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.ptovta IS 'Punto de venta declarado. Hasta 5 dígitos';


--
-- Name: COLUMN vw_rp_comprobante.letrafiscal; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.letrafiscal IS 'Letra fiscal de un comprobante: 
"A", "B", "C", "M", "R", "E", "X"';


--
-- Name: COLUMN vw_rp_comprobante.codcondiva; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.codcondiva IS 'Código de condición de IVA del receptor';


--
-- Name: COLUMN vw_rp_comprobante.simbolomoneda; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobante.simbolomoneda IS 'Símbolo de la moneda ($, U$S, etc.)';


--
-- Name: vw_rp_comprobanteqr; Type: VIEW; Schema: facele; Owner: sa
--

CREATE VIEW facele.vw_rp_comprobanteqr AS
 SELECT fecom.iddocumentofe,
    (json_build_object('ver', 1, 'fecha', fecom.cbtefch, 'cuit', pv.cuit, 'ptoVta', pv.ptovta, 'tipoCmp', fecom.cbtetipo, 'nroCmp', fecom.cbtedesde, 'importe', fecom.imptotal, 'moneda', fecom.monid, 'ctz', fecom.moncotiz, 'tipoDocRec', fecom.doctipo, 'nroDocRec', fecom.docnro, 'tipoCodAut', 'E', 'codAut', fecom.codautorizacion))::facele.qr AS textoqr1
   FROM (facele.t_fecomprobantes fecom
     JOIN facele.t_feptosvta pv USING (idptovta));


ALTER VIEW facele.vw_rp_comprobanteqr OWNER TO sa;

--
-- Name: VIEW vw_rp_comprobanteqr; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON VIEW facele.vw_rp_comprobanteqr IS 'Generador de la leyenda requerida por AFIP para los códigos QR';


--
-- Name: COLUMN vw_rp_comprobanteqr.iddocumentofe; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobanteqr.iddocumentofe IS 'Código interno de comprobante';


--
-- Name: vw_rp_comprobanteqr_b64; Type: VIEW; Schema: facele; Owner: sa
--

CREATE VIEW facele.vw_rp_comprobanteqr_b64 AS
 SELECT iddocumentofe,
    textoqr1,
    (('https://www.afip.gob.ar/fe/qr/?p='::text || encode((textoqr1)::bytea, 'base64'::text)))::facele.qr AS textoqr2
   FROM facele.vw_rp_comprobanteqr;


ALTER VIEW facele.vw_rp_comprobanteqr_b64 OWNER TO sa;

--
-- Name: COLUMN vw_rp_comprobanteqr_b64.iddocumentofe; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.vw_rp_comprobanteqr_b64.iddocumentofe IS 'Código interno de comprobante';


--
-- Name: foo; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.foo AS
 SELECT fecom.iddocumentofe,
    fecom.idptovta,
    pv.ptovta,
    pv.cuit,
    fecom.cbtetipo,
    fecom.cbtedesde,
    fecom.cbtehasta,
    fecom.concepto,
    fecom.doctipo,
    fecom.docnro,
    fecom.cbtefch,
    fecom.imptotal,
    fecom.imptotconc,
    fecom.impneto,
    fecom.imptrib,
    fecom.impiva,
    fecom.fchservdesde,
    fecom.fchservhasta,
    fecom.fchvtopago,
    fecom.monid,
    fecom.moncotiz,
    fecom.resultado,
    fecom.codautorizacion,
    fecom.caefchvto,
    fecom.hashlink,
    fecom.codeerrs,
    fecom.reporttemplate,
    fecom.razonsocial,
    fecom.domicilio1,
    fecom.domicilio2,
