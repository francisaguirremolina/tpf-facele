--
-- Name: spc_montoescrito_str99(facele.sqlint); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spc_montoescrito_str99(p_valor facele.sqlint) RETURNS text
    LANGUAGE plpgsql
    AS $$
/***************************************************************
Función:             montoescrito_str99(p_valor): text 
Nombre público:      
Autores:             G. Sbrugnera
Inicio:               2025-10-21 12:17:51.385137
Última modificación:  2025-10-21 12:35:17.557849
Descripción:         
Responsabilidades:   
Precondiciones:      
Valor devuelto:      
Excepciones propias: 
Parámetros:
	p_valor (IN, facele.SqlInt: integer)		
****************************************************************/
BEGIN
	-- Control de parámetros de entrada
	
--BODY--DELIMITER--
DECLARE
	l_toReturn	TEXT;
	l_unidades	INT;

BEGIN
	IF p_valor = 0 THEN
		RETURN '';
	END IF;

	IF p_valor <= 30 THEN
		RETURN facele.spc_MontoEscrito_tblUnidades(p_valor);
	END IF;
	l_toReturn := facele.spc_MontoEscrito_tblDecenas(p_valor / 10);
	l_unidades := p_valor % 10;
	IF l_unidades > 0 THEN
		l_toReturn := l_toReturn || ' y ' || facele.spc_MontoEscrito_tblUnidades(l_unidades);
	END IF;
	RETURN l_toReturn;
END
--BODY--DELIMITER--
;
END
$$;


ALTER FUNCTION facele.spc_montoescrito_str99(p_valor facele.sqlint) OWNER TO sa;

--
-- Name: spc_montoescrito_str999(facele.sqlint); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spc_montoescrito_str999(p_valor facele.sqlint) RETURNS text
    LANGUAGE plpgsql
    AS $$
/***************************************************************
Función:             montoescrito_str999(p_valor): text 
Nombre público:      
Autores:             G. Sbrugnera
Inicio:               2025-10-21 12:17:52.027987
Última modificación:  2025-10-21 12:35:17.554889
Descripción:         
Responsabilidades:   
Precondiciones:      
Valor devuelto:      
Excepciones propias: 
Parámetros:
	p_valor (IN, facele.SqlInt: integer)		
****************************************************************/
BEGIN
	-- Control de parámetros de entrada
	
--BODY--DELIMITER--
BEGIN
        IF p_valor = 100 THEN
            return 'cien';
        END IF;
        
        IF p_valor < 100 THEN
            RETURN facele.spc_MontoEscrito_str99(p_valor % 100);
        END IF;
        
        RETURN facele.spc_MontoEscrito_tblCientos(p_valor / 100) || ' ' ||
        	facele.spc_MontoEscrito_str99(p_valor % 100);

END
--BODY--DELIMITER--
;
END
$$;


ALTER FUNCTION facele.spc_montoescrito_str999(p_valor facele.sqlint) OWNER TO sa;

