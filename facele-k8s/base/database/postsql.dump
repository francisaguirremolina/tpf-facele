        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'FchDesde=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.FchHasta IS DISTINCT FROM l_FchHasta THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'FchHasta = ' || COALESCE(quote_literal(l_FchHasta), 'NULL') ;
