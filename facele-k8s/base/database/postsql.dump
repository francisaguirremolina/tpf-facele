--
-- Name: pg_current_setting_or_null(text); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.pg_current_setting_or_null(p_setting_name text) RETURNS text
    LANGUAGE plpgsql
    AS $$
DECLARE
    l_version   INTEGER;
    
BEGIN
    l_version := current_setting('server_version_num')::INTEGER;
    IF l_version >= 90600 THEN
        RETURN current_setting(p_setting_name, true);
    ELSE
        DECLARE
        BEGIN
        
            RETURN current_setting(p_setting_name);
            
        EXCEPTION WHEN undefined_object THEN
        
            RETURN NULL;
            
        END;
    END IF;
END;
$$;


ALTER FUNCTION public.pg_current_setting_or_null(p_setting_name text) OWNER TO sa;

--
-- Name: pg_dropuserforeignkey(character varying); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.pg_dropuserforeignkey(p_namepattern character varying) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_rec RECORD;
	l_ddl TEXT;
BEGIN
	FOR l_rec IN 
		SELECT constraint_name, fullname FROM pg_userforeignkey WHERE constraint_name ILIKE p_NamePattern 
		LOOP

		BEGIN

			l_ddl := 'ALTER TABLE ' || l_rec.fullname || ' DROP CONSTRAINT ' || l_rec.constraint_name;

			RAISE INFO '%', l_ddl;

			EXECUTE (l_ddl);

		EXCEPTION WHEN OTHERS THEN
			-- Nada.
			RAISE INFO '     ** no eliminado ***';
		END;

	END LOOP;
END;
$$;


ALTER FUNCTION public.pg_dropuserforeignkey(p_namepattern character varying) OWNER TO sa;

--
-- Name: pg_dropuserfunctions(character varying); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.pg_dropuserfunctions(p_namepattern character varying) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_rec RECORD;
	l_ddl TEXT;
BEGIN
	FOR l_rec IN 
		SELECT Declaration FROM pg_userfunctions WHERE FullName ILIKE p_NamePattern 
		LOOP

		l_ddl := 'DROP FUNCTION ' || l_rec.Declaration || ' CASCADE';

		RAISE INFO '%', l_ddl;

		EXECUTE (l_ddl);

	END LOOP;
END;
$$;


ALTER FUNCTION public.pg_dropuserfunctions(p_namepattern character varying) OWNER TO sa;

--
-- Name: pg_dropuserindexes(character varying); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.pg_dropuserindexes(p_namepattern character varying) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_rec RECORD;
	l_ddl TEXT;
	l_errorMsg TEXT;

BEGIN
	FOR l_rec IN 
		SELECT fullname FROM pg_userindexes WHERE fullname ILIKE p_NamePattern 
		LOOP

		BEGIN

			l_ddl := 'DROP INDEX ' || l_rec.fullname;

			RAISE INFO '%', l_ddl;

			EXECUTE (l_ddl);

		EXCEPTION WHEN OTHERS THEN

			GET STACKED DIAGNOSTICS l_errorMsg = MESSAGE_TEXT;

			RAISE INFO 'Indice no eliminado: fullname=% msg=%', l_rec.fullname, l_errorMsg;
		END;

	END LOOP;
END;
$$;


ALTER FUNCTION public.pg_dropuserindexes(p_namepattern character varying) OWNER TO sa;

--
-- Name: pg_dropuserpks(character varying); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.pg_dropuserpks(p_namepattern character varying) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_rec RECORD;
	l_ddl TEXT;
	l_errorMsg TEXT;

BEGIN
	FOR l_rec IN 
		SELECT constraint_schema, constraint_name, table_schema, table_name, fullname FROM pg_userpks WHERE fullname ILIKE p_NamePattern 
		LOOP

		BEGIN

			l_ddl := 'ALTER TABLE ' || l_rec.fullname || ' DROP CONSTRAINT IF EXISTS ' || l_rec.constraint_name;

			RAISE INFO '%', l_ddl;

			EXECUTE (l_ddl);

		EXCEPTION WHEN OTHERS THEN

			GET STACKED DIAGNOSTICS l_errorMsg = MESSAGE_TEXT;

			RAISE INFO 'PK no eliminada: fullname=% msg=%', l_rec.fullname, l_errorMsg;
		END;

	END LOOP;
END;
$$;


ALTER FUNCTION public.pg_dropuserpks(p_namepattern character varying) OWNER TO sa;

