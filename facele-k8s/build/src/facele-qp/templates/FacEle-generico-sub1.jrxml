<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FacEle-generico-sub1" pageWidth="504" pageHeight="360" columnWidth="504" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="bd90b99c-76af-48c8-9e3e-c640c7061a2c">
	<property name="ireport.zoom" value="3.0789487093842545"/>
	<property name="ireport.x" value="494"/>
	<property name="ireport.y" value="0"/>
	<parameter name="IdDocumentoFE" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["204"]]></defaultValueExpression>
	</parameter>
	<parameter name="LineCount" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[10]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT det.*,
'' AS Unidad,
(det.Cantidad * det.PrecioUnitario * det.Bonificacion / 100.0)::Facele.Monto AS Descuento
FROM facele.t_FEComprobantesDet det
WHERE det.IdDocumentoFE::TEXT=$P{IdDocumentoFE}
ORDER BY 1]]>
	</queryString>
	<field name="idcomprobantedet" class="java.lang.Integer">
		<fieldDescription><![CDATA[Código de detalle de comprobante]]></fieldDescription>
	</field>
	<field name="iddocumentofe" class="java.lang.Integer">
		<fieldDescription><![CDATA[Código interno de comprobante]]></fieldDescription>
	</field>
	<field name="cantidad" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[Cantidad del producto del renglón]]></fieldDescription>
	</field>
	<field name="descripcion" class="java.lang.String">
		<fieldDescription><![CDATA[Descripción]]></fieldDescription>
	</field>
	<field name="preciounitario" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[En comprobantes A o M, es el precio unitario neto (sin IVA)
En comprobantes B o C, es el precio unitario final (con IVA)

En todos los casos, este precio no incluye aún el descuento por bonificación.]]></fieldDescription>
	</field>
	<field name="valor1" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[Valor genérico 1 del renglón.
Predeterminado para discriminar el IVA del producto.
En los comprobantes A, valor de la alícuota de IVA
(por ejemplo, "21").
En los comprobantes B o C, es NULL.]]></fieldDescription>
	</field>
	<field name="valor2" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[Valor genérico 2 del renglón.]]></fieldDescription>
	</field>
	<field name="subtotal" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[Depende funcionalmente de:
 Cantidad * PrecioUnitario - dto. bonif.]]></fieldDescription>
	</field>
	<field name="lineadet1" class="java.lang.String"/>
	<field name="lineadet2" class="java.lang.String"/>
	<field name="codigoproducto" class="java.lang.String">
		<fieldDescription><![CDATA[Código del producto, según el fabricante, el proveedor o la empresa.]]></fieldDescription>
	</field>
	<field name="bonificacion" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[Porcentaje de bonificación del renglón, en la escala 0-100.
Si es NULL, no hay bonificación.]]></fieldDescription>
	</field>
	<field name="unidad" class="java.lang.String"/>
	<field name="descuento" class="java.math.BigDecimal"/>
	<variable name="subtotal_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
