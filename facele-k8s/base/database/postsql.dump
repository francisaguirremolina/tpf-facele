BEGIN 
     -- Asignación de variables -------------------------
    l_CodCondIva := p_CodCondIva;
    l_CmpClase := p_CmpClase;
    l_Descripcion := p_Descripcion;
    ---------------------------------------------------
    -- No PRE-INSERT
    
    l_dmlString := 'INSERT INTO facele.t_CondIvaReceptores (CodCondIva,CmpClase,Descripcion)';
    l_dmlString := l_dmlString || ' VALUES (' 
         || COALESCE(quote_literal(l_CodCondIva), 'NULL') 
        || ','  || COALESCE(quote_literal(l_CmpClase), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Descripcion), 'NULL') 
 || ')';    
    
    EXECUTE l_dmlString;

    -- SYNCMODE=$table.getUDP("SYNCMODE")

    -- No POST-INSERT
     
    RETURN   ;
    
-- Manejo de errores
EXCEPTION
 
    WHEN  OTHERS THEN 
 
    RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_CondIvaReceptores', 'insertar', 
                         ' Cód. condic. IVA=' || l_CodCondIva::TEXT);
            
END;
$_$;


