        || ','  || COALESCE(quote_literal(l_Valor2), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Subtotal), 'NULL') 
        || ','  || COALESCE(quote_literal(l_LineaDet1), 'NULL') 
        || ','  || COALESCE(quote_literal(l_LineaDet2), 'NULL') 
        || ','  || COALESCE(quote_literal(l_CodigoProducto), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Bonificacion), 'NULL') 
        || ','  || COALESCE(quote_literal(l_IdFEXUnidadMedida), 'NULL') 
 || ')';    
    
    EXECUTE l_dmlString;

    -- SYNCMODE=$table.getUDP("SYNCMODE")

    -- No POST-INSERT
     
    RETURN   l_IdComprobanteDet  ;
    
-- Manejo de errores
EXCEPTION
 
    WHEN  OTHERS THEN 
 
    RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_FEComprobantesDet', 'insertar', 
                         ' Cód. detalle=' || l_IdComprobanteDet::TEXT);
            
END;
