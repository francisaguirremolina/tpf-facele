--
-- Name: spc_completayvalidacomp(facele.iddocumentofe); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spc_completayvalidacomp(p_iddocumentofe facele.iddocumentofe) RETURNS void
    LANGUAGE plpgsql
    AS $$
/***************************************************************
Función:             CompletaYValidaComp(p_IdDocumentoFE): VOID 
Nombre público:      
Autores:             G. Sbrugnera
Inicio:              2025-09-08 00:00:00 2025-09-08 21:09:57.356691
Última modificación:  2025-10-20 11:02:47.892746
Descripción:         Completa y valida un comprobante: su cabecera y todos sus registros asociados.
Responsabilidades:   Valida y completa la cabecera del comprobante y todos sus registros asociados.
Precondiciones:      
Valor devuelto:      Nada.
Excepciones propias: No produce excepciones. 
Si encuentra un error de validación, pasa el estado del comprobante a "R" y escribe en MsgErrs, los motivos
Parámetros:
	p_IdDocumentoFE (IN, facele.IdDocumentoFE: INT)		
****************************************************************/
BEGIN
	-- Control de parámetros de entrada
	IF p_IdDocumentoFE IS NULL THEN
		RAISE EXCEPTION '{Debe proveerse un valor para el parámetro p_IdDocumentoFE de la función CompletaYValidaComp}';
	END IF;
--BODY--DELIMITER--
DECLARE
    l_rec       facele.t_FEComprobantes;
    l_pv        facele.t_FEPtosVta;
    l_cbte      facele.t_FECbteTipos;
    l_copias    facele.t_ModeloCopias;
    l_det       facele.t_FEComprobantesDet;
    l_iva       facele.t_FEComprobantesIva;
    l_trib      facele.t_FEComprobantesTrib;
    l_alic      facele.t_FEIVATipos;
    
    l_subtotalDet   facele.Monto;
    l_subtotalBaseImp   facele.Monto;
    l_subtotalIva   facele.Monto;
    l_subtotalTrib  facele.Monto;
    l_valorOpc  facele.Descripcion;
    
BEGIN

    SELECT * INTO l_rec FROM facele.t_FEComprobantes
        WHERE IdDocumentoFE = p_IdDocumentoFE;
                
    l_rec.CodeErrs := NULL;
    l_rec.MsgErrs := NULL;
                
    IF l_rec.Resultado <> 'P' THEN
        l_rec.Resultado := 'R';
        l_rec.CodeErrs := 'V001';
        l_rec.MsgErrs := 'VAL001: El estado debe ser "P"';
        PERFORM facele.spur_FEComprobantes(l_rec);
        RETURN;
    END IF;
    
    l_rec.Resultado := 'R';

    IF l_rec.CodAutorizacion IS NOT NULL THEN
        l_rec.CodeErrs := 'V002';
        l_rec.MsgErrs := 'VAL002: El comprobante ya tiene cód. autoriz.';
        PERFORM facele.spur_FEComprobantes(l_rec);
        RETURN;
    END IF;

    l_rec.CbteDesde := NULL;
    l_rec.CbteHasta := NULL;
    
    IF l_rec.DocTipo = 99 THEN
    
        l_rec.DocNro := 0;
        
    ELSE
    
        IF l_rec.DocNro = 0 THEN
        
            l_rec.CodeErrs := 'V003';
            l_rec.MsgErrs := 'VAL003: Debe indicarse el número de documento para el tipo ' || l_rec.DocNro;
            PERFORM facele.spur_FEComprobantes(l_rec);
            RETURN;
            
        END IF;
        
    END IF;
        
    SELECT * INTO l_cbte FROM facele.t_FECbteTipos
        WHERE CbteTipo = l_rec.CbteTipo;

    IF l_cbte.LetraFiscal IS NULL THEN
        l_rec.CodeErrs := 'V023';
        l_rec.MsgErrs := 'VAL023: No se especificó la letra fiscal para el tipo de comprobante ' || l_rec.CbteTipo;
        PERFORM facele.spur_FEComprobantes(l_rec);
        RETURN;
        
    END IF;
    
    -- Moneda y cotización
    IF l_rec.MonId = 'PES' THEN
        l_rec.MonCotiz := 1.00;
    END IF;
           
    -- Importes recibidos desde la importación
    IF l_cbte.LetraFiscal = 'C' THEN
    
        IF l_rec.ImpTotConc <> 0.00 THEN
            l_rec.CodeErrs := 'V020';
            l_rec.MsgErrs := 'VAL020: En comprobantes C, ImpTotConc debe ser cero';
            PERFORM facele.spur_FEComprobantes(l_rec);
            RETURN;
        END IF;

        IF l_rec.ImpOpEx <> 0.00 THEN
            l_rec.CodeErrs := 'V021';
            l_rec.MsgErrs := 'VAL021: En comprobantes C, ImpOpEx debe ser cero';
            PERFORM facele.spur_FEComprobantes(l_rec);
            RETURN;
        END IF;
                
    END IF;
                   
    -- Plantilla de reporte
    
    IF l_cbte.ReportTemplate IS NULL THEN
    
        l_cbte.ReportTemplate := l_cbte.ReportTemplate;
        
        IF l_cbte.ReportTemplate IS NULL THEN
            l_rec.CodeErrs := 'V008';
            l_rec.MsgErrs := 'VAL008: no se especificó la plantilla del reporte';
            PERFORM facele.spur_FEComprobantes(l_rec);
            RETURN;
        END IF;
        
    END IF;

    -- Razón social
    IF l_rec.DocTipo <> 99 THEN
        IF l_rec.RazonSocial IS NULL THEN
            l_rec.CodeErrs := 'V009';
            l_rec.MsgErrs := 'VAL009: debe indicarse la razón social para el tipo de documento ' + l_rec.DocTipo;
            PERFORM facele.spur_FEComprobantes(l_rec);
            RETURN;
        END IF;
    END IF;
    
    -- Modelo de copias
            
    IF l_rec.ModeloCopias IS NULL THEN
    
        SELECT * INTO l_copias FROM facele.t_ModeloCopias
            WHERE Predeterminado = 1 LIMIT 1;
                
        IF NOT FOUND THEN
            l_rec.CodeErrs := 'V010';
            l_rec.MsgErrs := 'VAL010: no se indicó un modelo de copias predeterminado';
            PERFORM facele.spur_FEComprobantes(l_rec);
            RETURN;
        END IF;
    ELSE
        SELECT * INTO l_copias FROM facele.t_ModeloCopias
            WHERE Modelo = l_rec.ModeloCopias LIMIT 1;
            
        IF NOT FOUND THEN
            l_rec.CodeErrs := 'V011';
            l_rec.MsgErrs := 'VAL011: modelo de copias desconocido: ' || l_rec.ModeloCopias;
            PERFORM facele.spur_FEComprobantes(l_rec);
            RETURN;
        END IF;
                    
    END IF;

    -- Código de actividad
    SELECT * INTO l_pv FROM facele.t_FEPtosVta
        WHERE IdPtoVta = l_rec.IdPtoVta;
        
    IF l_rec.CodActividad IS NULL THEN
        l_rec.CodActividad := l_pv.CodActividad;
        IF l_rec.CodActividad IS NULL THEN
            l_rec.CodeErrs := 'V012';
            l_rec.MsgErrs := 'VAL012: no se indicó la actividad predeterminada para el cód. PV ' || l_rec.IdPtoVta;
            PERFORM facele.spur_FEComprobantes(l_rec);
            RETURN;
        END IF;
    END IF;

    -- Condición de IVA
    IF l_rec.CodCondIva IS NULL THEN
        l_rec.CodeErrs := 'V013';
        l_rec.MsgErrs := 'VAL013: no se indicó la condición de IVA del receptor del comprobante';
        PERFORM facele.spur_FEComprobantes(l_rec);
        RETURN;
    END IF;
    
    -- Restricciones para comprobantes nacionales y de exportación

    IF l_cbte.UsoNacional = 1 THEN
    
        IF l_rec.PermisoExistente IS NOT NULL OR l_rec.IdFEXDstPais IS NOT NULL
            OR l_rec.IdFEXDstCuit IS NOT NULL OR l_rec.CanMisMonExt IS NOT NULL
            OR l_rec.IdFEXIdioma IS NOT NULL OR l_rec.IdFEXIncoterm IS NOT NULL
            OR l_rec.IncotermsDesc IS NOT NULL THEN
            
            l_rec.CodeErrs := 'V014';
            l_rec.MsgErrs := 'VAL014: en un comprobante nacional, los siguientes campos NO deben indicarse: ' ||
            'PermisoExistente / IdFEXDstPais / IdFEXDstCuit / CanMisMonExt / IdFEXIdioma / IdFEXIncoterm / IncotermsDesc';
        
            PERFORM facele.spur_FEComprobantes(l_rec);
            RETURN;

        END IF;
          
        -- Períodos de servicio
        IF l_rec.Concepto = 1 THEN -- Productos
            IF l_rec.FchServDesde IS NOT NULL OR l_rec.FchServHasta IS NOT NULL 
                OR l_rec.FchVtoPago IS NOT NULL THEN
                l_rec.CodeErrs := 'V006';
                l_rec.MsgErrs := 'VAL006: En comprobantes de bienes (1), no deben indicarse las fechas de servicio ni el vto. de pago';
                
                PERFORM facele.spur_FEComprobantes(l_rec);
                RETURN;
            END IF;
        ELSE
            IF l_rec.FchServDesde IS NULL OR l_rec.FchServHasta IS NULL 
                OR l_rec.FchVtoPago IS NULL THEN
                l_rec.CodeErrs := 'V007';
                l_rec.MsgErrs := 'VAL007: En comprobantes de servicios (2 o 3), deben indicarse las fechas de servicio y vto. de pago';
                PERFORM facele.spur_FEComprobantes(l_rec);
                RETURN;
            END IF;
        END IF;
           
        IF l_rec.Concepto = 1 THEN -- Productos
            IF (l_rec.CbteFch < CURRENT_DATE - 5) OR (l_rec.CbteFch > CURRENT_DATE + 5) THEN
                l_rec.CodeErrs := 'V004';
                l_rec.MsgErrs := 'VAL004: Fecha vencida (concepto=PRODUCTO) ' || l_rec.CbteFch;
                PERFORM facele.spur_FEComprobantes(l_rec);
                RETURN;
            END IF;
        ELSE
            -- 2 servicios, 3 productos y servicios
            IF (l_rec.CbteFch < CURRENT_DATE - 10) OR (l_rec.CbteFch > CURRENT_DATE + 10) THEN
                l_rec.CodeErrs := 'V005';
                l_rec.MsgErrs := 'VAL005: Fecha vencida (concepto=SERVICIO) ' || l_rec.CbteFch;
                PERFORM facele.spur_FEComprobantes(l_rec);
                RETURN;
            END IF;
        END IF;
                 
    ELSEIF l_cbte.UsoExportac = 1 THEN
    
        IF l_rec.IdFEXDstPais IS NULL THEN
            
            l_rec.CodeErrs := 'V015';
            l_rec.MsgErrs := 'VAL015: en un comprobante de exportación debe indicarse IdFEXDstPais';
        
            PERFORM facele.spur_FEComprobantes(l_rec);
            RETURN;

        END IF;

        IF l_rec.IdFEXDstCuit IS NULL THEN
        
            l_rec.IdFEXDstCuit := l_rec.DocNro;
            
        END IF;
        
        IF l_rec.IdFEXIdioma IS NULL THEN
            l_rec.IdFEXIdioma := 1; -- español
        END IF;
        
        IF l_rec.CanMisMonExt IS NULL THEN
        
            l_rec.CanMisMonExt := 'S';
            
        ELSE
            IF  l_rec.CanMisMonExt NOT IN ('S', 'N') THEN

                l_rec.CodeErrs := 'V016';
                l_rec.MsgErrs := 'VAL016: CanMisMonExt solo acepta "S" / "N" ';
                PERFORM facele.spur_FEComprobantes(l_rec);
                RETURN;
                        
            END IF;
            
        END IF;

        IF l_rec.PermisoExistente IS NULL THEN
        
            l_rec.PermisoExistente := 'N';
            
        ELSE
            IF  l_rec.PermisoExistente NOT IN ('S', 'N') THEN

                l_rec.CodeErrs := 'V017';
                l_rec.MsgErrs := 'VAL017: PermisoExistente solo acepta "S" / "N" ';
                PERFORM facele.spur_FEComprobantes(l_rec);
                RETURN;
                        
            END IF;
            
        END IF;
              
        IF (l_rec.CbteFch < CURRENT_DATE - 5) OR (l_rec.CbteFch > CURRENT_DATE + 5) THEN
            l_rec.CodeErrs := 'V018';
            l_rec.MsgErrs := 'VAL018: Fecha fuera de rango(exportación) ' || l_rec.CbteFch;
            PERFORM facele.spur_FEComprobantes(l_rec);
            RETURN;
        END IF;
                  
    END IF;

    -- Detalles del comprobante
    
    l_subtotalDet := 0.00;
    
    FOR l_det IN SELECT * FROM facele.t_FEComprobantesDet
        WHERE IdDocumentoFE = p_IdDocumentoFE LOOP
        
        IF l_cbte.LetraFiscal = 'A' THEN
        
            IF l_det.Valor1 IS NULL THEN
            
                l_rec.CodeErrs := 'V024';
                l_rec.MsgErrs := 'VAL024: En comprobantes A, el campo "Valor1" del detalle debe contener la alícuota de IVA del renglón';
                PERFORM facele.spur_FEComprobantes(l_rec);
                
            RETURN;
            
            END IF;
            
        END IF;
        
        l_det.Cantidad := COALESCE(l_det.Cantidad, 1.0);
        
        l_det.Subtotal := l_det.Cantidad * l_det.PrecioUnitario * (1.0 - COALESCE(l_det.Bonificacion, 0.0));

        l_subtotalDet := l_subtotalDet + l_det.Subtotal;
        
        PERFORM facele.spur_FEComprobantesDet(l_det);
        
    END LOOP;                
               
    IF l_subtotalDet = 0.00 THEN
        l_rec.CodeErrs := 'V019';
        l_rec.MsgErrs := 'VAL019: el comprobante debe tener uno o más detalles';
        PERFORM facele.spur_FEComprobantes(l_rec);
        RETURN;
    END IF;

    -- Alícuotas de IVA
    l_subtotalIVA := 0.00;
    l_subtotalBaseImp := 0.00;
    
    FOR l_iva IN SELECT * FROM facele.t_FEComprobantesIva
        WHERE IdDocumentoFE = p_IdDocumentoFE LOOP

        SELECT * INTO l_alic FROM facele.t_FEIVATipos
            WHERE CodAlicIVA = l_iva.CodAlicIVA;
                
        l_iva.Importe := l_iva.BaseImp * l_alic.Alicuota / 100.0;
    
        l_subtotalIVA := l_subtotalIVA + l_iva.Importe;
        l_subtotalBaseImp := l_subtotalBaseImp + l_iva.BaseImp;
            
        PERFORM facele.spur_FEComprobantesIva(l_iva);

    END LOOP;

    -- Datos opcionales
    IF l_rec.CbteTipo IN (201, 202, 203, 206, 207, 208, 211, 212, 213) THEN
        -- Comprobantes MiPYME:
        -- Agrega CBU
        l_valorOpc := (SELECT Valor FROM facele.t_FEComprobantesOpc
            WHERE IdDocumentoFE = p_IdDocumentoFE AND CodOpcional = '2101'); -- CBU emisor

        IF l_valorOpc IS NULL THEN
            -- No se indicó el CBU. Intenta desde el CUIT
            l_valorOpc := (SELECT CBU FROM facele.t_FECuits
                WHERE Cuit = l_pv.Cuit);
            
            IF l_valorOpc IS NULL THEN
                l_rec.CodeErrs := 'V022';
                l_rec.MsgErrs := 'VAL022: no se indicó el CBU del emisor, requerido en MIPYME';
                PERFORM facele.spur_FEComprobantes(l_rec);
                RETURN;
            END IF;
            
            -- Agrega
            PERFORM facele.spi_FEComprobantesOpc(p_IdDocumentoFE, '2101', l_valorOpc);
            
        END IF;
        
    END IF;
    
    -- Otros tributos
    l_subtotalTrib := 0.00;
    
    FOR l_trib IN SELECT * FROM facele.t_FEComprobantesTrib
        WHERE IdDocumentoFE = p_IdDocumentoFE LOOP
        
        l_trib.Importe := l_trib.BaseImp * l_trib.Alic / 100.00;
        
        l_subtotalTrib := l_subtotalTrib + l_trib.Importe;
        
        PERFORM facele.t_FEComprobantesTrib(l_trib);
        
    END LOOP;

    IF l_cbte.LetraFiscal = 'C' THEN
    
        l_rec.ImpNeto := l_subtotalDet;
        l_rec.ImpIVA := 0.00; -- innecesario; solo para aclarar
        
    ELSE
        l_rec.ImpNeto := l_subtotalBaseImp;
        l_rec.ImpIVA := l_subtotalIVA;
        
    END IF;
    l_rec.ImpTrib := l_subtotalTrib;
    l_rec.ImpTotal := l_rec.ImpTotConc + l_rec.ImpOpEx + l_rec.ImpNeto + l_rec.ImpIVA + l_rec.ImpTrib;   
        
    -- Registro aceptado. Lo vuelve a "pendiente"
    l_rec.Resultado := 'P';
    
    l_rec.MontoEscrito := facele.spc_MontoEscrito((l_rec.ImpTotal * 100)::facele.SqlBigInt);
    
    PERFORM facele.spur_FEComprobantes(l_rec);
                                
END
--BODY--DELIMITER--
;
END
$$;


ALTER FUNCTION facele.spc_completayvalidacomp(p_iddocumentofe facele.iddocumentofe) OWNER TO sa;

--
-- Name: spc_comprobanteasjson(facele.iddocumentofe); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spc_comprobanteasjson(p_iddocumentofe facele.iddocumentofe) RETURNS facele.sqltext
    LANGUAGE plpgsql
    AS $$
/***************************************************************
Función:             ComprobanteAsJSON(p_IdDocumentoFE): facele.SqlText 
Nombre público:      
Autores:             G. Sbrugnera
Inicio:               2025-08-28 21:26:02.749758
Última modificación:  2025-08-28 23:43:40.308524
Descripción:         Convierte un comprobante a su representación JSON
Responsabilidades:   
Precondiciones:      
Valor devuelto:      String JSON del comprobante
Excepciones propias: 
Parámetros:
	p_IdDocumentoFE (IN, facele.IdDocumentoFE: INT)		
****************************************************************/
BEGIN
	-- Control de parámetros de entrada
	IF p_IdDocumentoFE IS NULL THEN
		RAISE EXCEPTION '{Debe proveerse un valor para el parámetro p_IdDocumentoFE de la función ComprobanteAsJSON}';
	END IF;
--BODY--DELIMITER--
DECLARE
    -- l_recFEComprobantes     facele.t_FEComprobantes;
    l_recFEComprobantes     RECORD;
    l_toReturnC             facele.SqlText;
    l_toReturnD             JSONB; -- detalles
    l_toReturnI             JSONB; -- iva
    l_toReturnO             JSONB; -- opcionales
    l_toReturnA             JSONB; -- asociados
    l_toReturnT             JSONB; -- tributos
    l_toReturnP             JSONB; -- permisos
    
    
BEGIN

    -- detalles
    l_toReturnD := JSON_AGG(ROW_TO_JSON(det))        
        FROM (SELECT 
            d.Cantidad,
            d.Descripcion,
            d.PrecioUnitario AS "precioUnitario",
            d.Valor1,
            d.Valor2,
            d.Subtotal,
            d.LineaDet1 AS "lineaDet1",
            d.LineaDet2 AS "lineaDet2",
            d.CodigoProducto AS "codigoProducto",
            d.Bonificacion,
            d.IdFEXUnidadMedida AS "idFEXUnidadMedida"
        FROM facele.t_FEComprobantesDet d
        WHERE d.IdDocumentoFE = p_IdDocumentoFE) det;

    -- iva
    l_toReturnI := JSON_AGG(ROW_TO_JSON(iva))        
        FROM (SELECT 
        i.CodAlicIVA AS "codAlicIVA",
        i.BaseImp AS "baseImp",
        i.Importe
        FROM facele.t_FEComprobantesIva i
        WHERE i.IdDocumentoFE = p_IdDocumentoFE) iva;
              
    -- opcionales                                  
    l_toReturnO := JSON_AGG(ROW_TO_JSON(opc))        
        FROM (SELECT 
        o.CodOpcional AS "codOpcional",
        o.Valor
        FROM facele.t_FEComprobantesOpc o
        WHERE o.IdDocumentoFE = p_IdDocumentoFE) opc;

    -- asociados
    l_toReturnA := JSON_AGG(ROW_TO_JSON(asoc))        
        FROM (SELECT 
        a.PtoVta AS "ptoVta",
        a.CbteTipo AS "cbteTipo",
        a.CbteNumero AS "cbteNumero",
        a.CbteCuit AS "cbteCuit"
        FROM facele.t_FEComprobantesAsoc a
        WHERE a.IdDocumentoFE = p_IdDocumentoFE) asoc;

    -- tributos
    l_toReturnT := JSON_AGG(ROW_TO_JSON(trib))        
        FROM (SELECT
        t.CodTributo AS "codTributo",
        t.Descripcion,
        t.BaseImp AS "baseImp",
        t.Alic,
        t.Importe 
        FROM facele.t_FEComprobantesTrib t
        WHERE t.IdDocumentoFE = p_IdDocumentoFE) trib;

    -- permisos
    l_toReturnP := JSON_AGG(ROW_TO_JSON(perm))        
        FROM (SELECT
        p.CodDespacho AS "codDespacho",
        p.IdFEXDstPais AS "idFEXDstPais" 
        FROM facele.t_FEXPermisos p
        WHERE p.IdDocumentoFE = p_IdDocumentoFE) perm;

    -- Cabecera
    SELECT 
        c.IdDocumentoFE AS "idDocumentoFE",
        c.IdPtoVta AS "idPtoVta",
        c.CbteTipo AS "cbteTipo",
        c.CbteDesde AS "cbteDesde",
        c.CbteHasta AS "cbteHasta",
        c.Concepto AS "concepto",
        c.DocTipo AS "docTipo",
        c.DocNro AS "docNro",
        to_char(c.CbteFch, 'yyyy-MM-dd HH24:MI:SS') AS "cbteFch",
        c.ImpTotal AS "impTotal",
        c.ImpTotConc AS "impTotConc",
        c.ImpNeto AS "impNeto",
        c.ImpOpEx AS "impOpEx",
        c.ImpTrib AS "impTrib",
        c.ImpIVA AS "impIVA",
        to_char(c.FchServDesde, 'yyyy-MM-dd HH24:MI:SS') AS "fchServDesde",
        to_char(c.FchServHasta, 'yyyy-MM-dd HH24:MI:SS') AS "fchServHasta",
        to_char(c.FchVtoPago, 'yyyy-MM-dd HH24:MI:SS') AS "fchVtoPago",
        c.MonId AS "monId",
        c.MonCotiz AS "monCotiz",
        c.Resultado AS "resultado",
        c.CodAutorizacion AS "codAutorizacion",
        to_char(c.CAEFchVto, 'yyyy-MM-dd HH24:MI:SS') AS "caeFchVto",
        c.HashLink AS "hashLink",
        c.CodeErrs AS "codeErrs",
        c.MsgErrs AS "msgErrs",
        c.ReportTemplate AS "reportTemplate",
        c.BarCode AS "barCode",
        c.RazonSocial AS "razonSocial",
        c.Domicilio1 AS "domicilio1",
        c.Domicilio2 AS "domicilio2",
        c.LineaCab1 AS "lineaCab1",
        c.LineaCab2 AS "lineaCab2",
        c.LineaCab3 AS "lineaCab3",
        c.LineaCab4 AS "lineaCab4",
        c.LineaCab5 AS "lineaCab5",
        c.LineaCab6 AS "lineaCab6",
        c.LineaCab7 AS "lineaCab7",
        c.LineaCab8 AS "lineaCab8",
        c.LineaCab9 AS "lineaCab9",
        c.LineaCab10 AS "lineaCab10",
        c.LineaCab11 AS "lineaCab11",
        c.LineaCab12 AS "lineaCab12",
        c.LineaCab13 AS "lineaCab13",
        c.LineaCab14 AS "lineaCab14",
        c.LineaCab15 AS "lineaCab15",
        c.LineaCab16 AS "lineaCab16",
        c.LineaCab17 AS "lineaCab17",
        c.LineaCab18 AS "lineaCab18",
        c.LineaCab19 AS "lineaCab19",
        c.LineaCab20 AS "lineaCab20",
        to_char(c.FchProceso, 'yyyy-MM-dd HH24:MI:SS') AS "fchProceso",
        c.PDFFileName AS "pdfFileName",
        c.ModeloCopias AS "modeloCopias",
        c.EstadoPDF AS "estadoPDF",
        c.IdLoteFacturacion AS "idLoteFacturacion",
        c.CodActividad AS "codActividad",
        c.CodCondIva AS "codCondIva",
        c.PermisoExistente AS "permisoExistente",
        c.IdFEXDstPais AS "destinoCmp",
        c.IdFEXDstCuit AS "cuitPaisCliente",
        c.CanMisMonExt AS "canMisMonExt",
        c.ObsComerciales AS "obsComerciales",
        c.Observaciones AS "observaciones",
        c.FormaPago AS "formaPago",
        c.IdFEXIdioma AS "idiomaCbte",
        c.IdFEXIncoterm AS "incoterms",
        c.IncotermsDesc AS "incotermsDesc",
        l_toReturnD AS "comprobantesDet",
        l_toReturnI AS "comprobantesIva",
        l_toReturnO AS "comprobantesOpc",
        l_toReturnT AS "comprobantesTrib",
        l_toReturnA AS "comprobantesAsoc",
        l_toReturnP AS "comprobantesPermisos"
        
        INTO l_recFEComprobantes
        FROM facele.t_FEComprobantes c
        WHERE c.IdDocumentoFE = p_IdDocumentoFE;
        
    l_toReturnC := ROW_TO_JSON(l_recFEComprobantes, true);
    
    RAISE INFO '%', l_toReturnC;
    
    RETURN l_toReturnC;
    
END
--BODY--DELIMITER--
;
END
$$;


ALTER FUNCTION facele.spc_comprobanteasjson(p_iddocumentofe facele.iddocumentofe) OWNER TO sa;

--
-- Name: spc_comprobanteasjsoninsert(facele.iddocumentofe); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spc_comprobanteasjsoninsert(p_iddocumentofe facele.iddocumentofe) RETURNS facele.sqltext
    LANGUAGE plpgsql
    AS $$
/***************************************************************
Función:             ComprobanteAsJSONInsert(p_IdDocumentoFE): facele.SqlText 
Nombre público:      
Autores:             G. Sbrugnera
Inicio:               2025-08-28 23:50:43.273471
Última modificación:  2025-08-28 23:54:31.369832
Descripción:         Convierte un comprobante a su representación JSON para ser insertado desde un lote
Responsabilidades:   
Precondiciones:      
Valor devuelto:      String JSON del comprobante
Excepciones propias: 
Parámetros:
	p_IdDocumentoFE (IN, facele.IdDocumentoFE: INT)		
****************************************************************/
BEGIN
	-- Control de parámetros de entrada
	IF p_IdDocumentoFE IS NULL THEN
		RAISE EXCEPTION '{Debe proveerse un valor para el parámetro p_IdDocumentoFE de la función ComprobanteAsJSONInsert}';
	END IF;
--BODY--DELIMITER--
DECLARE
    -- l_recFEComprobantes     facele.t_FEComprobantes;
    l_recFEComprobantes     RECORD;
    l_toReturnC             facele.SqlText;
    l_toReturnD             JSONB; -- detalles
    l_toReturnI             JSONB; -- iva
    l_toReturnO             JSONB; -- opcionales
    l_toReturnA             JSONB; -- asociados
    l_toReturnT             JSONB; -- tributos
    l_toReturnP             JSONB; -- permisos
    
    
BEGIN

    -- detalles
    l_toReturnD := JSON_AGG(ROW_TO_JSON(det))        
        FROM (SELECT 
            d.Cantidad,
            d.Descripcion,
            d.PrecioUnitario AS "precioUnitario",
            d.Valor1,
            d.Valor2,
            d.Subtotal,
            d.LineaDet1 AS "lineaDet1",
            d.LineaDet2 AS "lineaDet2",
            d.CodigoProducto AS "codigoProducto",
            d.Bonificacion,
            d.IdFEXUnidadMedida AS "idFEXUnidadMedida"
        FROM facele.t_FEComprobantesDet d
        WHERE d.IdDocumentoFE = p_IdDocumentoFE) det;

    -- iva
    l_toReturnI := JSON_AGG(ROW_TO_JSON(iva))        
        FROM (SELECT 
        i.CodAlicIVA AS "codAlicIVA",
        i.BaseImp AS "baseImp",
        i.Importe
        FROM facele.t_FEComprobantesIva i
        WHERE i.IdDocumentoFE = p_IdDocumentoFE) iva;
              
    -- opcionales                                  
    l_toReturnO := JSON_AGG(ROW_TO_JSON(opc))        
        FROM (SELECT 
        o.CodOpcional AS "codOpcional",
        o.Valor
        FROM facele.t_FEComprobantesOpc o
        WHERE o.IdDocumentoFE = p_IdDocumentoFE) opc;

    -- asociados
    l_toReturnA := JSON_AGG(ROW_TO_JSON(asoc))        
        FROM (SELECT 
        a.PtoVta AS "ptoVta",
        a.CbteTipo AS "cbteTipo",
        a.CbteNumero AS "cbteNumero",
        a.CbteCuit AS "cbteCuit"
        FROM facele.t_FEComprobantesAsoc a
        WHERE a.IdDocumentoFE = p_IdDocumentoFE) asoc;

    -- tributos
    l_toReturnT := JSON_AGG(ROW_TO_JSON(trib))        
        FROM (SELECT
        t.CodTributo AS "codTributo",
        t.Descripcion,
        t.BaseImp AS "baseImp",
        t.Alic,
        t.Importe 
        FROM facele.t_FEComprobantesTrib t
        WHERE t.IdDocumentoFE = p_IdDocumentoFE) trib;

    -- permisos
    l_toReturnP := JSON_AGG(ROW_TO_JSON(perm))        
        FROM (SELECT
        p.CodDespacho AS "codDespacho",
        p.IdFEXDstPais AS "idFEXDstPais" 
        FROM facele.t_FEXPermisos p
        WHERE p.IdDocumentoFE = p_IdDocumentoFE) perm;

    -- Cabecera
    SELECT 
        c.IdDocumentoFE AS "idDocumentoFE",
        c.IdPtoVta AS "idPtoVta",
        c.CbteTipo AS "cbteTipo",
        -- c.CbteDesde AS "cbteDesde",
        -- c.CbteHasta AS "cbteHasta",
        c.Concepto AS "concepto",
        c.DocTipo AS "docTipo",
        c.DocNro AS "docNro",
        to_char(c.CbteFch, 'yyyy-MM-dd HH24:MI:SS') AS "cbteFch",
        -- c.ImpTotal AS "impTotal",
        c.ImpTotConc AS "impTotConc",
        c.ImpNeto AS "impNeto",
        c.ImpOpEx AS "impOpEx",
        c.ImpTrib AS "impTrib",
        c.ImpIVA AS "impIVA",
        to_char(c.FchServDesde, 'yyyy-MM-dd HH24:MI:SS') AS "fchServDesde",
        to_char(c.FchServHasta, 'yyyy-MM-dd HH24:MI:SS') AS "fchServHasta",
        to_char(c.FchVtoPago, 'yyyy-MM-dd HH24:MI:SS') AS "fchVtoPago",
        c.MonId AS "monId",
        c.MonCotiz AS "monCotiz",
        c.Resultado AS "resultado",
        --c.CodAutorizacion AS "codAutorizacion",
        --to_char(c.CAEFchVto, 'yyyy-MM-dd HH24:MI:SS') AS "caeFchVto",
        --c.HashLink AS "hashLink",
        --c.CodeErrs AS "codeErrs",
        --c.MsgErrs AS "msgErrs",
        c.ReportTemplate AS "reportTemplate",
        --c.BarCode AS "barCode",
        c.RazonSocial AS "razonSocial",
        c.Domicilio1 AS "domicilio1",
        c.Domicilio2 AS "domicilio2",
        c.LineaCab1 AS "lineaCab1",
        c.LineaCab2 AS "lineaCab2",
        c.LineaCab3 AS "lineaCab3",
        c.LineaCab4 AS "lineaCab4",
        c.LineaCab5 AS "lineaCab5",
        c.LineaCab6 AS "lineaCab6",
        c.LineaCab7 AS "lineaCab7",
        c.LineaCab8 AS "lineaCab8",
        c.LineaCab9 AS "lineaCab9",
        c.LineaCab10 AS "lineaCab10",
        c.LineaCab11 AS "lineaCab11",
        c.LineaCab12 AS "lineaCab12",
        c.LineaCab13 AS "lineaCab13",
        c.LineaCab14 AS "lineaCab14",
        c.LineaCab15 AS "lineaCab15",
        c.LineaCab16 AS "lineaCab16",
        c.LineaCab17 AS "lineaCab17",
        c.LineaCab18 AS "lineaCab18",
        c.LineaCab19 AS "lineaCab19",
        c.LineaCab20 AS "lineaCab20",
        --to_char(c.FchProceso, 'yyyy-MM-dd HH24:MI:SS') AS "fchProceso",
        --c.PDFFileName AS "pdfFileName",
        c.ModeloCopias AS "modeloCopias",
        c.EstadoPDF AS "estadoPDF",
        c.IdLoteFacturacion AS "idLoteFacturacion",
        c.CodActividad AS "codActividad",
        c.CodCondIva AS "codCondIva",
        c.PermisoExistente AS "permisoExistente",
        c.IdFEXDstPais AS "destinoCmp",
        c.IdFEXDstCuit AS "cuitPaisCliente",
        c.CanMisMonExt AS "canMisMonExt",
        c.ObsComerciales AS "obsComerciales",
        c.Observaciones AS "observaciones",
        c.FormaPago AS "formaPago",
        c.IdFEXIdioma AS "idiomaCbte",
        c.IdFEXIncoterm AS "incoterms",
        c.IncotermsDesc AS "incotermsDesc",
        l_toReturnD AS "comprobantesDet",
        l_toReturnI AS "comprobantesIva",
        l_toReturnO AS "comprobantesOpc",
        l_toReturnT AS "comprobantesTrib",
        l_toReturnA AS "comprobantesAsoc",
        l_toReturnP AS "comprobantesPermisos"
        
        INTO l_recFEComprobantes
        FROM facele.t_FEComprobantes c
        WHERE c.IdDocumentoFE = p_IdDocumentoFE;
        
    l_toReturnC := ROW_TO_JSON(l_recFEComprobantes, true);
    
    RAISE INFO '%', l_toReturnC;
    
    RETURN l_toReturnC;
    
END
--BODY--DELIMITER--
;
END
$$;


