--
-- Name: t_fecomprobantesopc; Type: TABLE; Schema: facele; Owner: sa
--

CREATE TABLE facele.t_fecomprobantesopc (
    idcomprobopc facele.idcomprobopc NOT NULL,
    iddocumentofe facele.iddocumentofe NOT NULL,
    codopcional facele.codopcional NOT NULL,
    valor facele.descripcion NOT NULL
);


ALTER TABLE facele.t_fecomprobantesopc OWNER TO sa;

--
-- Name: TABLE t_fecomprobantesopc; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON TABLE facele.t_fecomprobantesopc IS 'CRDETR un concepto opcional declarado en un comprobante electrónico. 
Los datos opcionales sólo deberán ser incluidos si el emisor pertenece al conjunto de emisores habilitados a informar opcionales. En ese caso podrá incluir el o los datos opcionales que correspondan, especificando el identificador de dato opcional de acuerdo a la situación del emisor.
Un registro de concepto opcional ES-PARTE-DE un comprobante electrónico.';


--
-- Name: COLUMN t_fecomprobantesopc.idcomprobopc; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesopc.idcomprobopc IS 'Código interno de concepto opcional';


--
-- Name: COLUMN t_fecomprobantesopc.iddocumentofe; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesopc.iddocumentofe IS 'Código interno de comprobante';


--
-- Name: COLUMN t_fecomprobantesopc.codopcional; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesopc.codopcional IS 'Código de concepto opcional informado (según el método FEParamGetTiposOpcional)';


--
-- Name: COLUMN t_fecomprobantesopc.valor; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecomprobantesopc.valor IS 'Valor del atributo';


--
-- Name: spar_fecomprobantesopc(facele.t_fecomprobantesopc); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spar_fecomprobantesopc(p_rec facele.t_fecomprobantesopc) RETURNS facele.idcomprobopc
    LANGUAGE plpgsql
    AS $$
BEGIN
    /* Función de agregado de registros en la tabla facele.t_FEComprobantesOpc
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
    RETURN facele.spa_FEComprobantesOpc (
                 p_rec.IdComprobOpc, 
                 p_rec.IdDocumentoFE, 
                 p_rec.CodOpcional, 
                 p_rec.Valor
    );
END;
$$;


ALTER FUNCTION facele.spar_fecomprobantesopc(p_rec facele.t_fecomprobantesopc) OWNER TO sa;

