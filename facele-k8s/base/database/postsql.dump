-- Name: spar_fecomprobantesiva(facele.t_fecomprobantesiva); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spar_fecomprobantesiva(p_rec facele.t_fecomprobantesiva) RETURNS facele.idcomprobiva
    LANGUAGE plpgsql
    AS $$
BEGIN
    /* Función de agregado de registros en la tabla facele.t_FEComprobantesIva
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
    RETURN facele.spa_FEComprobantesIva (
                 p_rec.IdComprobIVA, 
                 p_rec.IdDocumentoFE, 
                 p_rec.CodAlicIVA, 
                 p_rec.BaseImp, 
                 p_rec.Importe
    );
END;
$$;


