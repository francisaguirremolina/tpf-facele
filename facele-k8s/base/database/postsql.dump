--
-- Name: spar_fedoctipos(facele.t_fedoctipos); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spar_fedoctipos(p_rec facele.t_fedoctipos) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
BEGIN
    /* Función de agregado de registros en la tabla facele.t_FEDocTipos
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
    RETURN facele.spa_FEDocTipos (
                 p_rec.DocTipo, 
                 p_rec.Descripcion, 
                 p_rec.FchDesde, 
                 p_rec.FchHasta
    );
END;
$$;


