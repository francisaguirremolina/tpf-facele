    LANGUAGE plpgsql
    AS $_$
DECLARE
    l_errorMsg      TEXT;
    l_dmlString     TEXT;
    l_pkString      TEXT;
    
    l_CbteTipo     facele.CbteTipo;
    l_Descripcion     facele.Descripcion;
    l_FchDesde     facele.Fecha;
    l_FchHasta     facele.Fecha;
    l_LetraFiscal     facele.LetraFiscal;
    l_Sintetico     facele.Descripcion;
    l_ReportTemplate     facele.ReportTemplate;
    l_CbteFam     facele.CbteFam;
    l_UsoNacional     facele.UsoNacional;
    l_UsoExportac     facele.UsoExportac;

BEGIN 
     -- Asignación de variables -------------------------
    l_CbteTipo := p_CbteTipo;
    l_Descripcion := p_Descripcion;
    l_FchDesde := p_FchDesde;
    l_FchHasta := p_FchHasta;
    l_LetraFiscal := p_LetraFiscal;
    l_Sintetico := p_Sintetico;
    l_ReportTemplate := p_ReportTemplate;
    l_CbteFam := p_CbteFam;
    l_UsoNacional := p_UsoNacional;
    l_UsoExportac := p_UsoExportac;
    ---------------------------------------------------
    -- No PRE-INSERT
    
    l_dmlString := 'INSERT INTO facele.t_FECbteTipos (CbteTipo,Descripcion,FchDesde,FchHasta,LetraFiscal,Sintetico,ReportTemplate,CbteFam,UsoNacional,UsoExportac)';
    l_dmlString := l_dmlString || ' VALUES (' 
         || COALESCE(quote_literal(l_CbteTipo), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Descripcion), 'NULL') 
        || ','  || COALESCE(quote_literal(l_FchDesde), 'NULL') 
        || ','  || COALESCE(quote_literal(l_FchHasta), 'NULL') 
        || ','  || COALESCE(quote_literal(l_LetraFiscal), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Sintetico), 'NULL') 
        || ','  || COALESCE(quote_literal(l_ReportTemplate), 'NULL') 
        || ','  || COALESCE(quote_literal(l_CbteFam), 'NULL') 
        || ','  || COALESCE(quote_literal(l_UsoNacional), 'NULL') 
        || ','  || COALESCE(quote_literal(l_UsoExportac), 'NULL') 
 || ')';    
    
    EXECUTE l_dmlString;

    -- SYNCMODE=$table.getUDP("SYNCMODE")

    -- No POST-INSERT
     
    RETURN   ;
    
-- Manejo de errores
EXCEPTION
 
    WHEN  OTHERS THEN 
 
    RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_FECbteTipos', 'insertar', 
                         ' Tipo comprob.=' || l_CbteTipo::TEXT);
            
END;
$_$;


