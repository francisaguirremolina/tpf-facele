    LANGUAGE plpgsql
    AS $$
DECLARE
	l_errorMsg         TEXT;
	l_fieldList        TEXT;
	l_fieldNameList    TEXT;
	l_pkParams         TEXT;
    l_NoTempModFields  INT;
    l_dmlString        TEXT;
    l_pkString         TEXT;
