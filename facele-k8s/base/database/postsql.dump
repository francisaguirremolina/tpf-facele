		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.MensajeACola IS DISTINCT FROM l_MensajeACola THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'MensajeACola = ' || COALESCE(quote_literal(l_MensajeACola), 'NULL') ;
