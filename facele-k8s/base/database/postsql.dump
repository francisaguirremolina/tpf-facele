		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.FchDesde IS DISTINCT FROM l_FchDesde THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'FchDesde = ' || COALESCE(quote_literal(l_FchDesde), 'NULL') ;
        IF l_FchDesde IS NOT NULL THEN
            IF LENGTH(l_FchDesde::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_FchDesde::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_FchDesde::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'FchDesde=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.FchHasta IS DISTINCT FROM l_FchHasta THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'FchHasta = ' || COALESCE(quote_literal(l_FchHasta), 'NULL') ;
        IF l_FchHasta IS NOT NULL THEN
            IF LENGTH(l_FchHasta::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_FchHasta::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_FchHasta::TEXT;
