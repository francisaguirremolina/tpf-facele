	<property name="dbname" value="tpf"/>
	<parameter name="IdDocumentoFE" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["204"]]></defaultValueExpression>
	</parameter>
	<parameter name="Modelo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["4. DOS COPIAS"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT comp.*,
b64.TextoQR1,
b64.TextoQR2,
(SELECT COUNT(*) AS LineCount FROM facele.t_FEComprobantesDet
	WHERE comp.IdDocumentoFE=$P{IdDocumentoFE}::INT),
LPAD(cbtetipo::varchar, 3, '0') AS cbtetipo_str,
LPAD(ptovta::varchar, 5, '0') AS ptovta_str,
LPAD(cbtedesde::varchar, 8, '0') AS cbtedesde_str
FROM facele.vw_rp_Comprobante comp
LEFT OUTER JOIN facele.vw_rp_ComprobanteQR_b64 b64 USING (IdDocumentoFE)
WHERE comp.IdDocumentoFE::TEXT=$P{IdDocumentoFE}
AND comp.Modelo=$P{Modelo}]]>
	</queryString>
	<field name="iddocumentofe" class="java.lang.Integer">
		<fieldDescription><![CDATA[Código interno de comprobante]]></fieldDescription>
	</field>
	<field name="idptovta" class="java.lang.Integer">
		<fieldDescription><![CDATA[Código interno vde un punto de venta declarado]]></fieldDescription>
	</field>
	<field name="cbtetipo" class="java.lang.Integer">
