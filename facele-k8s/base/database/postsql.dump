-- Name: DOMAIN simbolomoneda; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON DOMAIN facele.simbolomoneda IS 'Símbolo de la moneda ($, U$S, etc.)';


--
-- Name: sino; Type: DOMAIN; Schema: facele; Owner: sa
--

CREATE DOMAIN facele.sino AS character(1);


ALTER DOMAIN facele.sino OWNER TO sa;

--
-- Name: DOMAIN sino; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON DOMAIN facele.sino IS '"S": sí; "N": no';


--
-- Name: sqlbigint; Type: DOMAIN; Schema: facele; Owner: sa
--

CREATE DOMAIN facele.sqlbigint AS bigint;


ALTER DOMAIN facele.sqlbigint OWNER TO sa;

--
-- Name: DOMAIN sqlbigint; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON DOMAIN facele.sqlbigint IS 'Entero con signo, de 64 bits.';


--
-- Name: sqlboolean; Type: DOMAIN; Schema: facele; Owner: sa
--

CREATE DOMAIN facele.sqlboolean AS integer
	CONSTRAINT sqlboolean_max CHECK ((VALUE <= 1))
	CONSTRAINT sqlboolean_min CHECK ((VALUE >= 0));


ALTER DOMAIN facele.sqlboolean OWNER TO sa;

--
-- Name: DOMAIN sqlboolean; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON DOMAIN facele.sqlboolean IS 'Sí / no';


--
-- Name: sqlint; Type: DOMAIN; Schema: facele; Owner: sa
--

CREATE DOMAIN facele.sqlint AS integer;


ALTER DOMAIN facele.sqlint OWNER TO sa;

--
-- Name: DOMAIN sqlint; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON DOMAIN facele.sqlint IS 'Entero con signo, de 32 bits.';


--
-- Name: sqltext; Type: DOMAIN; Schema: facele; Owner: sa
--

CREATE DOMAIN facele.sqltext AS text;


ALTER DOMAIN facele.sqltext OWNER TO sa;

--
-- Name: DOMAIN sqltext; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON DOMAIN facele.sqltext IS 'Texto largo';


--
-- Name: tipocola; Type: DOMAIN; Schema: facele; Owner: sa
--

CREATE DOMAIN facele.tipocola AS character varying(2);


ALTER DOMAIN facele.tipocola OWNER TO sa;

--
-- Name: DOMAIN tipocola; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON DOMAIN facele.tipocola IS 'Tipo de cola: "QW" o "QP"';


--
-- Name: token; Type: DOMAIN; Schema: facele; Owner: sa
--

CREATE DOMAIN facele.token AS character varying(2000);


ALTER DOMAIN facele.token OWNER TO sa;

--
-- Name: DOMAIN token; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON DOMAIN facele.token IS 'Token otorgado temporalmente por AFIP, para operaciones con web-services';


--
-- Name: usoexportac; Type: DOMAIN; Schema: facele; Owner: sa
--

CREATE DOMAIN facele.usoexportac AS integer;


ALTER DOMAIN facele.usoexportac OWNER TO sa;

--
-- Name: DOMAIN usoexportac; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON DOMAIN facele.usoexportac IS 'UNO cuando es una entidad de referencia para documentos de exportación';


--
-- Name: usonacional; Type: DOMAIN; Schema: facele; Owner: sa
--

CREATE DOMAIN facele.usonacional AS integer;


ALTER DOMAIN facele.usonacional OWNER TO sa;

--
-- Name: DOMAIN usonacional; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON DOMAIN facele.usonacional IS 'UNO cuando es una entidad de referencia para documentos nacionales';


--
-- Name: spa_conceptos(facele.concepto, facele.descripcion, facele.fecha, facele.fecha); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spa_conceptos(p_concepto facele.concepto, p_descripcion facele.descripcion, p_fchdesde facele.fecha, p_fchhasta facele.fecha) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
 BEGIN
    /* Función de agregado de registros en la tabla facele.t_Conceptos
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
	IF facele.spe_Conceptos(p_Concepto) THEN

		-- Ya existe el registro

		RETURN false;

	END IF;

	-- Registro inexistente. Agrega.

         PERFORM facele.spi_Conceptos (
                 p_Concepto, 
                 p_Descripcion, 
                 p_FchDesde, 
                 p_FchHasta
         );

        RETURN true; 
END;
$$;


ALTER FUNCTION facele.spa_conceptos(p_concepto facele.concepto, p_descripcion facele.descripcion, p_fchdesde facele.fecha, p_fchhasta facele.fecha) OWNER TO sa;

