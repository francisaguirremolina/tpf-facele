CREATE FUNCTION facele.spu_ipccolas(p_tipocola facele.tipocola, p_colaactiva facele.sqlboolean, p_mensajeacola facele.observaciones, p_respuestadecola facele.observaciones, p_estadodecola facele.observaciones, p_pk_idipccola facele.idipccola) RETURNS integer
