        || ','  || COALESCE(quote_literal(l_ClavePrivada), 'NULL') 
        || ','  || COALESCE(quote_literal(l_TicketLive), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Vencimiento), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Token), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Sign), 'NULL') 
        || ','  || COALESCE(quote_literal(l_VencCert), 'NULL') 
        || ','  || COALESCE(quote_literal(l_CBU), 'NULL') 
        || ','  || COALESCE(quote_literal(l_VencimientoCDC), 'NULL') 
        || ','  || COALESCE(quote_literal(l_TokenCDC), 'NULL') 
        || ','  || COALESCE(quote_literal(l_SignCDC), 'NULL') 
        || ','  || COALESCE(quote_literal(l_VencimientoFEX), 'NULL') 
        || ','  || COALESCE(quote_literal(l_TokenFEX), 'NULL') 
        || ','  || COALESCE(quote_literal(l_SignFEX), 'NULL') 
 || ')';    
    
