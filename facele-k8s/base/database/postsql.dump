    LANGUAGE plpgsql
    AS $$
BEGIN
    /* Función de agregado de registros en la tabla facele.t_FECotizMonedas
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
    RETURN facele.spa_FECotizMonedas (
                 p_rec.MonId, 
                 p_rec.FechaCotiz, 
                 p_rec.MonCotiz, 
                 p_rec.IdCotizMoneda
    );
END;
$$;


ALTER FUNCTION facele.spar_fecotizmonedas(p_rec facele.t_fecotizmonedas) OWNER TO sa;

--
-- Name: t_fecuits; Type: TABLE; Schema: facele; Owner: sa
--

CREATE TABLE facele.t_fecuits (
    cuit facele.cuit NOT NULL,
    descripcion facele.descripcion NOT NULL,
    certificado facele.certificado,
    claveprivada facele.claveprivada,
    ticketlive facele.segundos,
    vencimiento facele.fechahora,
    token facele.token,
    sign facele.sign,
    venccert facele.fecha,
    cbu facele.cbu,
    vencimientocdc facele.fechahora,
    tokencdc facele.token,
    signcdc facele.sign,
    vencimientofex facele.fechahora,
    tokenfex facele.token,
    signfex facele.sign
);


ALTER TABLE facele.t_fecuits OWNER TO sa;

--
-- Name: TABLE t_fecuits; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON TABLE facele.t_fecuits IS 'CRDETR un contribuyente que emite comprobantes electrónicos. 
También almacena sus claves, certificados y el último ticket obtenido.';


--
-- Name: COLUMN t_fecuits.cuit; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.cuit IS 'Código Único de Identificación Tributaria; 11 dígitos sin espacios ni guiones';


--
-- Name: COLUMN t_fecuits.descripcion; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.descripcion IS 'Razón social del contribuyente, o nombre de fantasía, o alias. Uso interno - no se informa a AFIP';


--
-- Name: COLUMN t_fecuits.certificado; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.certificado IS 'Certificado a utilizar para la obtención de un ticket WSAA / FACELEv1';


--
-- Name: COLUMN t_fecuits.claveprivada; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.claveprivada IS 'Clave privada a utilizar para la obtención de un ticket WSAA / FACELEv1';


--
-- Name: COLUMN t_fecuits.ticketlive; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.ticketlive IS 'Tiempo de vida solicitado para cada nuevo ticket, en segundos. Normalmente 12 horas';


--
-- Name: COLUMN t_fecuits.vencimiento; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.vencimiento IS 'Fecha y hora, según el servidor de AFIP, en que vencerá el ticket.';


--
-- Name: COLUMN t_fecuits.token; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.token IS 'Token recibido desde AFIP.';


--
-- Name: COLUMN t_fecuits.sign; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.sign IS 'Sign recibido desde AFIP.';


--
-- Name: COLUMN t_fecuits.venccert; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.venccert IS 'Fecha de vencimiento del certificado. Se utiliza solo para advertir al operador';


--
-- Name: COLUMN t_fecuits.cbu; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.cbu IS 'CBU. Requerido para emitir Facturas de crédito electrónico MiPYME';


--
-- Name: COLUMN t_fecuits.vencimientocdc; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.vencimientocdc IS 'Fecha y hora, según el servidor de AFIP, en que vencerá el ticket. Solo WSCDC.';


--
-- Name: COLUMN t_fecuits.tokencdc; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.tokencdc IS 'Token recibido desde AFIP. Solo WSCDC.';


--
-- Name: COLUMN t_fecuits.signcdc; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.signcdc IS 'Sign recibido desde AFIP. Solo WSCDC.';


--
-- Name: COLUMN t_fecuits.vencimientofex; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.vencimientofex IS 'Fecha y hora, según el servidor de AFIP, en que vencerá el ticket. Solo WSFEX.';


--
-- Name: COLUMN t_fecuits.tokenfex; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.tokenfex IS 'Token recibido desde AFIP. Solo WSFEX.';


--
-- Name: COLUMN t_fecuits.signfex; Type: COMMENT; Schema: facele; Owner: sa
--

COMMENT ON COLUMN facele.t_fecuits.signfex IS 'Sign recibido desde AFIP. Solo WSFEX.';


--
-- Name: spar_fecuits(facele.t_fecuits); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spar_fecuits(p_rec facele.t_fecuits) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
BEGIN
    /* Función de agregado de registros en la tabla facele.t_FECuits
    Si la tabla tiene una PK IDENTITY: 
                  devuelve NULL si no se agregó un nuevo registro, 
                  o un valor de la PK si se agregó.
    Si la tabla no tiene una PK IDENTITY:
                  devuelve true si se agregó un nuevo registro, o false en caso contrario
    */
    RETURN facele.spa_FECuits (
                 p_rec.Cuit, 
                 p_rec.Descripcion, 
                 p_rec.Certificado, 
                 p_rec.ClavePrivada, 
                 p_rec.TicketLive, 
                 p_rec.Vencimiento, 
                 p_rec.Token, 
                 p_rec.Sign, 
                 p_rec.VencCert, 
                 p_rec.CBU, 
                 p_rec.VencimientoCDC, 
                 p_rec.TokenCDC, 
                 p_rec.SignCDC, 
                 p_rec.VencimientoFEX, 
                 p_rec.TokenFEX, 
                 p_rec.SignFEX
    );
END;
$$;


ALTER FUNCTION facele.spar_fecuits(p_rec facele.t_fecuits) OWNER TO sa;

--
-- Name: t_fedoctipos; Type: TABLE; Schema: facele; Owner: sa
--

CREATE TABLE facele.t_fedoctipos (
    doctipo facele.doctipo NOT NULL,
    descripcion facele.descripcion NOT NULL,
    fchdesde facele.fecha NOT NULL,
    fchhasta facele.fecha,
    CONSTRAINT t_fedoctipos_check CHECK (((fchhasta IS NULL) OR ((fchhasta)::date >= (fchdesde)::date)))
);


