CREATE FUNCTION facele.spi_fecomprobantesdet(p_iddocumentofe facele.iddocumentofe, p_cantidad facele.monto, p_descripcion facele.descripcion, p_preciounitario facele.monto, p_valor1 facele.monto, p_valor2 facele.monto, p_subtotal facele.monto, p_lineadet1 facele.descripcion, p_lineadet2 facele.descripcion, p_codigoproducto facele.codigoproducto, p_bonificacion facele.bonificacion4d, p_idfexunidadmedida facele.idfexunidadmedida) RETURNS facele.idcomprobantedet
    LANGUAGE plpgsql
    AS $_$
DECLARE
    l_errorMsg      TEXT;
    l_dmlString     TEXT;
    l_pkString      TEXT;
    
    l_IdComprobanteDet     facele.IdComprobanteDet;
    l_IdDocumentoFE     facele.IdDocumentoFE;
