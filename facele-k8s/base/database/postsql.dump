--

CREATE FUNCTION facele.spi_fecomprobantesasoc(p_iddocumentofe facele.iddocumentofe, p_ptovta facele.ptovta, p_cbtetipo facele.cbtetipo, p_cbtenumero facele.cbtenumero, p_cbtecuit facele.cuit) RETURNS facele.idcomprobasoc
    LANGUAGE plpgsql
    AS $_$
DECLARE
    l_errorMsg      TEXT;
    l_dmlString     TEXT;
    l_pkString      TEXT;
    
    l_IdComprobAsoc     facele.IdComprobAsoc;
    l_IdDocumentoFE     facele.IdDocumentoFE;
    l_PtoVta     facele.PtoVta;
    l_CbteTipo     facele.CbteTipo;
    l_CbteNumero     facele.CbteNumero;
    l_CbteCuit     facele.Cuit;

BEGIN 
     -- Asignación de variables -------------------------
    l_IdComprobAsoc := nextval('facele.sq_FEComprobantesAsoc_IdComprobAsoc');
    l_IdDocumentoFE := p_IdDocumentoFE;
    l_PtoVta := p_PtoVta;
    l_CbteTipo := p_CbteTipo;
    l_CbteNumero := p_CbteNumero;
    l_CbteCuit := p_CbteCuit;
    ---------------------------------------------------
    -- No PRE-INSERT
    
    l_dmlString := 'INSERT INTO facele.t_FEComprobantesAsoc (IdComprobAsoc,IdDocumentoFE,PtoVta,CbteTipo,CbteNumero,CbteCuit)';
    l_dmlString := l_dmlString || ' VALUES (' 
         || COALESCE(quote_literal(l_IdComprobAsoc), 'NULL') 
        || ','  || COALESCE(quote_literal(l_IdDocumentoFE), 'NULL') 
        || ','  || COALESCE(quote_literal(l_PtoVta), 'NULL') 
        || ','  || COALESCE(quote_literal(l_CbteTipo), 'NULL') 
        || ','  || COALESCE(quote_literal(l_CbteNumero), 'NULL') 
        || ','  || COALESCE(quote_literal(l_CbteCuit), 'NULL') 
 || ')';    
    
    EXECUTE l_dmlString;

    -- SYNCMODE=$table.getUDP("SYNCMODE")

    -- No POST-INSERT
     
    RETURN   l_IdComprobAsoc  ;
    
-- Manejo de errores
EXCEPTION
 
    WHEN  OTHERS THEN 
 
    RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_FEComprobantesAsoc', 'insertar', 
                         ' Cód. comp. asoc.=' || l_IdComprobAsoc::TEXT);
            
END;
$_$;


