--
-- Name: pg_dropuserviews(character varying); Type: FUNCTION; Schema: public; Owner: sa
--

CREATE FUNCTION public.pg_dropuserviews(p_namepattern character varying) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_rec RECORD;
	l_ddl TEXT;
BEGIN
	FOR l_rec IN 
		SELECT view_name FROM pg_userviews WHERE view_name ILIKE p_NamePattern 
		LOOP

		BEGIN

			l_ddl := 'DROP VIEW ' || l_rec.view_name || ' CASCADE';

			RAISE INFO '%', l_ddl;

			EXECUTE (l_ddl);

		EXCEPTION WHEN OTHERS THEN
			-- La vista ya fue borrada en cascada

		END;

	END LOOP;
END;
$$;


