--
-- Name: spi_conceptos(facele.concepto, facele.descripcion, facele.fecha, facele.fecha); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spi_conceptos(p_concepto facele.concepto, p_descripcion facele.descripcion, p_fchdesde facele.fecha, p_fchhasta facele.fecha) RETURNS void
    LANGUAGE plpgsql
    AS $_$
DECLARE
    l_errorMsg      TEXT;
    l_dmlString     TEXT;
    l_pkString      TEXT;
    
    l_Concepto     facele.Concepto;
    l_Descripcion     facele.Descripcion;
    l_FchDesde     facele.Fecha;
    l_FchHasta     facele.Fecha;

BEGIN 
     -- Asignación de variables -------------------------
    l_Concepto := p_Concepto;
    l_Descripcion := p_Descripcion;
    l_FchDesde := p_FchDesde;
    l_FchHasta := p_FchHasta;
    ---------------------------------------------------
    -- No PRE-INSERT
    
    l_dmlString := 'INSERT INTO facele.t_Conceptos (Concepto,Descripcion,FchDesde,FchHasta)';
    l_dmlString := l_dmlString || ' VALUES (' 
         || COALESCE(quote_literal(l_Concepto), 'NULL') 
        || ','  || COALESCE(quote_literal(l_Descripcion), 'NULL') 
        || ','  || COALESCE(quote_literal(l_FchDesde), 'NULL') 
        || ','  || COALESCE(quote_literal(l_FchHasta), 'NULL') 
 || ')';    
    
    EXECUTE l_dmlString;

    -- SYNCMODE=$table.getUDP("SYNCMODE")

    -- No POST-INSERT
     
    RETURN   ;
    
-- Manejo de errores
EXCEPTION
 
    WHEN  OTHERS THEN 
 
    RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_Conceptos', 'insertar', 
                         ' Concepto=' || l_Concepto::TEXT);
            
END;
$_$;


ALTER FUNCTION facele.spi_conceptos(p_concepto facele.concepto, p_descripcion facele.descripcion, p_fchdesde facele.fecha, p_fchhasta facele.fecha) OWNER TO sa;

