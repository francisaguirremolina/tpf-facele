--
-- Name: spc_initschseq_facele_tpf_facele(); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spc_initschseq_facele_tpf_facele() RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_min	int8;
	l_max	int8;
	l_inc	int8;
	l_mod	int8;

BEGIN
	l_min	:= 0;
	l_max	:= 1000000000;
	l_inc	:= 1;
	l_mod	:= 0;
	
	IF EXISTS (SELECT true FROM information_schema.tables 
		WHERE table_schema = 'sync' AND table_name = 't_masterservers' ) THEN

		-- Esquema de replicación implementado

		SELECT MinSequenceValue, MaxSequenceValue, IncSequenceValue, ModSequenceValue
			INTO l_min, l_max, l_inc, l_mod
			FROM sync.t_masterservers 
			WHERE ActiveServer = 1;

        IF NOT FOUND THEN
        
            l_min	:= 0;
	       l_max	:= 1000000000;
	       l_inc	:= 1;
	       l_mod	:= 0;
	
        END IF;
        
	END IF;

	
    PERFORM spc_InitSequence('facele.t_FEXPermisos', 'IdFEXPermiso', 'facele.sq_FEXPermisos_IdFEXPermiso', l_min, l_max, l_inc, l_mod);	
    PERFORM spc_InitSequence('facele.t_IPCColas', 'IdIPCCola', 'facele.sq_IPCColas_IdIPCCola', l_min, l_max, l_inc, l_mod);	
    PERFORM spc_InitSequence('facele.t_FECotizMonedas', 'IdCotizMoneda', 'facele.sq_FECotizMonedas_IdCotizMoneda', l_min, l_max, l_inc, l_mod);	
    PERFORM spc_InitSequence('facele.t_ModeloCopias', 'IdCopia', 'facele.sq_ModeloCopias_IdCopia', l_min, l_max, l_inc, l_mod);	
    PERFORM spc_InitSequence('facele.t_FEPtosVta', 'IdPtoVta', 'facele.sq_FEPtosVta_IdPtoVta', l_min, l_max, l_inc, l_mod);	
    PERFORM spc_InitSequence('facele.t_FEComprobantesAsoc', 'IdComprobAsoc', 'facele.sq_FEComprobantesAsoc_IdComprobAsoc', l_min, l_max, l_inc, l_mod);	
    PERFORM spc_InitSequence('facele.t_FEComprobantesDet', 'IdComprobanteDet', 'facele.sq_FEComprobantesDet_IdComprobanteDet', l_min, l_max, l_inc, l_mod);	
    PERFORM spc_InitSequence('facele.t_FEComprobantesIva', 'IdComprobIVA', 'facele.sq_FEComprobantesIva_IdComprobIVA', l_min, l_max, l_inc, l_mod);	
    PERFORM spc_InitSequence('facele.t_FEComprobantesOpc', 'IdComprobOpc', 'facele.sq_FEComprobantesOpc_IdComprobOpc', l_min, l_max, l_inc, l_mod);	
    PERFORM spc_InitSequence('facele.t_FEComprobantesTrib', 'IdComprobTrib', 'facele.sq_FEComprobantesTrib_IdComprobTrib', l_min, l_max, l_inc, l_mod);
END    
$$;


ALTER FUNCTION facele.spc_initschseq_facele_tpf_facele() OWNER TO sa;

--
-- Name: spc_montoescrito(facele.sqlbigint); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spc_montoescrito(p_centavos facele.sqlbigint) RETURNS character varying
    LANGUAGE plpgsql
    AS $$
/***************************************************************
Función:             montoescrito(p_centavos): character varying 
Nombre público:      
Autores:             G. Sbrugnera
Inicio:               2025-10-21 12:17:42.194061
Última modificación:  2025-10-21 12:35:17.562573
Descripción:         
Responsabilidades:   
Precondiciones:      
Valor devuelto:      
Excepciones propias: 
Parámetros:
	p_centavos (IN, facele.SqlBigInt: bigint)		
****************************************************************/
BEGIN
	-- Control de parámetros de entrada
	
--BODY--DELIMITER--
DECLARE
        l_pesos 	INT8;
        l_centavos 	INT;

BEGIN
        l_pesos := p_centavos / 100;
        l_centavos := p_centavos % 100;
        
        IF (l_pesos > 0) AND (l_centavos > 0) THEN
            RETURN facele.spc_MontoEscrito_strPesos(l_pesos) || ' con ' 
            	|| facele.spc_MontoEscrito_strCentavos(l_centavos);
        END IF;
        
        IF l_pesos > 0 THEN
            RETURN facele.spc_MontoEscrito_strPesos(l_pesos);
        END IF;
        
        IF l_centavos > 0 THEN
            RETURN facele.spc_MontoEscrito_strCentavos(l_centavos);
        END IF;
        
        return '';
END
--BODY--DELIMITER--
;
END
$$;


ALTER FUNCTION facele.spc_montoescrito(p_centavos facele.sqlbigint) OWNER TO sa;

