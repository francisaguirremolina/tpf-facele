   FROM (facele.t_fecomprobantes fecom
     JOIN facele.t_feptosvta pv USING (idptovta));


ALTER VIEW public.foo OWNER TO sa;

--
-- Name: pg_table_usage; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_table_usage AS
 SELECT ctu.table_schema,
    ctu.table_name,
    'table'::character varying(5) AS obj_type,
    tc.table_schema AS obj_schema,
    tc.table_name AS obj_name
   FROM (information_schema.constraint_table_usage ctu
     JOIN information_schema.table_constraints tc USING (constraint_schema, constraint_name))
  WHERE (((tc.constraint_type)::text = 'FOREIGN KEY'::text) AND ((ctu.table_schema)::text <> ALL (ARRAY[('information_schema'::character varying)::text, ('pg_catalog'::character varying)::text, ('pg_toast'::character varying)::text, ('plsh_test'::character varying)::text, ('sqlj'::character varying)::text])) AND ((tc.table_schema)::text <> ALL (ARRAY[('information_schema'::character varying)::text, ('pg_catalog'::character varying)::text, ('pg_toast'::character varying)::text, ('plsh_test'::character varying)::text, ('sqlj'::character varying)::text])));


ALTER VIEW public.pg_table_usage OWNER TO sa;

--
-- Name: pg_view_usage; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_view_usage AS
 SELECT vtu.view_schema,
    vtu.view_name,
        CASE t.table_type
            WHEN 'VIEW'::text THEN 'view'::character varying
            WHEN 'BASE TABLE'::text THEN 'table'::character varying
            ELSE (t.table_type)::character varying
        END AS obj_type,
    vtu.table_schema AS obj_schema,
    vtu.table_name AS obj_name
   FROM (information_schema.view_table_usage vtu
     JOIN information_schema.tables t USING (table_schema, table_name))
  WHERE (((vtu.view_schema)::text <> ALL (ARRAY[('information_schema'::character varying)::text, ('pg_catalog'::character varying)::text, ('pg_toast'::character varying)::text, ('plsh_test'::character varying)::text, ('sqlj'::character varying)::text])) AND ((vtu.table_schema)::text <> ALL (ARRAY[('information_schema'::character varying)::text, ('pg_catalog'::character varying)::text, ('pg_toast'::character varying)::text, ('plsh_test'::character varying)::text, ('sqlj'::character varying)::text])))
UNION
 SELECT vru.table_schema AS view_schema,
    vru.table_name AS view_name,
    'function'::character varying AS obj_type,
    r.routine_schema AS obj_schema,
    r.routine_name AS obj_name
   FROM (information_schema.view_routine_usage vru
     JOIN information_schema.routines r USING (specific_schema, specific_name))
  WHERE ((vru.table_schema)::text <> ALL (ARRAY[('information_schema'::character varying)::text, ('pg_catalog'::character varying)::text, ('pg_toast'::character varying)::text, ('plsh_test'::character varying)::text, ('sqlj'::character varying)::text]));


ALTER VIEW public.pg_view_usage OWNER TO sa;

--
-- Name: pg_object_usage; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_object_usage AS
 SELECT 'table'::character varying AS parent_type,
    tu.table_schema AS parent_schema,
    tu.table_name AS parent_name,
    tu.obj_type,
    tu.obj_schema,
    tu.obj_name
   FROM public.pg_table_usage tu
UNION
 SELECT vu.obj_type AS parent_type,
    vu.obj_schema AS parent_schema,
    vu.obj_name AS parent_name,
    'view'::character varying AS obj_type,
    vu.view_schema AS obj_schema,
    vu.view_name AS obj_name
   FROM public.pg_view_usage vu;


ALTER VIEW public.pg_object_usage OWNER TO sa;

--
-- Name: pg_userfunctions; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_userfunctions AS
 SELECT (((n.nspname)::text || '.'::text) || (p.proname)::text) AS fullname,
    oidvectortypes(p.proargtypes) AS arguments,
    (((((quote_ident((n.nspname)::text) || '.'::text) || quote_ident((p.proname)::text)) || '('::text) || oidvectortypes(p.proargtypes)) || ')'::text) AS declaration
   FROM (pg_proc p
     LEFT JOIN pg_namespace n ON ((n.oid = p.pronamespace)))
  WHERE ((p.prorettype <> ('cstring'::regtype)::oid) AND ((p.proargtypes[0] IS NULL) OR (p.proargtypes[0] <> ('cstring'::regtype)::oid)) AND (n.nspname <> ALL (ARRAY['pg_catalog'::name, 'information_schema'::name, 'sqlj'::name])));


ALTER VIEW public.pg_userfunctions OWNER TO sa;

--
-- Name: pg_overloadeduserfunctions; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_overloadeduserfunctions AS
 SELECT fullname,
    count(*) AS counter
   FROM public.pg_userfunctions
  GROUP BY fullname
 HAVING (count(*) > 1);


ALTER VIEW public.pg_overloadeduserfunctions OWNER TO sa;

--
-- Name: pg_related_objects; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_related_objects AS
 SELECT DISTINCT pg_object_usage.parent_type AS obj_type,
    pg_object_usage.parent_schema AS obj_schema,
    pg_object_usage.parent_name AS obj_name
   FROM public.pg_object_usage
UNION
 SELECT DISTINCT pg_object_usage.obj_type,
    pg_object_usage.obj_schema,
    pg_object_usage.obj_name
   FROM public.pg_object_usage;


ALTER VIEW public.pg_related_objects OWNER TO sa;

--
-- Name: pg_related_objects_dotted; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_related_objects_dotted AS
 SELECT obj_type,
    (COALESCE(NULLIF(((obj_schema)::text || '__'::text), 'public__'::text), ''::text) || (obj_name)::text) AS obj_fqn,
        CASE obj_type
            WHEN 'table'::text THEN ((('[label="'::text || COALESCE(NULLIF(((obj_schema)::text || '.'::text), 'public.'::text), ''::text)) || (obj_name)::text) || '", shape=rectangle, style=filled, fillcolor="#A0FFA0"]'::text)
            WHEN 'view'::text THEN ((('[label="'::text || COALESCE(NULLIF(((obj_schema)::text || '.'::text), 'public.'::text), ''::text)) || (obj_name)::text) || '", shape=ellipse, style=filled, fillcolor="#A0C0FF"]'::text)
            WHEN 'function'::text THEN ((('[label="'::text || COALESCE(NULLIF(((obj_schema)::text || '.'::text), 'public.'::text), ''::text)) || (obj_name)::text) || '", shape=hexagon, style=filled, fillcolor="#FFD0D0"]'::text)
            ELSE NULL::text
        END AS node_style
   FROM public.pg_related_objects;


ALTER VIEW public.pg_related_objects_dotted OWNER TO sa;

--
-- Name: pg_userforeignkey; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_userforeignkey AS
 SELECT constraint_name,
    (((table_schema)::text || '.'::text) || (table_name)::text) AS fullname
   FROM information_schema.table_constraints
  WHERE (((constraint_schema)::text <> ALL (ARRAY[('pg_catalog'::character varying)::text, ('information_schema'::character varying)::text, ('sqlj'::character varying)::text])) AND ((constraint_type)::text = 'FOREIGN KEY'::text));


ALTER VIEW public.pg_userforeignkey OWNER TO sa;

--
-- Name: pg_userindexes; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_userindexes AS
 SELECT (((schemaname)::text || '.'::text) || (indexname)::text) AS fullname,
    schemaname,
    tablename,
    indexname
   FROM pg_indexes
  WHERE (schemaname <> ALL (ARRAY['pg_catalog'::name, 'information_schema'::name, 'sqlj'::name]));


ALTER VIEW public.pg_userindexes OWNER TO sa;

--
-- Name: pg_userpks; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_userpks AS
 SELECT constraint_schema,
    constraint_name,
    table_schema,
    table_name,
    (((table_schema)::text || '.'::text) || (table_name)::text) AS fullname
   FROM information_schema.table_constraints
  WHERE ((constraint_type)::text = 'PRIMARY KEY'::text);


ALTER VIEW public.pg_userpks OWNER TO sa;

--
-- Name: pg_userschemata; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_userschemata AS
 SELECT schema_name
   FROM information_schema.schemata
  WHERE ((schema_name)::text <> ALL (ARRAY[('sqlj'::character varying)::text, ('pg_toast'::character varying)::text, ('pg_temp_1'::character varying)::text, ('pg_catalog'::character varying)::text, ('information_schema'::character varying)::text]));


ALTER VIEW public.pg_userschemata OWNER TO sa;

--
-- Name: pg_usersequences; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_usersequences AS
 SELECT (((t.sequence_schema)::text || '.'::text) || (t.sequence_name)::text) AS sequence_name
   FROM (information_schema.sequences t
     JOIN public.pg_userschemata s ON (((t.sequence_schema)::text = (s.schema_name)::text)));


ALTER VIEW public.pg_usersequences OWNER TO sa;

--
-- Name: pg_usertables; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_usertables AS
 SELECT (((t.table_schema)::text || '.'::text) || (t.table_name)::text) AS table_name
   FROM (information_schema.tables t
     JOIN public.pg_userschemata s ON (((t.table_schema)::text = (s.schema_name)::text)))
  WHERE ((t.table_type)::text = 'BASE TABLE'::text);


ALTER VIEW public.pg_usertables OWNER TO sa;

--
-- Name: pg_useruniques; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_useruniques AS
 SELECT constraint_name,
    (((table_schema)::text || '.'::text) || (table_name)::text) AS fullname
   FROM information_schema.table_constraints
  WHERE (((constraint_schema)::text <> ALL (ARRAY[('pg_catalog'::character varying)::text, ('information_schema'::character varying)::text, ('sqlj'::character varying)::text])) AND ((constraint_type)::text = 'UNIQUE'::text));


ALTER VIEW public.pg_useruniques OWNER TO sa;

--
-- Name: pg_userviews; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_userviews AS
 SELECT (((t.table_schema)::text || '.'::text) || (t.table_name)::text) AS view_name
   FROM (information_schema.tables t
     JOIN public.pg_userschemata s ON (((t.table_schema)::text = (s.schema_name)::text)))
  WHERE ((t.table_type)::text = 'VIEW'::text);


ALTER VIEW public.pg_userviews OWNER TO sa;

--
-- Name: pg_view_usage_dotted; Type: VIEW; Schema: public; Owner: sa
--

CREATE VIEW public.pg_view_usage_dotted AS
 SELECT DISTINCT (((((COALESCE(NULLIF(((parent_schema)::text || '.'::text), 'public.'::text), ''::text) || (parent_name)::text) || ' -> '::text) || COALESCE(NULLIF(((obj_schema)::text || '.'::text), 'public.'::text), ''::text)) || (obj_name)::text) || ';'::text) AS dependency
   FROM public.pg_object_usage;


ALTER VIEW public.pg_view_usage_dotted OWNER TO sa;

