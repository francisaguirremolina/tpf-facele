        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'MonId=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.FechaCotiz IS DISTINCT FROM l_FechaCotiz THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'FechaCotiz = ' || COALESCE(quote_literal(l_FechaCotiz), 'NULL') ;
        IF l_FechaCotiz IS NOT NULL THEN
            IF LENGTH(l_FechaCotiz::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_FechaCotiz::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_FechaCotiz::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'FechaCotiz=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.MonCotiz IS DISTINCT FROM l_MonCotiz THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'MonCotiz = ' || COALESCE(quote_literal(l_MonCotiz), 'NULL') ;
        IF l_MonCotiz IS NOT NULL THEN
            IF LENGTH(l_MonCotiz::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_MonCotiz::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_MonCotiz::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'MonCotiz=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            

    
	IF l_fieldList IS NOT NULL THEN

        l_dmlString := 'UPDATE facele.t_FECotizMonedas SET ' || l_fieldList || ' WHERE ' ||
            'IdCotizMoneda = ' || quote_literal(l_pk_IdCotizMoneda);
        
		EXECUTE l_dmlString;

	END IF;
    
    
    -- No POST-UPDATE
    
    RETURN l_NoTempModFields;

-- Manejo de errores
EXCEPTION

	WHEN OTHERS THEN
		RAISE EXCEPTION '{%}', pg_parseException(SQLSTATE, SQLERRM, 'facele.t_FECotizMonedas', 'actualizar',
            
			'Cotización = ' || l_pk_IdCotizMoneda::TEXT);
   
END;
$$;


ALTER FUNCTION facele.spu_fecotizmonedas(p_monid facele.monid, p_fechacotiz facele.fecha, p_moncotiz facele.moncotiz, p_pk_idcotizmoneda facele.idcotizmoneda) OWNER TO sa;

--
-- Name: spu_fecuits(facele.cuit, facele.descripcion, facele.certificado, facele.claveprivada, facele.segundos, facele.fechahora, facele.token, facele.sign, facele.fecha, facele.cbu, facele.fechahora, facele.token, facele.sign, facele.fechahora, facele.token, facele.sign, facele.cuit); Type: FUNCTION; Schema: facele; Owner: sa
--

CREATE FUNCTION facele.spu_fecuits(p_cuit facele.cuit, p_descripcion facele.descripcion, p_certificado facele.certificado, p_claveprivada facele.claveprivada, p_ticketlive facele.segundos, p_vencimiento facele.fechahora, p_token facele.token, p_sign facele.sign, p_venccert facele.fecha, p_cbu facele.cbu, p_vencimientocdc facele.fechahora, p_tokencdc facele.token, p_signcdc facele.sign, p_vencimientofex facele.fechahora, p_tokenfex facele.token, p_signfex facele.sign, p_pk_cuit facele.cuit) RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE
	l_errorMsg         TEXT;
	l_fieldList        TEXT;
	l_fieldNameList    TEXT;
	l_pkParams         TEXT;
    l_NoTempModFields  INT;
    l_dmlString        TEXT;
    l_pkString         TEXT;
    l_newValue         TEXT;

    l_Cuit  facele.Cuit;
    l_Descripcion  facele.Descripcion;
    l_Certificado  facele.Certificado;
    l_ClavePrivada  facele.ClavePrivada;
    l_TicketLive  facele.Segundos;
    l_Vencimiento  facele.FechaHora;
    l_Token  facele.Token;
    l_Sign  facele.Sign;
    l_VencCert  facele.Fecha;
    l_CBU  facele.CBU;
    l_VencimientoCDC  facele.FechaHora;
    l_TokenCDC  facele.Token;
    l_SignCDC  facele.Sign;
    l_VencimientoFEX  facele.FechaHora;
    l_TokenFEX  facele.Token;
    l_SignFEX  facele.Sign;
    l_pk_Cuit   facele.Cuit;

	l_rec		facele.t_FECuits;

BEGIN
	-- Validación de PK provistas
	IF (p_pk_Cuit IS NULL) THEN

		RAISE EXCEPTION '%', 'No se ha provisto el conjunto de valores de la clave primaria del registro a modificar';

	END IF;

	SELECT * INTO l_rec
		FROM facele.t_FECuits
		WHERE (Cuit = p_pk_Cuit);

    l_Cuit := p_Cuit;
    l_pk_Cuit := p_pk_Cuit;
    l_Descripcion := p_Descripcion;
    l_Certificado := p_Certificado;
    l_ClavePrivada := p_ClavePrivada;
    l_TicketLive := p_TicketLive;
    l_Vencimiento := p_Vencimiento;
    l_Token := p_Token;
    l_Sign := p_Sign;
    l_VencCert := p_VencCert;
    l_CBU := p_CBU;
    l_VencimientoCDC := p_VencimientoCDC;
    l_TokenCDC := p_TokenCDC;
    l_SignCDC := p_SignCDC;
    l_VencimientoFEX := p_VencimientoFEX;
    l_TokenFEX := p_TokenFEX;
    l_SignFEX := p_SignFEX;

    -- No PRE-UPDATE
   
	l_fieldList := NULL;
    l_fieldNameList := NULL;
    -- Cuenta los campos modificados que son definitivos en la tabla
    l_NoTempModFields := 0;
    
	IF l_rec.Cuit IS DISTINCT FROM l_Cuit THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Cuit = ' || COALESCE(quote_literal(l_Cuit), 'NULL') ;
        IF l_Cuit IS NOT NULL THEN
            IF LENGTH(l_Cuit::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Cuit::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Cuit::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Cuit=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Descripcion IS DISTINCT FROM l_Descripcion THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Descripcion = ' || COALESCE(quote_literal(l_Descripcion), 'NULL') ;
        IF l_Descripcion IS NOT NULL THEN
            IF LENGTH(l_Descripcion::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Descripcion::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Descripcion::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Descripcion=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Certificado IS DISTINCT FROM l_Certificado THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Certificado = ' || COALESCE(quote_literal(l_Certificado), 'NULL') ;
        IF l_Certificado IS NOT NULL THEN
            IF LENGTH(l_Certificado::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Certificado::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Certificado::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Certificado=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.ClavePrivada IS DISTINCT FROM l_ClavePrivada THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'ClavePrivada = ' || COALESCE(quote_literal(l_ClavePrivada), 'NULL') ;
        IF l_ClavePrivada IS NOT NULL THEN
            IF LENGTH(l_ClavePrivada::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_ClavePrivada::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_ClavePrivada::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'ClavePrivada=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.TicketLive IS DISTINCT FROM l_TicketLive THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'TicketLive = ' || COALESCE(quote_literal(l_TicketLive), 'NULL') ;
        IF l_TicketLive IS NOT NULL THEN
            IF LENGTH(l_TicketLive::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_TicketLive::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_TicketLive::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'TicketLive=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Vencimiento IS DISTINCT FROM l_Vencimiento THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Vencimiento = ' || COALESCE(quote_literal(l_Vencimiento), 'NULL') ;
        IF l_Vencimiento IS NOT NULL THEN
            IF LENGTH(l_Vencimiento::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Vencimiento::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Vencimiento::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Vencimiento=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Token IS DISTINCT FROM l_Token THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Token = ' || COALESCE(quote_literal(l_Token), 'NULL') ;
        IF l_Token IS NOT NULL THEN
            IF LENGTH(l_Token::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Token::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Token::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Token=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.Sign IS DISTINCT FROM l_Sign THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'Sign = ' || COALESCE(quote_literal(l_Sign), 'NULL') ;
        IF l_Sign IS NOT NULL THEN
            IF LENGTH(l_Sign::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_Sign::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_Sign::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'Sign=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.VencCert IS DISTINCT FROM l_VencCert THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'VencCert = ' || COALESCE(quote_literal(l_VencCert), 'NULL') ;
        IF l_VencCert IS NOT NULL THEN
            IF LENGTH(l_VencCert::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_VencCert::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_VencCert::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'VencCert=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.CBU IS DISTINCT FROM l_CBU THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'CBU = ' || COALESCE(quote_literal(l_CBU), 'NULL') ;
        IF l_CBU IS NOT NULL THEN
            IF LENGTH(l_CBU::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_CBU::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_CBU::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'CBU=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.VencimientoCDC IS DISTINCT FROM l_VencimientoCDC THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'VencimientoCDC = ' || COALESCE(quote_literal(l_VencimientoCDC), 'NULL') ;
        IF l_VencimientoCDC IS NOT NULL THEN
            IF LENGTH(l_VencimientoCDC::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_VencimientoCDC::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_VencimientoCDC::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'VencimientoCDC=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.TokenCDC IS DISTINCT FROM l_TokenCDC THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'TokenCDC = ' || COALESCE(quote_literal(l_TokenCDC), 'NULL') ;
        IF l_TokenCDC IS NOT NULL THEN
            IF LENGTH(l_TokenCDC::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_TokenCDC::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_TokenCDC::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'TokenCDC=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.SignCDC IS DISTINCT FROM l_SignCDC THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'SignCDC = ' || COALESCE(quote_literal(l_SignCDC), 'NULL') ;
        IF l_SignCDC IS NOT NULL THEN
            IF LENGTH(l_SignCDC::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_SignCDC::TEXT FOR 10) || '...';
            ELSE
                l_newValue := l_SignCDC::TEXT;
            END IF;                
        ELSE
            l_newValue := 'NULL';                
        END IF;
        l_fieldNameList := COALESCE(l_fieldNameList || ', ', '') || 'SignCDC=' || l_newValue;
		l_NoTempModFields := l_NoTempModFields + 1;
	END IF;            
	IF l_rec.VencimientoFEX IS DISTINCT FROM l_VencimientoFEX THEN
		l_fieldList := COALESCE(l_fieldList || ', ', '') || 'VencimientoFEX = ' || COALESCE(quote_literal(l_VencimientoFEX), 'NULL') ;
        IF l_VencimientoFEX IS NOT NULL THEN
            IF LENGTH(l_VencimientoFEX::TEXT) > 10 THEN
                l_newValue := SUBSTRING(l_VencimientoFEX::TEXT FOR 10) || '...';
            ELSE
